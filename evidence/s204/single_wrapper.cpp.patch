+// ── engine env slots (dlopen_exec.cpp table) ──────────────────────────
+static inline void* env_fn(JNIEnv* env, int slot) {
+    return ((void**)*(void**)env)[slot];
+}
+static void* env_direct_addr(JNIEnv* env, void* buf) {
+    if (!buf) return nullptr;
+    return ((void* (*)(void*, void*))env_fn(env, 230))(env, buf);
+}
+static int64_t env_direct_cap(JNIEnv* env, void* buf) {
+    if (!buf) return 0;
+    return ((int64_t (*)(void*, void*))env_fn(env, 231))(env, buf);
+}
+static void* env_new_direct_bb(JNIEnv* env, void* addr, int64_t cap) {
+    return ((void* (*)(void*, void*, int64_t))env_fn(env, 229))(env, addr, cap);
