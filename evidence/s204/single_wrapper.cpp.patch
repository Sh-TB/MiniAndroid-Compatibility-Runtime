+// ── owned-glyph registry (the done-safety law) ────────────────────────
+namespace {
+struct GlyphReg {
+    std::mutex mu;
+    void* set[4096];
+    unsigned long n = 0;
+    unsigned long foreign_done = 0;
+    bool take(void* g) {
+        std::lock_guard<std::mutex> lk(mu);
+        for (unsigned long i = 0; i < n; ++i)
+            if (set[i] == g) {
+                set[i] = set[--n];
+                return true;
+            }
+        return false;
+    }
+    bool put(void* g) {
+        std::lock_guard<std::mutex> lk(mu);
+        if (n >= 4096) return false;
+        set[n++] = g;
+        return true;
+    }
+};
