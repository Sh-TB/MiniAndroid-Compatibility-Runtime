+static int g_pass = 0, g_fail = 0;
+static void law(bool ok, int num, const char* what) {
+    if (ok) { ++g_pass; }
+    else {
+        ++g_fail;
+        std::printf("  LAW %02d FAIL: %s\n", num, what);
+    }
+}
