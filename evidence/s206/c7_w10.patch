+#!/usr/bin/env bash
+# c7_w10_run_probe.sh — CODER7 WAVE-10 probe runner (the BATCH-CRUD
+# battery: ops B01..B09 over the c7.w10.batch provider).
+# Single-package run (no store): the batch laws ride the OWN provider.
+#
+# Usage: bash scripts/c7_w10_run_probe.sh <tag>
+set -uo pipefail
+R=/home/z/my-project/c7tree
+BIN=${BIN:-$R/miniandroid/build/miniandroid}
+TAG=${1:?tag}
+OUT=$R/run/c7w10/$TAG
+rm -rf "$OUT"; mkdir -p "$OUT"
+
+run_one() { # <dir> <apk>
+  local o=$1 apk=$2
+  rm -rf "$o"; mkdir -p "$o"
+  rm -rf "$R/runtime/data/data/data/c7.w10"
+  MINIANDROID_FILE_IO="$o/file_io.jsonl" \
+  timeout 240 "$BIN" run "$apk" \
+    --width 1080 --height 1920 --frames 2 --max-seconds 90 -o "$o" \
+    > "$o/run.log" 2>&1
+  echo "run rc=$? -> $o"
+  local res="$R/runtime/data/data/data/c7.w10/files/c7w10_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7w10_results.jsonl"
+}
+
+# androguard cross-check of the W10 fixture (independent AXML truth)
+python3 - "$R/fixtures/c7_w10_probe/c7w10.apk" <<'PY' \
+    > "$OUT/androguard_check.json" 2> "$OUT/androguard_check.err"
+import json, sys
+import xml.etree.ElementTree as ET
+from loguru import logger
+logger.remove()
+from androguard.core.apk import APK
+a = APK(sys.argv[1])
+root = ET.fromstring(a.get_android_manifest_axml().get_xml())
+A = '{http://schemas.android.com/apk/res/android}'
+pkg = root.get('package')
+app = root.find('application')
+prov = [p.get(A + 'name') for p in app.findall('provider')]
+auths = [p.get(A + 'authorities') for p in app.findall('provider')]
+acts = [a2.get(A + 'name') for a2 in app.findall('activity')]
+ok = (pkg == 'c7.w10' and 'c7.w10.batch' in auths
+      and '.Main' in acts and '.BatchProvider' in prov)
+print(json.dumps({'all_ok': ok, 'package': pkg,
+                  'providers': prov, 'authorities': auths, 'activities': acts}))
+PY
+echo "androguard_check rc=$? (0 = fixture contract holds)"
+
+for i in 1 2 3; do
+  run_one "$OUT/cold$i" "$R/fixtures/c7_w10_probe/c7w10.apk"
+done
+
+cd "$OUT"
+echo '═══ verdict counts (cold1) ═══'
+if [ -f cold1/c7w10_results.jsonl ]; then
+  echo "PASS rows: $(rg -c '\|PASS\|' cold1/c7w10_results.jsonl || echo 0)"
+  echo "FAIL rows: $(rg -c '\|FAIL\|' cold1/c7w10_results.jsonl || echo 0)"
+  rg '\|FAIL\|' cold1/c7w10_results.jsonl | head -20
+else
+  echo "NO RESULTS FILE — tail of run.log:"
+  tail -20 cold1/run.log
+fi
+echo '═══ engine batch rows (cold1) ═══'
+rg -o 'PROVIDER-APPLYBATCH[^\n]{0,90}|PROVIDER-BATCH-ASSERT[^\n]{0,90}|PROVIDER-STREAMTYPES[^\n]{0,70}' cold1/file_io.jsonl 2>/dev/null | head -10
+echo '═══ verdict SHAs (×3 cold) ═══'
+sha256sum cold1/c7w10_results.jsonl cold2/c7w10_results.jsonl cold3/c7w10_results.jsonl 2>/dev/null
+echo 'W10 RUNNER DONE' tag=$TAG
