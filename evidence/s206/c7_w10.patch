+package c7.w10;
+
+import android.app.Activity;
+import android.content.ContentProviderOperation;
+import android.content.ContentProviderResult;
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.OperationApplicationException;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.RemoteException;
+import java.util.ArrayList;
+
+/** CODER7 WAVE-10 — the BATCH-CRUD conformance battery (package c7.w10).
+ *  Ops B01..B09 cover the applyBatch value model end-to-end:
+ *   B01 the Builder value model (newInsert→isInsert, newAssert→isAssertQuery)
+ *   B02 applyBatch [insert, insert] → 2 Uri results
+ *   B03 the rows are REALLY there (plain query mirror)
+ *   B04 applyBatch [update] → count == live rows
+ *   B05 applyBatch [assert expected=2] over 2 rows → no throw (assert law)
+ *   B06 applyBatch [delete] → count == 2; B07 the mirror query reads 0
+ *   B08 applyBatch [assert expected=1] over 0 rows → REAL
+ *       OperationApplicationException (the assert failure law)
+ *   B09 getStreamTypes routes the provider override (mimeFilter verbatim)
+ *  Every op try/catch'd: a missing engine API is an honest FAIL row. */
+public class Main extends Activity {
+    static final Uri BATCH_URI = Uri.parse("content://c7.w10.batch/rows");
+
+    static void ok(String op, String d) { Rec.ok(op, d); }
+    static void bad(String op, String d) { Rec.bad(op, d); }
+
+    @Override public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        ContentResolver cr = getContentResolver();
+
+        // ── B01: the Builder value model ────────────────────────────────
+        try {
+            ContentProviderOperation ins = ContentProviderOperation
+                .newInsert(BATCH_URI)
+                .withValues(cv("n", "1")).build();
+            ContentProviderOperation asrt = ContentProviderOperation
+                .newAssertQuery(BATCH_URI)
+                .withExpectedCount(2).build();
+            if (ins.isInsert() && !ins.isUpdate() && !ins.isDelete()
+                    && asrt.isAssertQuery() && !asrt.isInsert())
+                ok("B01", "builder model: insert+assert typed");
+            else
+                bad("B01", "predicates wrong");
+        } catch (Throwable t) { bad("B01", "throw:" + t.getClass().getName()); }
+
+        // ── B02: applyBatch [insert, insert] → 2 results ───────────────
+        try {
+            ArrayList<ContentProviderOperation> ops =
+                new ArrayList<ContentProviderOperation>();
+            ops.add(ContentProviderOperation.newInsert(BATCH_URI)
+                    .withValues(cv("n", "1")).build());
+            ops.add(ContentProviderOperation.newInsert(BATCH_URI)
+                    .withValues(cv("n", "2")).build());
+            ContentProviderResult[] res = cr.applyBatch("c7.w10.batch", ops);
+            boolean uris = res != null && res.length == 2
+                && res[0].uri != null && res[1].uri != null;
+            if (uris)
+                ok("B02", "2 inserts → 2 Uri results; res0="
+                    + res[0].uri.toString());
+            else
+                bad("B02", "results=" + (res == null ? "null"
+                    : String.valueOf(res.length)));
+        } catch (Throwable t) { bad("B02", "throw:" + t.getClass().getName()); }
+
+        // ── B03: the rows REALLY exist (query mirror) ──────────────────
+        try {
+            Cursor c = cr.query(BATCH_URI, null, null, null, null);
+            int n = c == null ? -1 : c.getCount();
+            if (n == 2) ok("B03", "mirror query count=2");
+            else bad("B03", "count=" + n);
+        } catch (Throwable t) { bad("B03", "throw:" + t.getClass().getName()); }
+
+        // ── B04: applyBatch [update] → count == live rows ──────────────
+        try {
+            ArrayList<ContentProviderOperation> ops =
+                new ArrayList<ContentProviderOperation>();
+            ops.add(ContentProviderOperation.newUpdate(BATCH_URI)
+                    .withValues(cv("n", "9")).build());
+            ContentProviderResult[] res = cr.applyBatch("c7.w10.batch", ops);
+            if (res != null && res.length == 1 && res[0].count == 2)
+                ok("B04", "update batch count=2");
+            else
+                bad("B04", "res=" + (res == null ? "null"
+                    : (res.length == 1 ? String.valueOf(res[0].count)
+                                       : "len" + res.length)));
+        } catch (Throwable t) { bad("B04", "throw:" + t.getClass().getName()); }
+
+        // ── B05: applyBatch [assert expected=2] over 2 rows → no throw ─
+        try {
+            ArrayList<ContentProviderOperation> ops =
+                new ArrayList<ContentProviderOperation>();
+            ops.add(ContentProviderOperation.newAssertQuery(BATCH_URI)
+                    .withExpectedCount(2).build());
+            ContentProviderResult[] res = cr.applyBatch("c7.w10.batch", ops);
+            if (res != null && res.length == 1 && res[0].count == 2)
+                ok("B05", "assert(2) over 2 rows → count=2, no throw");
+            else
+                bad("B05", "res shape wrong");
+        } catch (Throwable t) { bad("B05", "throw:" + t.getClass().getName()); }
+
+        // ── B06: applyBatch [delete] → count == 2 ──────────────────────
+        try {
+            ArrayList<ContentProviderOperation> ops =
+                new ArrayList<ContentProviderOperation>();
+            ops.add(ContentProviderOperation.newDelete(BATCH_URI).build());
+            ContentProviderResult[] res = cr.applyBatch("c7.w10.batch", ops);
+            if (res != null && res.length == 1 && res[0].count == 2)
+                ok("B06", "delete batch count=2");
+            else
+                bad("B06", "res shape wrong");
+        } catch (Throwable t) { bad("B06", "throw:" + t.getClass().getName()); }
+
+        // ── B07: the mirror query reads 0 after the delete ─────────────
+        try {
+            Cursor c = cr.query(BATCH_URI, null, null, null, null);
+            int n = c == null ? -1 : c.getCount();
+            if (n == 0) ok("B07", "mirror query count=0 after delete");
+            else bad("B07", "count=" + n);
+        } catch (Throwable t) { bad("B07", "throw:" + t.getClass().getName()); }
+
+        // ── B08: assert over the WRONG count → REAL
+        //     OperationApplicationException ─────────────────────────────
+        try {
+            ArrayList<ContentProviderOperation> ops =
+                new ArrayList<ContentProviderOperation>();
+            ops.add(ContentProviderOperation.newAssertQuery(BATCH_URI)
+                    .withExpectedCount(1).build());
+            try {
+                cr.applyBatch("c7.w10.batch", ops);
+                bad("B08", "assert(1) over 0 rows did NOT throw");
+            } catch (OperationApplicationException oae) {
+                ok("B08", "OperationApplicationException: "
+                    + oae.getMessage());
+            }
+        } catch (Throwable t) { bad("B08", "outer:" + t.getClass().getName()); }
+
+        // ── B09: getStreamTypes routes the provider override ───────────
+        try {
+            String[] st = cr.getStreamTypes(BATCH_URI, "vnd.android.cursor.*");
+            boolean routed = st != null && st.length == 1
+                && "vnd.android.cursor.dir/vnd.c7.w10.batch".equals(st[0])
+                && BatchProvider.streamTypesCalls == 1
+                && "vnd.android.cursor.*".equals(BatchProvider.lastMimeFilter);
+            if (routed)
+                ok("B09", "streamTypes routed; mimeFilter verbatim");
+            else
+                bad("B09", "st=" + (st == null ? "null" : st.length)
+                    + ";calls=" + BatchProvider.streamTypesCalls);
+        } catch (Throwable t) { bad("B09", "throw:" + t.getClass().getName()); }
+
+        Rec.flush(this, "c7w10_results.jsonl");
+    }
+
+    static ContentValues cv(String k, String v) {
+        ContentValues cvv = new ContentValues();
+        cvv.put(k, v);
+        return cvv;
+    }
+}
diff --git a/fixtures/c7_w10_probe/c7w10/src/c7/w10/Rec.java b/fixtures/c7_w10_probe/c7w10/src/c7/w10/Rec.java
