-    if (has("center_vertical")) g = (g & ~0x70) | 0x10;
-    if (has("left") || has("start")) g |= 0x3;
-    if (has("right") || has("end")) g |= 0x5;
-    if (has("top")) g |= 0x30;
-    if (has("bottom")) g |= 0x50;
-    if (has("fill")) g |= 0x77;
+    size_t i = 0;
+    auto is_sep = [](char c) {
+        return c == '|' || c == ',' || c == ' ' || c == '\t';
+    };
+    while (i < s.size()) {
+        while (i < s.size() && is_sep(s[i])) ++i;
+        size_t b = i;
+        while (i < s.size() && !is_sep(s[i])) ++i;
