+package c7.laws;
+
+import android.app.Notification;
+import android.app.Service;
+import android.content.Intent;
+import android.os.IBinder;
+
+/** CODER7 WAVE-9 — the Service the lifecycle laws land on.
+ *  L24: stopSelfResult(startId) — the WRONG-id call must NOT stop the
+ *       service (the second onStartCommand proves it) and the RIGHT-id
+ *       call must (AOSP Service.stopSelfResult: "Stop the service if the
+ *       most recent start time is < startId").
+ *  L25: onUnbind returning TRUE → the next bind must call onRebind and
+ *       NOT onCreate/onBind again (AOSP Service.onUnbind contract).
+ *  L26: startForeground + stopForeground(STOP_FOREGROUND_REMOVE) flag
+ *       overload must dispatch without fabricating a crash. */
+public class LawsService extends Service {
+    public static int startCount = 0;
+    public static int lastStartId = -1;
+    public static int createCount = 0;
+    public static int bindCount = 0;
+    public static int unbindCount = 0;
+    public static int rebindCount = 0;
+    public static boolean wrongIdStopped = false;
+    public static boolean rightIdStopResult = false;
+    public static boolean foregroundRan = false;
+    public static boolean stopForegroundRan = false;
+
+    @Override public void onCreate() { createCount++; }
+
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        startCount++;
+        lastStartId = startId;
+        String a = intent == null ? null : intent.getAction();
+        if ("c7.laws.STOPTEST1".equals(a)) {
+            // AOSP: stopSelfResult with an id OLDER than the last start's
+            // id does NOT stop the service — returns false.
+            boolean stopped = stopSelfResult(startId + 999);
+            if (stopped) wrongIdStopped = true;
+        } else if ("c7.laws.STOPTEST2".equals(a)) {
+            rightIdStopResult = stopSelfResult(startId);
+        } else if ("c7.laws.FG".equals(a)) {
+            foregroundRan = true;
+            startForeground(41, new Notification());
+            stopForeground(android.app.Service.STOP_FOREGROUND_REMOVE);
+            stopForegroundRan = true;
+            stopSelf();
+        }
+        return START_NOT_STICKY;
+    }
+
+    @Override public IBinder onBind(Intent intent) {
+        bindCount++;
+        return null;  // started+bound service face (AOSP allows null)
+    }
+
+    @Override public boolean onUnbind(Intent intent) {
+        unbindCount++;
+        return true;  // AOSP: true → next bind calls onRebind
+    }
+
+    @Override public void onRebind(Intent intent) { rebindCount++; }
+}
