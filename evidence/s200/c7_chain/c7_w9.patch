+#!/usr/bin/env python3
+# c7_w9_androguard_check.py — CODER7 WAVE-9: INDEPENDENT third-party
+# verification of the W9 conformance-battery fixtures with ANDROGUARD
+# (the VEND law + user directive: cross-validate every manifest fact the
+# W9 gates will decide with an independent AXML parser).
+#
+# Facts cross-checked (vs the FIXTURE CONTRACT):
+#   c7laws.apk   — application class LawsApplication, enabled default;
+#                  Main(LAUNCHER)/Second; LawsReceiver(PING) +
+#                  LawsReceiver2(PING2) + PermReceiver(PINGG,
+#                  permission=c7.perm.GATED); LawsService;
+#                  NumProvider(authority c7.laws.num, exported).
+#   c7laws_off.apk — APPLICATION android:enabled="false" (the L27 static
+#                  truth) + OffMain(VIEW)/OffService/OffReceiver.
+#
+# Output: JSON verdict on stdout; exit 0 iff every expectation holds.
+import json
+import sys
+import xml.etree.ElementTree as ET
+
+# androguard v4 routes its AXML parser trace through loguru to STDOUT —
+# silence it BEFORE the import so the JSON verdict is the only stdout.
+from loguru import logger
+
+logger.remove()
+
+from androguard.core.apk import APK
+
+FIX = "fixtures/c7_laws_probe/"
+ANDROID_NS = "{http://schemas.android.com/apk/res/android}"
+
+
+def manifest_tree(apk):
+    return ET.fromstring(apk.get_android_manifest_axml().get_xml())
+
+
+def app_attr(apk, attr):
+    root = manifest_tree(apk)
+    for app in root.findall("application"):
+        v = app.get(ANDROID_NS + attr)
+        return v
+    return None
+
+
+def norm_name(apk, nm):
+    """relative (.Foo) / missing-package forms → fully-qualified."""
+    if not nm:
+        return nm
+    if nm.startswith("."):
+        return apk.get_package() + nm
+    if "." not in nm:
+        return apk.get_package() + "." + nm
+    return nm
+
+
+def comp_attr(apk, kind, name, attr):
+    """android:<attr> of the <kind android:name=name> element; None when
+    absent. enabled absent ⇒ AOSP default true."""
+    root = manifest_tree(apk)
+    for app in root.findall("application"):
+        for el in app.findall(kind):
+            nm = norm_name(apk, el.get(ANDROID_NS + "name"))
+            if nm == name:
+                v = el.get(ANDROID_NS + attr)
+                if attr == "enabled":
+                    return v is None or str(v) == "true"
+                if attr == "exported":
+                    return v is not None and str(v) == "true"
+                return v
+    return None
+
+
+def comp_actions(apk, kind, name):
+    root = manifest_tree(apk)
+    acts = []
+    for app in root.findall("application"):
+        for el in app.findall(kind):
+            nm = norm_name(apk, el.get(ANDROID_NS + "name"))
+            if nm == name:
+                for f in el.findall("intent-filter"):
+                    for a in f.findall("action"):
+                        acts.append(a.get(ANDROID_NS + "name"))
+    return acts
+
+
+def main():
+    checks = []
+
+    def req(name, cond):
+        checks.append((name, bool(cond)))
+
+    a = APK(FIX + "c7laws.apk")
+    req("c7laws package == c7.laws", a.get_package() == "c7.laws")
+    req("application class == c7.laws.LawsApplication",
+        norm_name(a, app_attr(a, "name")) == "c7.laws.LawsApplication")
+    req("c7laws app enabled (default)",
+        app_attr(a, "enabled") is None
+        or str(app_attr(a, "enabled")) == "true")
+    req("Main is the launcher activity",
+        a.get_main_activity() == "c7.laws.Main")
+    req("Second present",
+        comp_attr(a, "activity", "c7.laws.Second", "enabled") is not None)
+    req("LawsReceiver present",
+        comp_attr(a, "receiver", "c7.laws.LawsReceiver", "enabled")
+        is not None)
+    req("LawsReceiver exported",
+        comp_attr(a, "receiver", "c7.laws.LawsReceiver", "exported"))
+    req("LawsReceiver2 present",
+        comp_attr(a, "receiver", "c7.laws.LawsReceiver2", "enabled")
+        is not None)
+    req("PermReceiver permission == c7.perm.GATED",
+        comp_attr(a, "receiver", "c7.laws.PermReceiver", "permission")
+        == "c7.perm.GATED")
+    req("LawsReceiver actions == [c7.laws.PING]",
+        comp_actions(a, "receiver", "c7.laws.LawsReceiver")
+        == ["c7.laws.PING"])
+    req("LawsService present",
+        comp_attr(a, "service", "c7.laws.LawsService", "enabled")
+        is not None)
+    req("NumProvider present",
+        comp_attr(a, "provider", "c7.laws.NumProvider", "enabled")
+        is not None)
+    req("NumProvider authority c7.laws.num",
+        comp_attr(a, "provider", "c7.laws.NumProvider", "authorities")
+        == "c7.laws.num")
+    req("NumProvider exported",
+        comp_attr(a, "provider", "c7.laws.NumProvider", "exported"))
+
+    b = APK(FIX + "c7laws_off.apk")
+    req("c7laws_off package == c7.laws.off",
+        b.get_package() == "c7.laws.off")
+    req("c7laws_off app android:enabled=false",
+        str(app_attr(b, "enabled")) == "false")
+    req("OffMain present",
+        comp_attr(b, "activity", "c7.laws.off.OffMain", "enabled")
+        is not None)
+    req("OffMain filter action c7.off.VIEW",
+        comp_actions(b, "activity", "c7.laws.off.OffMain")
+        == ["c7.off.VIEW"])
+    req("OffService present",
+        comp_attr(b, "service", "c7.laws.off.OffService", "enabled")
+        is not None)
+    req("OffReceiver present",
+        comp_attr(b, "receiver", "c7.laws.off.OffReceiver", "enabled")
+        is not None)
+
+    all_ok = all(ok for _, ok in checks)
+    print(json.dumps({
+        "all_ok": all_ok,
+        "checks": {k: v for k, v in checks},
+        "tool": "androguard",
+        "fixtures": {
+            "c7laws": {"package": a.get_package(),
+                       "app_name": app_attr(a, "name"),
+                       "app_enabled": app_attr(a, "enabled")},
+            "c7laws_off": {"package": b.get_package(),
+                           "app_enabled": app_attr(b, "enabled")},
+        },
+    }, indent=1))
+    return 0 if all_ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
