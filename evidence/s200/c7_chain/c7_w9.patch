+STORE=$R/run/c7w9/store
+rm -rf "$STORE"; mkdir -p "$STORE"
+cp "$R"/fixtures/c7_laws_probe/c7laws.apk "$R"/fixtures/c7_laws_probe/c7laws_off.apk "$STORE/"
+ls -la "$STORE"
+export MINIANDROID_PKG_STORE="$STORE"
+
+run_one() { # <dir> <apk>
+  local o=$1 apk=$2
+  rm -rf "$o"; mkdir -p "$o"
+  # fresh-install semantics: every run starts from an EMPTY app data dir
+  rm -rf "$R/runtime/data/data/data/c7.laws" \
+         "$R/runtime/data/data/data/c7.laws.off"
+  # W9 dispatch-signal envs (deterministic harness stand-ins for the
+  # system's trim / config-change signals; empty = no dispatch):
+  #   MINIANDROID_TRIM_MEMORY=15  → TRIM_MEMORY_COMPLETE at frame 2
+  #   MINIANDROID_CONFIG_ROTATE=1 → orientation change at frame 2
+  MINIANDROID_FILE_IO="$o/file_io.jsonl" \
+  MINIANDROID_TRIM_MEMORY=15 MINIANDROID_CONFIG_ROTATE=1 \
+  timeout 240 "$BIN" run "$apk" \
+    --width 1080 --height 1920 --frames 5 --max-seconds 90 -o "$o" \
+    > "$o/run.log" 2>&1
+  echo "run rc=$? -> $o"
+  local res="$R/runtime/data/data/data/c7.laws/files/c7laws_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7laws_results.jsonl"
+}
+
+# ── androguard cross-parser verification (independent AXML truth for
+#    the W9 fixtures: component tables + the application-level disable)
+python3 "$R/scripts/c7_w9_androguard_check.py" \
+  > "$OUT/androguard_check.json" 2> "$OUT/androguard_check.err"
+echo "androguard_check rc=$? (0 = every W9 fixture component matches)"
+
+# ── COLD ×3 (cache deleted before every run) ────────────────────────
+for i in 1 2 3; do
+  rm -f "$STORE/c7_pkg_cache.sqlite3"
+  run_one "$OUT/cold$i" "$STORE/c7laws.apk"
+done
+
+cd "$OUT"
+echo '═══ verdict counts (cold1) ═══'
+if [ -f cold1/c7laws_results.jsonl ]; then
+  echo "PASS rows: $(rg -c '\|PASS\|' cold1/c7laws_results.jsonl || echo 0)"
+  echo "FAIL rows: $(rg -c '\|FAIL\|' cold1/c7laws_results.jsonl || echo 0)"
+  echo '── FAIL rows (the W9 problem list) ──'
+  rg '\|FAIL\|' cold1/c7laws_results.jsonl | head -40
+else
+  echo "NO RESULTS FILE — run crashed; tail of run.log:"
+  tail -20 cold1/run.log
+fi
+echo '═══ engine dispatch rows (cold1) ═══'
+rg -o 'C7-W9[A-Za-z0-9_ -]*|ACT-FINAFFINITY[^\n]{0,60}|C7-TRIM[^\n]{0,60}|C7-CFGCHG[^\n]{0,60}' cold1/run.log | head -12
+echo '═══ verdict SHAs (×3 cold) ═══'
+sha256sum cold1/c7laws_results.jsonl cold2/c7laws_results.jsonl cold3/c7laws_results.jsonl 2>/dev/null
+echo 'W9 RUNNER DONE' tag=$TAG
