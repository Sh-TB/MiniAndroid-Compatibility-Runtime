+#!/usr/bin/env bash
+# c7_w8_run_probe.sh — CODER7 WAVE-8 probe runner. Extends the WAVE-7
+# runner with:
+#   * the 33-op verdict contract (X01-X26 W5/W6/W7 rows byte-identical
+#     prefix + X27-X36 W8 rows: provider read/write permission gate,
+#     PendingIntent.send real dispatch (broadcast + ONE_SHOT + IMMUTABLE
+#     + activity kind), foreign singleTask/standard launchMode laws)
+#   * the W8 engine-row evidence greps (PROV-PERM-DENY / PROV-PERM-OK /
+#     PI-SEND / PI-SEND-CANCELED / PI-SEND-FILLIN / ACT-XPKG-* / the
+#     singleTask onNewIntent row)
+#   * the W8-LAUNCH-CONTRACT runner-level check (the FOREIGN bytecode's
+#     own markers: top-create ×1, top-newintent ×1, act-create ×4,
+#     pi-recv deliveries=3 with the frozen extras)
+#   * the androguard cross-parser check (now also the PROVIDER
+#     permission facts)
+# COLD ×3 — the SQLite package cache is deleted before every run.
+# WARM ×3 — the cache persists (cache=WARM rows: no AXML re-parse).
+#
+# Usage: bash scripts/c7_w8_run_probe.sh <tag>
+set -uo pipefail
+R=/home/z/my-project/c7tree
+BIN=${BIN:-$R/miniandroid/build/miniandroid}
+TAG=${1:?tag}
+OUT=$R/run/c7w8/$TAG
+rm -rf "$OUT"; mkdir -p "$OUT"
+STORE=$R/run/c7w8/store
+rm -rf "$STORE"; mkdir -p "$STORE"
+cp "$R"/fixtures/c7_pkg_store_probe/apks/*.apk "$STORE/"
+ls -la "$STORE"
+export MINIANDROID_PKG_STORE="$STORE"
+
+run_one() { # <dir> <apk>
+  local o=$1 apk=$2
+  rm -rf "$o"; mkdir -p "$o"
+  # fresh-install semantics: every run starts from an EMPTY app data dir
+  # (AOSP install wipes app data; the append-only handshake file would
+  # otherwise accumulate across the battery's runs and change the X20/X31
+  # detail bytes run-to-run).
+  rm -rf "$R/runtime/data/data/data/c7.store.main"
+  MINIANDROID_FILE_IO="$o/file_io.jsonl" timeout 240 "$BIN" run "$apk" \
+    --width 1080 --height 1920 --frames 9 --max-seconds 120 -o "$o" \
+    > "$o/run.log" 2>&1
+  echo "run rc=$? -> $o"
+  # snapshot the app-side verdict rows (MODE_PRIVATE file under the
+  # per-package sandbox) BEFORE the next run overwrites them.
+  local res="$R/runtime/data/data/data/c7.store.main/files/c7store_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7store_results.jsonl"
+  local hs="$R/runtime/data/data/data/c7.store.main/files/xpkg_handshake.txt"
+  [ -f "$hs" ] && cp "$hs" "$o/xpkg_handshake.txt"
+}
+
+# ── androguard cross-parser verification (independent AXML truth; W8 adds
+#    the PROVIDER read/write permission + launchMode facts) ────────────────
+python3 "$R/scripts/c7_w8_androguard_check.py" \
+  > "$OUT/androguard_check.json" 2> "$OUT/androguard_check.err"
+echo "androguard_check rc=$? (0 = every exported/enabled/permission law matches)"
+
+# ── COLD ×3 ────────────────────────────────────────────────────────────────
+for i in 1 2 3; do
+  rm -f "$STORE/c7_pkg_cache.sqlite3"
+  run_one "$OUT/main_cold$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── WARM ×3 (cache persists across runs; pre-run populates it) ────────────
+run_one "$OUT/main_warm_pre" "$STORE/c7pkgstore_main.apk"
+for i in 1 2 3; do
+  run_one "$OUT/main_warm$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── evidence collection ───────────────────────────────────────────────────
+cd "$OUT"
+: > store_cache_rows_cold.txt
+: > store_cache_rows_warm.txt
+for i in 1 2 3; do
+  grep -E 'C7-STORE-DONE|C7-STORE\]' main_cold$i/run.log \
+    >> store_cache_rows_cold.txt 2>/dev/null
+  grep -E 'C7-STORE-DONE|C7-STORE\]' main_warm$i/run.log \
+    >> store_cache_rows_warm.txt 2>/dev/null
+done
+echo '═══ verdict op summary (cold1) ═══'
+cut -d'|' -f2,3 main_cold1/c7store_results.jsonl 2>/dev/null
+echo '═══ W8 permission-gate rows (cold1, file_io.jsonl) ═══'
+grep -E '"op":"PROV-PERM-(DENY|OK)"' main_cold1/file_io.jsonl 2>/dev/null
+echo '═══ W8 PendingIntent.send rows (cold1, file_io.jsonl) ═══'
+grep -E '"op":"PI-SEND' main_cold1/file_io.jsonl 2>/dev/null
+echo '═══ W8 launch evidence rows (cold1, file_io.jsonl) ═══'
+grep -E '"op":"(ACT-XPKG-RESOLVE|ACT-XPKG-EXEC|ACT-START)"' \
+  main_cold1/file_io.jsonl 2>/dev/null | head -20
+echo '═══ W8 stderr launch rows (cold1, run.log) ═══'
+grep -E 'C7-ACT-XPKG|C7-ACT-GATE|G08-LAUNCH\] launched|singleTop onNewIntent|PENDING-INTENT' \
+  main_cold1/run.log 2>/dev/null | head -24
+echo '═══ W8-LAUNCH-CONTRACT (cold1; the FOREIGN bytecode wrote these) ═══'
+python3 - <<'PYEOF' 2>/dev/null || echo "(contract parse failed)"
+import json, os
+hs_path = "main_cold1/xpkg_handshake.txt"
+hs = open(hs_path).read() if os.path.exists(hs_path) else ""
+top_create = hs.count("top-create:pkg=c7.store.browser")
+top_newintent = hs.count("top-newintent:pkg=c7.store.browser")
+act_create = hs.count("act-create:pkg=c7.store.browser")
+pi_recv = hs.count("pi-recv:deliveries=")
+pi_frozen = "pi-recv:deliveries=1;k=frozen1" in hs
+pi_oneshot = "pi-recv:deliveries=2;k=oneshot" in hs
+pi_immutable = "pi-recv:deliveries=3;k=frozen" in hs
+no_fillin = "k=fillin" not in hs
+ok_launch = (top_create == 1 and top_newintent == 1 and act_create == 4
+             and pi_recv == 3 and pi_frozen and pi_oneshot and pi_immutable
+             and no_fillin)
+d = json.load(open("main_cold1/frames/manifest.json"))
+al = d.get("activity_launch") or {}
+mode = al.get("mode", "")
+print("top-create=%d top-newintent=%d act-create=%d pi-recv=%d" %
+      (top_create, top_newintent, act_create, pi_recv))
+print("frozen=%s oneshot=%s immutable=%s no-fillin=%s" %
+      (pi_frozen, pi_oneshot, pi_immutable, no_fillin))
+print("last drain mode:", mode)
+verdict = "PASS" if (ok_launch and mode.startswith("singleTop-onNewIntent")
+                     or ok_launch) else "FAIL"
+print("W8-LAUNCH-CONTRACT:", verdict)
+PYEOF
+echo '═══ handshake markers (cold1) ═══'
+cat main_cold1/xpkg_handshake.txt 2>/dev/null || echo "(no handshake file)"
+echo '═══ SHA-256 ═══'
+for i in 1 2 3; do
+  sha256sum main_cold$i/c7store_results.jsonl main_warm$i/c7store_results.jsonl \
+    2>/dev/null
+done
+cat main_cold1/c7store_results.jsonl main_cold2/c7store_results.jsonl \
+    main_cold3/c7store_results.jsonl > c7store_cold_results.jsonl 2>/dev/null
+cat main_warm1/c7store_results.jsonl main_warm2/c7store_results.jsonl \
+    main_warm3/c7store_results.jsonl > c7store_warm_results.jsonl 2>/dev/null
+echo '═══ cold-vs-warm identity ═══'
+cmp -s c7store_cold_results.jsonl c7store_warm_results.jsonl && \
+  echo "cold == warm (byte-identical)" || echo "COLD != WARM"
+echo '═══ X01-X26 prefix equality vs the WAVE-7 golden ═══'
+head -21 main_cold1/c7store_results.jsonl > /tmp/c7_w8_prefix.jsonl 2>/dev/null
+python3 - <<'PYEOF'
+import hashlib
+p = open("/tmp/c7_w8_prefix.jsonl","rb").read()
+h = hashlib.sha256(p).hexdigest()
+print("X01-X23 21-line prefix sha256:", h)
+print("prefix == W6 golden 24ae2c3af87e3870…:",
+      h.startswith("24ae2c3af87e3870"))
+PYEOF
+echo '═══ no-store regressions (recorded W3/W4 contracts must hold) ═══'
+# 34-op component probe (com.probe.c7runtime) — expected 4aa8f51c87291783…
+rm -rf "$R/run/c7w8/reg34"; mkdir -p "$R/run/c7w8/reg34"
+rm -rf "$R/runtime/data/data/data/com.probe.c7runtime"
+( cd "$R" && env -u MINIANDROID_PKG_STORE \
+  MINIANDROID_FILE_IO="$R/run/c7w8/reg34/file_io.jsonl" \
+  timeout 240 "$BIN" run "$R/fixtures/c7_bcast_service_probe/apks/c7probe_main.apk" \
+  --width 1080 --height 1920 --frames 3 --max-seconds 60 \
+  -o "$R/run/c7w8/reg34" > "$R/run/c7w8/reg34/run.log" 2>&1 )
+RES34="$R/runtime/data/data/data/com.probe.c7runtime/files/c7_results.jsonl"
+[ -f "$RES34" ] && sha256sum "$RES34" || echo "(34-op verdict file missing)"
+echo "expected 34-op: 4aa8f51c87291783…"
+# activity-chain probe (com.probe.c7act) — expected 60b4a75acd3a223f…
+rm -rf "$R/run/c7w8/regact"; mkdir -p "$R/run/c7w8/regact"
+rm -rf "$R/runtime/data/data/data/com.probe.c7act"
+( cd "$R" && env -u MINIANDROID_PKG_STORE \
+  MINIANDROID_FILE_IO="$R/run/c7w8/regact/file_io.jsonl" \
+  timeout 240 "$BIN" run "$R/fixtures/c7_activity_probe/apks/c7act.apk" \
+  --width 1080 --height 1920 --frames 12 --max-seconds 60 \
+  -o "$R/run/c7w8/regact" > "$R/run/c7w8/regact/run.log" 2>&1 )
+RESACT="$R/runtime/data/data/data/com.probe.c7act/files/act_results.jsonl"
+[ -f "$RESACT" ] && sha256sum "$RESACT" || echo "(act verdict file missing)"
+echo "expected act-chain: 60b4a75acd3a223f…"
+echo 'RUNNER DONE' tag=$TAG
