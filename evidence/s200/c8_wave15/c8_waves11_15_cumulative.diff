+#!/usr/bin/env bash
+# s194_c8_probe_build.sh — [S194-C8] wave-11 probe APK build.
+# The c7 recipe + the KSTUB step: the kotlin/kotlinx stub jar is compiled
+# FIRST and placed on the ecj classpath ONLY — d8 never dex's it, so the
+# probe DEX carries EXTERNAL kotlin/kotlinx references exactly like real
+# apps and the engine laws own the DEX surface.
+# Usage: bash scripts/s194_c8_probe_build.sh <fixture_dir> <out.apk>
+set -euo pipefail
+REPO=/home/z/my-project/work/miniandroid
+TOOLS=/home/z/my-project/tools
+FIX=$1; OUT=$2; WORK=$(mktemp -d)
+
+# 1) KSTUB — compile the kotlin/kotlinx stubs to a jar (compile-time only).
+find "$FIX/kstub" -name "*.java" > "$WORK/kstub-sources.txt"
+java -jar "$TOOLS/ecj/ecj.jar" -1.8 -nowarn -d "$WORK/kstub-obj" \
+    @"$WORK/kstub-sources.txt"
+python3 - "$WORK/kstub-obj" "$WORK/kstub.jar" <<'PYEOF'
+import sys, zipfile, os
+objdir, out = sys.argv[1], sys.argv[2]
+with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as z:
+    for root, _, files in os.walk(objdir):
+        for f in files:
+            p = os.path.join(root, f)
+            z.write(p, os.path.relpath(p, objdir))
+print("kstub jar written:", out)
+PYEOF
+
+# 2) Resources + manifest (the c7 recipe, verbatim).
+if [ -d "$FIX/res" ]; then
+  "$TOOLS/aapt2/aapt2" compile --dir "$FIX/res" -o "$WORK/res.zip"
+  "$TOOLS/aapt2/aapt2" link -o "$WORK/base.apk" -I "$TOOLS/android-34.jar" \
+    --manifest "$FIX/AndroidManifest.xml" --java "$WORK/gen" --auto-add-overlay "$WORK/res.zip"
+else
+  mkdir -p "$WORK/gen"
+  "$TOOLS/aapt2/aapt2" link -o "$WORK/base.apk" -I "$TOOLS/android-34.jar" \
+    --manifest "$FIX/AndroidManifest.xml" --java "$WORK/gen"
+fi
+
+# 3) Compile the probe against android-34 + the KSTUB jar.
+find "$FIX/src" "$WORK/gen" -name "*.java" > "$WORK/sources.txt"
+java -jar "$TOOLS/ecj/ecj.jar" -1.8 -nowarn -d "$WORK/obj" \
+    -cp "$TOOLS/android-34.jar:$WORK/kstub.jar" @"$WORK/sources.txt"
+
+# 4) D8 — only the probe classes (the kstub stays OUT of the APK).
+find "$WORK/obj" -name "*.class" > "$WORK/classes.txt"
+mkdir -p "$WORK/dex"
+java -cp "$TOOLS/d8/r8.jar" com.android.tools.r8.D8 --release \
+  --lib "$TOOLS/android-34.jar" --output "$WORK/dex" @"$WORK/classes.txt"
+cp "$WORK/base.apk" "$OUT"; ( cd "$WORK/dex" && zip -j -q -X "$OUT" classes.dex )
+sha256sum "$OUT"
