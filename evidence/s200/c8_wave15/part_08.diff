+#!/usr/bin/env bash
+# s194_c8_probe_run.sh — [S194-C8] probe runner: install + run + marker
+# extraction (S188 rule 9 — the assertion truth is the C8PROBE marker set).
+# Usage: bash scripts/s194_c8_probe_run.sh <binary> <apk> <store> <rundir> <secs>
+set -euo pipefail
+BIN=$1; APK=$2; STORE=$3; RUNDIR=$4; SECS=${5:-30}
+rm -rf "$STORE" "$RUNDIR"; mkdir -p "$STORE" "$RUNDIR"
+"$BIN" install "$APK" --data-root "$STORE" > "$RUNDIR/install.log" 2>&1 || true
+DPKG=$(ls "$STORE/data/app" 2>/dev/null | grep -v staging | head -1)
+if [ -z "$DPKG" ]; then echo "INSTALL_FAIL"; exit 2; fi
+"$BIN" run --execution-mode real-dalvik --data-root "$STORE" \
+    -o "$RUNDIR/run" --max-seconds "$SECS" --frames 5 --trace \
+    --package "$DPKG" > "$RUNDIR/console.log" 2>&1 || true
+grep -a 'C8PROBE' "$RUNDIR/console.log" | sed 's/.*C8PROBE[: ]*//' \
+    | sed 's/^[[:space:]]*//' > "$RUNDIR/markers.txt"
+echo "--- markers ($(wc -l < "$RUNDIR/markers.txt") lines) ---"
+cat "$RUNDIR/markers.txt"
+# 3-run byte-identity digest over the normalized marker set
+sha256sum "$RUNDIR/markers.txt"
