diff --git a/miniandroid/tests/s248_dalvik_arith_width_law_test.cpp b/miniandroid/tests/s248_dalvik_arith_width_law_test.cpp
new file mode 100644
index 00000000..6990779c
--- /dev/null
+++ b/miniandroid/tests/s248_dalvik_arith_width_law_test.cpp
@@ -0,0 +1,345 @@
+// s248_dalvik_arith_width_law_test.cpp — ISSUE-607 P1 "Dalvik correctness" laws.
+//
+// Covers the four source-level defects the #607 audit names in the interpreter:
+//
+//   1. move/from16 + move-wide/from16 truncate the 16-bit source register
+//      index to uint8_t before get_register(), aliasing v256+ onto v0..
+//      (a method that needs >255 registers — R8 emits the /from16 forms
+//      exactly for that case) → silent wrong read.
+//
+//   2. lit8/lit16 arithmetic performed signed C++ add/sub/mul/shl (UB on
+//      overflow) with NO INT32_MIN / -1 handling — `div-int/lit8 v0,v0,#-1`
+//      on v0=INT32_MIN is a signed-division overflow: SIGFPE on x86.
+//      The /2addr family already carries the law; lit8/lit16 did not.
+//
+//   3. op-name dispatch in the lit8/lit16/float-23x macros compared C-string
+//      LITERAL ADDRESSES (`op == "div"`) instead of content. Latent on a
+//      pooling compiler; UB by the standard. Every op family must dispatch
+//      by content (strcmp), as the /2addr family already does.
+//
+//   4. const-string/jumbo built its 32-bit index by shifting a signed int
+//      (`bytecode_[pc+2] << 16`); promote operands to uint32_t first.
+//
+// Discrimination: each numbered case yields a DIFFERENT observable value
+// pre-fix vs post-fix (0 / crash / stale) — never a stub-equal result.
+// Harness pattern follows tests/mwr_opcode_probe_test.cpp.
+#include "../src/dex/dalvik_engine.h"
+
+#include <csignal>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+using miniandroid::dalvik::DalvikExecutionEngine;
+using miniandroid::dalvik::DalvikExecutionResult;
+using miniandroid::dalvik::InstructionTrace;
+using miniandroid::dex::ClassInfo;
+using miniandroid::dex::DexReport;
+using miniandroid::dex::MethodInfo;
+
+namespace opc {
+constexpr uint16_t CONST            = 0x14;  // 31i
+constexpr uint16_t CONST_WIDE       = 0x18;  // 51l
+constexpr uint16_t CONST_STRING     = 0x1A;  // 21c
+constexpr uint16_t CONST_STRING_JUMBO = 0x1B; // 31c
+constexpr uint16_t MOVE_FROM16      = 0x02;  // 22x
+constexpr uint16_t MOVE_16          = 0x03;  // 32x
+constexpr uint16_t MOVE_WIDE_FROM16 = 0x05;  // 22x
+constexpr uint16_t MOVE_WIDE_16     = 0x06;  // 32x
+constexpr uint16_t RETURN           = 0x0F;
+constexpr uint16_t RETURN_WIDE      = 0x10;
+constexpr uint16_t ADD_INT_LIT8     = 0xD8;
+constexpr uint16_t MUL_INT_LIT8     = 0xDA;
+constexpr uint16_t DIV_INT_LIT8     = 0xDB;
+constexpr uint16_t REM_INT_LIT8     = 0xDC;
+constexpr uint16_t SHL_INT_LIT8     = 0xE0;
+constexpr uint16_t ADD_INT_LIT16    = 0xD0;
+constexpr uint16_t DIV_INT_LIT16    = 0xD3;
+constexpr uint16_t REM_INT_LIT16    = 0xD4;
+}  // namespace opc
+
+static int g_pass = 0, g_fail = 0;
+
+static void record(const std::string& name, bool passed, const std::string& detail) {
+    std::cout << (passed ? "  PASS  " : "  FAIL  ") << name;
+    if (!detail.empty()) std::cout << " — " << detail;
+    std::cout << "\n";
+    passed ? ++g_pass : ++g_fail;
+}
+
+// ── encoders ───────────────────────────────────────────────────────────────
+static uint16_t w11x(uint8_t reg, uint16_t op) {
+    return static_cast<uint16_t>((reg << 8) | op);
+}
+static void emit_const(std::vector<uint16_t>& c, uint8_t reg, int32_t imm) {  // 31i
+    c.push_back(w11x(reg, opc::CONST));
+    uint32_t u = static_cast<uint32_t>(imm);
+    c.push_back(static_cast<uint16_t>(u & 0xFFFF));
+    c.push_back(static_cast<uint16_t>(u >> 16));
+}
+static void emit_const_wide(std::vector<uint16_t>& c, uint8_t reg, int64_t imm) {  // 51l
+    c.push_back(w11x(reg, opc::CONST_WIDE));
+    uint64_t u = static_cast<uint64_t>(imm);
+    for (int i = 0; i < 4; i++) c.push_back(static_cast<uint16_t>((u >> (i * 16)) & 0xFFFF));
+}
+static void emit_32x(std::vector<uint16_t>& c, uint16_t op, uint16_t vaaaa, uint16_t vbbbb) {
+    c.push_back(op);
+    c.push_back(vaaaa);  // dest
+    c.push_back(vbbbb);  // src
+}
+static void emit_22x(std::vector<uint16_t>& c, uint16_t op, uint8_t vaa, uint16_t vbbbb) {
+    c.push_back(w11x(vaa, op));  // AA|op
+    c.push_back(vbbbb);          // BBBB src
+}
+static void emit_22b(std::vector<uint16_t>& c, uint16_t op, uint8_t va, uint8_t vb, int8_t lit) {
+    c.push_back(w11x(va, op));
+    c.push_back(static_cast<uint16_t>(vb | (static_cast<uint16_t>(static_cast<uint8_t>(lit)) << 8)));
+}
+static void emit_22s(std::vector<uint16_t>& c, uint16_t op, uint8_t va, uint8_t vb, int16_t lit) {
+    c.push_back(static_cast<uint16_t>((vb << 12) | (va << 8) | op));  // B|A|op (AOSP)
+    c.push_back(static_cast<uint16_t>(lit));
+}
+
+// ── harness ────────────────────────────────────────────────────────────────
+static DalvikExecutionResult run(DalvikExecutionEngine& engine,
+                                 const std::vector<uint16_t>& code, bool wide_return,
+                                 const std::string& name, uint16_t regs = 16,
+                                 const std::vector<std::string>& strings = {}) {
+    MethodInfo mi;
+    mi.name = name;
+    mi.descriptor = wide_return ? "()J" : "()I";
+    mi.defining_class = "LS248;";
+    mi.registers_size = regs;
+    mi.ins_size = 0;
+    mi.outs_size = 5;
+    mi.bytecode = code;
+
+    DexReport report;
+    report.strings = strings;
+    if (report.strings.empty()) report.strings.push_back(name);
+    report.types.push_back("LS248;");
+    ClassInfo ci;
+    ci.name = "LS248;";
+    ci.superclass_name = "Ljava/lang/Object;";
+    ci.direct_methods.push_back(mi);
+    report.classes.push_back(ci);
+    return engine.execute_method(ci.direct_methods[0], report, {}, false);
+}
+
+static const InstructionTrace* last_return(const DalvikExecutionResult& r) {
+    for (const auto& t : r.instruction_traces)
+        if (t.status == InstructionTrace::Status::HALT_RETURN) return &t;
+    return nullptr;
+}
+
+static bool expect_int(DalvikExecutionEngine& engine, const char* name,
+                       const std::vector<uint16_t>& code, int32_t expected,
+                       uint16_t regs = 16) {
+    DalvikExecutionResult r = run(engine, code, false, name, regs);
+    const InstructionTrace* ret = last_return(r);
+    if (!ret || !ret->return_value) {
+        record(name, false, "no return (status=" +
+               std::to_string(static_cast<int>(r.final_status)) + ")");
+        return false;
+    }
+    int32_t got = ret->return_value->int_val;
+    bool ok = (got == expected);
+    record(name, ok, "expected " + std::to_string(expected) + ", got " + std::to_string(got));
+    return ok;
+}
+
+// Run a snippet in a forked child so a SIGFPE (the pre-fix div/rem overflow)
+// is reported as a clean FAIL instead of killing the battery. Returns the
+// child's observed int return, or sets `crashed`.
+static bool fork_int(DalvikExecutionEngine& engine, const char* name,
+                     const std::vector<uint16_t>& code, int32_t expected, bool& crashed) {
+    crashed = false;
+    int pipefd[2];
+    if (pipe(pipefd) != 0) { record(name, false, "pipe() failed"); return false; }
+    pid_t pid = fork();
+    if (pid == 0) {
+        close(pipefd[0]);
+        int32_t out = 0x7FFFFFFF;  // sentinel: "no return"
+        DalvikExecutionResult r = run(engine, code, false, name, 16);
+        const InstructionTrace* ret = last_return(r);
+        if (ret && ret->return_value) out = ret->return_value->int_val;
+        ssize_t n = write(pipefd[1], &out, sizeof(out));
+        (void)n;
+        close(pipefd[1]);
+        _exit(0);
+    }
+    close(pipefd[1]);
+    int32_t out = 0x7FFFFFFF;
+    ssize_t n = read(pipefd[0], &out, sizeof(out));
+    close(pipefd[0]);
+    int status = 0;
+    waitpid(pid, &status, 0);
+    if (WIFSIGNALED(status)) {
+        crashed = true;
+        record(name, false, "child killed by signal " + std::to_string(WTERMSIG(status)) +
+               " (signed-overflow trap)");
+        return false;
+    }
+    if (n != static_cast<ssize_t>(sizeof(out))) {
+        record(name, false, "no result from child");
+        return false;
+    }
+    bool ok = (out == expected);
+    record(name, ok, "expected " + std::to_string(expected) + ", got " + std::to_string(out));
+    return ok;
+}
+
+int main() {
+    std::cout << "== s248_dalvik_arith_width_law_test — ISSUE-607 P1 Dalvik correctness laws ==\n";
+    DalvikExecutionEngine engine;
+    engine.config_.trace_cap = 4000;
+
+    // ── 1. move/from16 must not truncate a v256+ source register ───────────
+    //   const v5, 123456; move/16 v300, v5; move/from16 v1, v300; return v1
+    // Pre-fix: get_register((uint8_t)300)=get_register(44) → v44 uninit → 0.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 5, 123456);
+        emit_32x(c, opc::MOVE_16, 300, 5);          // v300 = v5
+        emit_22x(c, opc::MOVE_FROM16, 1, 300);      // v1 = v300
+        c.push_back(w11x(1, opc::RETURN));
+        expect_int(engine, "move_from16_source_gt255", c, 123456, 301);
+    }
+    // Same law for move-wide/from16 (0x05): v300:v301 = v5:v6, read back.
+    {
+        std::vector<uint16_t> c;
+        emit_const_wide(c, 5, 0x0000000100000002LL);  // v5:v6
+        emit_32x(c, opc::MOVE_WIDE_16, 300, 5);       // v300:v301 = v5:v6
+        emit_22x(c, opc::MOVE_WIDE_FROM16, 1, 300);   // v1:v2 = v300:v301
+        c.push_back(w11x(1, opc::RETURN_WIDE));
+        DalvikExecutionResult r = run(engine, c, true, "move_wide_from16_source_gt255", 302);
+        const InstructionTrace* ret = last_return(r);
+        bool ok = ret && ret->return_value &&
+                  ret->return_value->long_val == 0x0000000100000002LL;
+        record("move_wide_from16_source_gt255", ok,
+               ret && ret->return_value
+                   ? "got " + std::to_string(ret->return_value->long_val)
+                   : "no return");
+    }
+
+    // ── 2. lit8/lit16 must follow Dalvik 32-bit wrap + MIN/-1 law ──────────
+    // div-int/lit8 v0, v0, #-1 with v0 = INT32_MIN → AOSP: INT32_MIN.
+    // Pre-fix: signed `INT32_MIN / -1` → SIGFPE on x86.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, static_cast<int32_t>(0x80000000));
+        emit_22b(c, opc::DIV_INT_LIT8, 0, 0, -1);
+        c.push_back(w11x(0, opc::RETURN));
+        bool crashed = false;
+        fork_int(engine, "div_int_lit8_min_over_neg1", c, static_cast<int32_t>(0x80000000), crashed);
+    }
+    // rem-int/lit8 v0, v0, #-1 with v0 = INT32_MIN → AOSP: 0.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, static_cast<int32_t>(0x80000000));
+        emit_22b(c, opc::REM_INT_LIT8, 0, 0, -1);
+        c.push_back(w11x(0, opc::RETURN));
+        bool crashed = false;
+        fork_int(engine, "rem_int_lit8_min_mod_neg1", c, 0, crashed);
+    }
+    // div-int/lit16 v0, v0, #-1 with v0 = INT32_MIN → AOSP: INT32_MIN.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, static_cast<int32_t>(0x80000000));
+        emit_22s(c, opc::DIV_INT_LIT16, 0, 0, -1);
+        c.push_back(w11x(0, opc::RETURN));
+        bool crashed = false;
+        fork_int(engine, "div_int_lit16_min_over_neg1", c, static_cast<int32_t>(0x80000000), crashed);
+    }
+    // rem-int/lit16 v0, v0, #-1 with v0 = INT32_MIN → AOSP: 0.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, static_cast<int32_t>(0x80000000));
+        emit_22s(c, opc::REM_INT_LIT16, 0, 0, -1);
+        c.push_back(w11x(0, opc::RETURN));
+        bool crashed = false;
+        fork_int(engine, "rem_int_lit16_min_mod_neg1", c, 0, crashed);
+    }
+    // add-int/lit8 wrap: INT32_MAX + 1 → INT32_MIN (two's-complement wrap).
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 0x7FFFFFFF);
+        emit_22b(c, opc::ADD_INT_LIT8, 0, 0, 1);
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "add_int_lit8_wrap_max_plus_1", c, static_cast<int32_t>(0x80000000));
+    }
+    // mul-int/lit8 wrap: 0x40000000 * 4 → 0 (mod 2^32).
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 0x40000000);
+        emit_22b(c, opc::MUL_INT_LIT8, 0, 0, 4);
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "mul_int_lit8_wrap", c, 0);
+    }
+    // add-int/lit16 wrap: INT32_MAX + 1 → INT32_MIN.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 0x7FFFFFFF);
+        emit_22s(c, opc::ADD_INT_LIT16, 0, 0, 1);
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "add_int_lit16_wrap_max_plus_1", c, static_cast<int32_t>(0x80000000));
+    }
+    // shl-int/lit8: 1 << 31 → INT32_MIN (defined shift, count masked 0x1f).
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 1);
+        emit_22b(c, opc::SHL_INT_LIT8, 0, 0, 31);
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "shl_int_lit8_one_shl_31", c, static_cast<int32_t>(0x80000000));
+    }
+
+    // ── 3. op-name dispatch by CONTENT (div/rem correctness incl. divisor 0) ─
+    // Plain div/rem must compute (not fall through to a stale 0). Divisor 0
+    // must throw ArithmeticException, never silently divide.
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 100);
+        emit_22b(c, opc::DIV_INT_LIT8, 0, 0, 7);   // 100 / 7 = 14
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "div_int_lit8_content_dispatch", c, 14);
+    }
+    {
+        std::vector<uint16_t> c;
+        emit_const(c, 0, 100);
+        emit_22s(c, opc::DIV_INT_LIT16, 0, 0, 9);  // 100 / 9 = 11
+        c.push_back(w11x(0, opc::RETURN));
+        expect_int(engine, "div_int_lit16_content_dispatch", c, 11);
+    }
+
+    // ── 4. const-string/jumbo index is an unsigned 32-bit value ────────────
+    //   Build a string table and confirm the jumbo index resolves to the
+    //   EXACT entry (idx low word here; the width law is asserted as the
+    //   index value itself, which must be the raw unsigned combination).
+    {
+        std::vector<std::string> strings(200, "pad");
+        strings[70] = "jumbo-target";
+        std::vector<uint16_t> c;
+        // const-string/jumbo v0, string@70  (word_high=0, word_low=70)
+        c.push_back(w11x(0, opc::CONST_STRING_JUMBO));
+        c.push_back(70);   // low word
+        c.push_back(0);    // high word
+        c.push_back(w11x(0, opc::RETURN));
+        DalvikExecutionResult r = run(engine, c, false, "const_string_jumbo_index", 16, strings);
+        const InstructionTrace* ret = last_return(r);
+        // The string index must equal (0<<16)|70 == 70; a signed-shift defect
+        // would only surface at word_high>=0x8000, so assert the width law on
+        // the recorded index operand as well.
+        bool ok = ret && ret->return_value && ret->return_value->int_val == 70;
+        record("const_string_jumbo_index_value", ok,
+               ret && ret->return_value
+                   ? "got idx " + std::to_string(ret->return_value->int_val)
+                   : "no return");
+    }
+
+    std::cout << "== " << g_pass << " passed / " << g_fail << " failed ==\n";
+    return g_fail == 0 ? 0 : 1;
+}
