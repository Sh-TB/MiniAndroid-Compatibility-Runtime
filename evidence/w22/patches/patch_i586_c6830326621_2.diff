+#!/usr/bin/env python3
+"""s156_baseline_wall.py — S156 stage-0: anchor baseline at the fresh S155
+rebuild, BEFORE any 4-app work (regression reference).
+
+Anchors = the canonical APKs physically present in the upload cache:
+dooz, unote, microtimer, opencalc, tictactoe, bouncy, gmdice.
+Expectations from S155 evidence (rebuilt-engine era):
+  unote  -> 3b8dcb0adbbc17a9 (REAL_APP_CONTENT)
+  dooz   -> 11a38a5aeeff45a6 (DEFAULT_BACKGROUND_ONLY, record-phase spin era)
+Other anchors: record faces (stability x2 for dooz/unote), zero-drift check
+within this engine. Output: evidence/s156_4app/BASELINE_WALL.json.
+"""
+import hashlib
+import json
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent))
+from s156_4app_boot import MA, BIN, OUT, EVID, sha16, install  # noqa: E402
+
+APK_DIR = Path("/home/z/my-project/upload/canonical_apks")
+
+ANCHORS = [
+    ("dooz", "io.github.yamin8000.dooz_23.apk", "io.github.yamin8000.dooz",
+     "11a38a5aeeff45a6"),
+    ("unote", "app.varlorg.unote_30.apk", "app.varlorg.unote",
+     "3b8dcb0adbbc17a9"),
+    ("microtimer", "dubrowgn.microtimer_8.apk", "dubrowgn.microtimer", None),
+    ("opencalc", "com.darkempire78.opencalculator_53.apk",
+     "com.darkempire78.opencalculator", None),
+    ("tictactoe", "com.emmanuelmess.tictactoe.apk",
+     "com.emmanuelmess.tictactoe", None),
+    ("bouncy", "com.dozingcatsoftware.bouncy_43.apk",
+     "com.dozingcatsoftware.bouncy", None),
+    ("gmdice", "de.duenndns.gmdice_8.apk", "de.duenndns.gmdice", None),
+]
+TWICE = {"dooz", "unote"}
+
+
+def run_once(tag, apk, package, run_id, max_seconds=70, frames=8):
+    store = OUT / f"store_{tag}" / "data"
+    rundir = OUT / f"baseline_{tag}_{run_id}"
+    console = OUT / f"baseline_{tag}_{run_id}.console.log"
+    inst = install(tag, apk, store)
+    cmd = [str(BIN), "run", "--execution-mode", "real-dalvik",
+           "--data-root", str(store), "-o", str(rundir),
+           "--max-seconds", str(max_seconds), "--frames", str(frames),
+           "--trace", "--package", package]
+    t0 = time.time()
+    killed = False
+    try:
+        with open(console, "w") as cf:
+            subprocess.run(cmd, stdout=cf, stderr=subprocess.STDOUT,
+                           cwd=str(MA), timeout=max_seconds + 60)
+    except subprocess.TimeoutExpired:
+        killed = True
+    wall = round(time.time() - t0, 1)
+    text = console.read_text(errors="replace")
+    shot = rundir / "screenshot.png"
+    return {
+        "run_id": run_id, "wall_s": wall, "killed": killed, "install": inst,
+        "face": sha16(shot) if shot.exists() else None,
+        "uncaught": len(re.findall(r"UNCAUGHT", text)),
+        "verdicts": list(dict.fromkeys(
+            re.findall(r"verdict[\"'= :]+([A-Z_]{4,40})", text)))[:4],
+    }
+
+
+def main():
+    rows = {}
+    for tag, fname, package, expect in ANCHORS:
+        apk = APK_DIR / fname
+        if not apk.exists():
+            rows[tag] = {"error": "APK missing", "file": fname}
+            continue
+        r1 = run_once(tag, apk, package, "r1")
+        row = {"file": fname, "package": package, "expected_face": expect,
+               "runs": [r1]}
+        if tag in TWICE:
+            r2 = run_once(tag, apk, package, "r2")
+            row["runs"].append(r2)
+            row["stable_x2"] = r1["face"] == r2["face"] and r1["face"] is not None
+        row["face"] = r1["face"]
+        row["matches_expectation"] = (expect is None or r1["face"] == expect)
+        rows[tag] = row
+        print(tag, "face", r1["face"], "expect", expect,
+              "uncaught", r1["uncaught"], "verdicts", r1["verdicts"])
+    out = EVID / "BASELINE_WALL.json"
+    out.write_text(json.dumps({"wave": "S156", "stage": "baseline",
+                               "engine": "S155 main rebuild", "anchors": rows},
+                              indent=1))
+    print("WROTE", out)
+
+
+if __name__ == "__main__":
+    main()
