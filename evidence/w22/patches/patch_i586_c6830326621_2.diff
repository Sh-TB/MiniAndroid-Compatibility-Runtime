+#!/usr/bin/env python3
+"""s156_4app_profile.py — S156 wave stage-2: androguard static profile.
+
+Per app: application class, framework-family descriptor census from the dex
+string pools (compose/fragment/koin/coroutines/webview/...), top-level
+package histogram. Output: evidence/s156_4app/PROFILE.json.
+"""
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+from androguard.core.apk import APK
+from loguru import logger
+
+logger.remove()  # silence androguard DEBUG spam
+
+BASE = Path("/home/z/my-project/repo")
+APK_DIR = Path("/home/z/my-project/upload/canonical_apks")
+EVID = BASE / "evidence/s156_4app"
+EVID.mkdir(parents=True, exist_ok=True)
+
+FAMILIES = [
+    "androidx/compose/runtime", "androidx/compose/ui", "androidx/compose/foundation",
+    "androidx/compose/material", "androidx/fragment/app", "androidx/lifecycle",
+    "androidx/recyclerview", "androidx/viewpager", "androidx/appcompat",
+    "androidx/preference", "androidx/navigation", "androidx/paging",
+    "androidx/work", "androidx/viewbinding", "androidx/databinding",
+    "androidx/browser", "androidx/core/app/Notification",
+    "kotlinx/coroutines", "kotlin/reflect", "org/koin/core", "org/koin/android",
+    "dagger", "javax/inject", "com/google/android/material",
+    "android/webkit", "retrofit2", "okhttp3", "okio", "io/coil",
+    "com/bumptech/glide", "com/squareup/moshi", "com/google/gson",
+    "org/jetbrains/anko", "net/sqlcipher", "android/database/sqlite",
+    "java/util/concurrent", "javax/net/ssl", "org/apache/http",
+    "com/trilead/ssh2", "org/connectbot/jcraft", "eu/alefzero/ssh",
+]
+
+PKG_RE = re.compile(rb"L([a-z][\w]*)(?:/[\w$]+){2,};")
+
+
+def app_class(a):
+    try:
+        root = a.get_android_manifest_xml()
+        app = root.find("application")
+        if app is not None:
+            return app.get("{http://schemas.android.com/apk/res/android}name")
+    except Exception:
+        pass
+    return None
+
+
+def main():
+    ledger = json.loads((EVID / "PIN_LEDGER.json").read_text())
+    profile = {"wave": "S156", "stage": "profile", "apps": {}}
+    for tag, row in ledger["apks"].items():
+        p = APK_DIR / row["file"]
+        a = APK(str(p))
+        fam = Counter()
+        pkgs = Counter()
+        for name in a.get_files():
+            if not (name.endswith(".dex") and name.count("/") <= 1):
+                continue
+            data = a.get_file(name)
+            for f in FAMILIES:
+                probe = b"L" + f.encode()
+                if probe in data:
+                    fam[f] += data.count(probe)
+            for m in PKG_RE.finditer(data):
+                pkgs[m.group(1).decode()] += 1
+        top = {k: v for k, v in pkgs.most_common(12)}
+        prow = {
+            "package": row["package"], "versionCode": row["versionCode"],
+            "application_class": app_class(a),
+            "main_activity": row["main_activity"],
+            "family_census": dict(fam),
+            "top_packages": top,
+        }
+        profile["apps"][tag] = prow
+        print(f"== {tag} ==")
+        print("  application_class:", prow["application_class"])
+        fams = sorted(fam.items(), key=lambda kv: -kv[1])
+        print("  families:", ", ".join(f"{k}={v}" for k, v in fams[:16]))
+        print("  top_pkgs:", list(top.items())[:8])
+    (EVID / "PROFILE.json").write_text(json.dumps(profile, indent=1))
+    print("WROTE", EVID / "PROFILE.json")
+
+
+if __name__ == "__main__":
+    main()
