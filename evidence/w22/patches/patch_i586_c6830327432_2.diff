+#!/usr/bin/env python3
+"""s226_transfer_battery.py — re-verification battery for the S156 4-app
+wave on the CURRENT origin/main (S225-M, a4516511).
+
+A-R standard (issue #584 method): findings are re-censused AND re-reproduced
+live at the current main before transfer.
+
+1. Gate spots at the S225-M pins recorded in the S225-M commit message:
+   bouncy 8a6c24ac… / unote 3b8dcb0a… / gmdice 3891679d… / dooz a0fae907…
+2. The 4 canonical app boots (thunderbird/tusky/nextcloud/connectbot).
+Output: evidence/s156_4app/S226_TRANSFER_BATTERY.json
+"""
+import hashlib
+import json
+import re
+import subprocess
+import time
+from pathlib import Path
+
+BASE = Path("/home/z/my-project/wt_s225")
+MA = BASE / "miniandroid"
+BIN = MA / "build/miniandroid"
+APK_DIR = Path("/home/z/my-project/upload/canonical_apks")
+OUT = BASE / "run/s226_transfer"
+EVID = BASE / "evidence/s156_4app"
+OUT.mkdir(parents=True, exist_ok=True)
+EVID.mkdir(parents=True, exist_ok=True)
+
+GATES = [
+    ("bouncy", "com.dozingcatsoftware.bouncy_43.apk", "com.dozingcatsoftware.bouncy", "8a6c24ac"),
+    ("unote", "app.varlorg.unote_30.apk", "app.varlorg.unote", "3b8dcb0a"),
+    ("gmdice", "de.duenndns.gmdice_8.apk", "de.duenndns.gmdice", "3891679d"),
+    ("dooz", "io.github.yamin8000.dooz_23.apk", "io.github.yamin8000.dooz", "a0fae907"),
+]
+APPS = {
+    "thunderbird": "net.thunderbird.android_33.apk",
+    "tusky": "com.keylesspalace.tusky_145.apk",
+    "nextcloud": "com.nextcloud.client_350000290.apk",
+    "connectbot": "org.connectbot.apk",
+}
+NDFE_RE = re.compile(r"NoClassDefFoundError[:\s]+([\w/$.]+)")
+VERDICT_RE = re.compile(r"verdict[\"'= :]+([A-Z_]{4,40})")
+
+
+def sha16(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16]
+
+
+def install(tag, apk, store):
+    marker = store / ".installed"
+    if marker.exists():
+        return "cached"
+    store.parent.mkdir(parents=True, exist_ok=True)
+    r = subprocess.run([str(BIN), "install", str(apk), "--data-root", str(store)],
+                       capture_output=True, cwd=str(MA), timeout=600)
+    marker.parent.mkdir(parents=True, exist_ok=True)
+    marker.write_text(f"rc={r.returncode}\n")
+    return f"rc={r.returncode}"
+
+
+def run_once(tag, apk, package, max_seconds=80, frames=10, store=None):
+    store = store or (OUT / f"store_{tag}" / "data")
+    rundir = OUT / tag
+    console = OUT / f"{tag}.console.log"
+    inst = install(tag, apk, store)
+    cmd = [str(BIN), "run", "--execution-mode", "real-dalvik",
+           "--data-root", str(store), "-o", str(rundir),
+           "--max-seconds", str(max_seconds), "--frames", str(frames),
+           "--trace", "--package", package]
+    t0 = time.time()
+    try:
+        with open(console, "w") as cf:
+            subprocess.run(cmd, stdout=cf, stderr=subprocess.STDOUT,
+                           cwd=str(MA), timeout=max_seconds + 60)
+    except subprocess.TimeoutExpired:
+        pass
+    wall = round(time.time() - t0, 1)
+    text = console.read_text(errors="replace")
+    shot = rundir / "screenshot.png"
+    return {
+        "tag": tag, "install": inst, "wall_s": wall,
+        "face": sha16(shot) if shot.exists() else None,
+        "uncaught": len(re.findall(r"UNCAUGHT", text)),
+        "verdicts": list(dict.fromkeys(VERDICT_RE.findall(text)))[:4],
+        "ndfe": sorted(set(NDFE_RE.findall(text)))[:8],
+        "koin_not_started": text.count("KoinApplication has not been started"),
+        "consume_ise": text.count("consumeRestoredStateForKey"),
+        "conscrypt_abort": ("S100-CRASH-FORENSICS" in text and "conscrypt" in text),
+        "strchr_ule": text.count("__strchr_chk"),
+    }
+
+
+def main():
+    out = {"base": "a4516511 (S225-M)", "battery": "s226_transfer"}
+    out["gates"] = {}
+    for tag, fname, package, expect8 in GATES:
+        r = run_once(tag, APK_DIR / fname, package, max_seconds=70, frames=8)
+        r["expect8"] = expect8
+        r["match8"] = bool(r["face"] and r["face"].startswith(expect8))
+        out["gates"][tag] = r
+        print("GATE", tag, r["face"], "expect", expect8, "match", r["match8"])
+    out["apps"] = {}
+    for tag, fname in APPS.items():
+        r = run_once(tag, APK_DIR / fname, tag2pkg(tag), max_seconds=100, frames=12)
+        out["apps"][tag] = r
+        print("APP", tag, r["face"], "uncaught", r["uncaught"],
+              "koinISE", r["koin_not_started"], "consumeISE", r["consume_ise"],
+              "conscrypt_abort", r["conscrypt_abort"], "strchr_ule", r["strchr_ule"])
+    (EVID / "S226_TRANSFER_BATTERY.json").write_text(json.dumps(out, indent=1))
+    print("WROTE", EVID / "S226_TRANSFER_BATTERY.json")
+
+
+def tag2pkg(tag):
+    return {
+        "thunderbird": "net.thunderbird.android",
+        "tusky": "com.keylesspalace.tusky",
+        "nextcloud": "com.nextcloud.client",
+        "connectbot": "org.connectbot",
+    }[tag]
+
+
+if __name__ == "__main__":
+    main()
