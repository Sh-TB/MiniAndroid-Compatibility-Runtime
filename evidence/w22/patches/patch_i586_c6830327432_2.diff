+
+def split_patch(diff, limit=42000):
+    lines = diff.splitlines(keepends=True)
+    parts, cur, cur_len = [], [], 0
+    for ln in lines:
+        if cur_len + len(ln) > limit and cur:
+            parts.append("".join(cur))
+            cur, cur_len = [], 0
+        cur.append(ln)
+        cur_len += len(ln)
+    if cur:
+        parts.append("".join(cur))
+    return parts
