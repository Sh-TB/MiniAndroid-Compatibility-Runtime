+def diff_post(f):
+    return sh("git", "show", f"{BRANCH}:{f}").stdout
+
+
+def split_patch(diff, limit):
+    lines = diff.splitlines(keepends=True)
+    parts, cur, n = [], [], 0
+    for ln in lines:
+        if n + len(ln) > limit and cur:
+            parts.append("".join(cur)); cur, n = [], 0
+        cur.append(ln); n += len(ln)
+    if cur:
+        parts.append("".join(cur))
+    return parts
