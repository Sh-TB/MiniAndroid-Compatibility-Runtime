+- the NDFE rows (which type, which caller)
+- _koin SGET-MISS state
+so the put-key (…:local:_root_) vs get-key (bare type) mismatch can be
+verified live at 9dafaadd for the Logger family (#526 prescribed step).
+"""
+import hashlib
+import json
+import os
+import re
+import subprocess
+import time
+from pathlib import Path
+
+BASE = Path("/home/z/my-project/wt_s225")
+MA = BASE / "miniandroid"
+BIN = MA / "build/miniandroid"
+APK = Path("/home/z/my-project/upload/canonical_apks/net.thunderbird.android_33.apk")
+OUT = BASE / "run/s231"
+OUT.mkdir(parents=True, exist_ok=True)
+STORE = OUT / "store/data"
+RUNDIR = OUT / "tb"
+CONSOLE = OUT / "tb.console.log"
+
+PKG = "net.thunderbird.android"
+MAXS = 90
+
+
+def main():
+    store_ok = (STORE / ".installed").exists()
+    if not store_ok:
+        STORE.parent.mkdir(parents=True, exist_ok=True)
+        subprocess.run([str(BIN), "install", str(APK), "--data-root", str(STORE)],
