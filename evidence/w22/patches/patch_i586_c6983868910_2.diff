+        (STORE / ".installed").write_text("rc=0\n")
+    env = dict(os.environ)
+    env["MINIANDROID_MAPGET_TRACE"] = "1"
+    env["MINIANDROID_S173_PROBE"] = "1"
+    env["MINIANDROID_S231_KOIN_TRACE"] = "1"
