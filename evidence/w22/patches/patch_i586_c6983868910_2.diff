+        "mapget_rows": len(re.findall(r"\[MAPGET\]", text)),
+        "s173_rows": len(re.findall(r"\[S173-MAPGET\]", text)),
+        "koin_sget_miss": len(re.findall(r"GlobalContext;._koin", text)),
