+#!/usr/bin/env python3
+"""s231_gates.py — minimal 4-gate spot battery at current main (9dafaadd).
+Proves the S231 bionic +3-symbol delta is byte-neutral on the gate faces.
+Pins: bouncy 8a6c24ac… / unote 3b8dcb0a… / gmdice 3891679d… / dooz a0fae907…
+"""
+import hashlib
+import json
+import re
+import subprocess
+import time
+from pathlib import Path
+
+BASE = Path("/home/z/my-project/wt_s225")
+MA = BASE / "miniandroid"
+BIN = MA / "build/miniandroid"
+APK_DIR = Path("/home/z/my-project/upload/canonical_apks")
+OUT = BASE / "run/s231_gates"
+OUT.mkdir(parents=True, exist_ok=True)
+
+GATES = [
+    ("bouncy", "com.dozingcatsoftware.bouncy_43.apk", "com.dozingcatsoftware.bouncy", "8a6c24ac"),
+    ("unote", "app.varlorg.unote_30.apk", "app.varlorg.unote", "3b8dcb0a"),
+    ("gmdice", "de.duenndns.gmdice_8.apk", "de.duenndns.gmdice", "3891679d"),
+    ("dooz", "io.github.yamin8000.dooz_23.apk", "io.github.yamin8000.dooz", "a0fae907"),
+]
+VERDICT_RE = re.compile(r"verdict[\"'= :]+([A-Z_]{4,40})")
+
+
+def sha16(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16]
+
+
+def main():
+    res = {}
+    for tag, fname, package, expect8 in GATES:
+        store = OUT / f"store_{tag}/data"
+        rundir = OUT / tag
+        console = OUT / f"{tag}.console.log"
+        marker = store / ".installed"
+        marker.parent.mkdir(parents=True, exist_ok=True)
+        if not marker.exists():
+            subprocess.run([str(BIN), "install", str(APK_DIR / fname),
+                            "--data-root", str(store)],
+                           capture_output=True, cwd=str(MA), timeout=600)
+            marker.write_text("ok\n")
+        cmd = [str(BIN), "run", "--execution-mode", "real-dalvik",
+               "--data-root", str(store), "-o", str(rundir),
+               "--max-seconds", "70", "--frames", "8",
+               "--trace", "--package", package]
+        t0 = time.time()
+        try:
+            with open(console, "w") as cf:
+                subprocess.run(cmd, stdout=cf, stderr=subprocess.STDOUT,
+                               cwd=str(MA), timeout=130)
+        except subprocess.TimeoutExpired:
+            pass
+        shot = rundir / "screenshot.png"
+        face = sha16(shot) if shot.exists() else None
+        text = console.read_text(errors="replace")
+        res[tag] = {"face": face, "expect8": expect8,
+                    "match": bool(face and face.startswith(expect8)),
+                    "wall": round(time.time() - t0, 1),
+                    "verdicts": list(dict.fromkeys(VERDICT_RE.findall(text)))[:3],
+                    "uncaught": len(re.findall(r"UNCAUGHT", text))}
+        print("GATE", tag, face, "expect", expect8, "match", res[tag]["match"])
+    (OUT / "s231_gates.json").write_text(json.dumps(res, indent=1))
+    print("WROTE", OUT / "s231_gates.json")
+
+
+if __name__ == "__main__":
+    main()
