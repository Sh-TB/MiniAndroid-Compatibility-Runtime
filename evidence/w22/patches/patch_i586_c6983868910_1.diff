+#!/usr/bin/env python3
+"""s231_post.py — post the S231 delta to issue #586 (K-2, truncation-safe):
+- per-file sha256 rows (the S230 receipt's suggestion, adopted)
+- smaller diff parts (<=24k chars)
+- metadata table with base/sha16/apply-check
+"""
+import hashlib
+import json
+import subprocess
+import sys
+import urllib.request
+from pathlib import Path
+
+BASE = Path("/home/z/my-project/wt_s225")
+BRANCH = "s231-engine-delta"
+REPO = "Sh-TB/MiniAndroid-Compatibility-Runtime"
+TOKEN = sys.argv[1]
+BASE_SHA = "9dafaadd"
+ISSUE = 586
+
+
+def api(method, path, payload):
+    req = urllib.request.Request(
+        f"https://api.github.com/repos/{REPO}/{path}",
+        data=json.dumps(payload).encode(),
+        headers={"Authorization": f"token {TOKEN}",
+                 "Accept": "application/vnd.github+json"},
+        method=method)
+    with urllib.request.urlopen(req) as r:
+        return json.loads(r.read())
+
+
+def sh(*a):
+    return subprocess.run(a, capture_output=True, text=True, cwd=BASE)
+
+
+def main():
+    diff = sh("git", "diff", BASE_SHA, BRANCH).stdout
+    p = BASE / "run/s231.patch"
+    p.write_text(diff)
+    psha = hashlib.sha256(diff.encode()).hexdigest()[:16]
+    numstat = [l.split("\t") for l in sh("git", "diff", "--numstat",
+               BASE_SHA, BRANCH).stdout.strip().splitlines() if l.strip()]
+    added = sum(int(a) for a, d, f in numstat)
+    deleted = sum(int(d) for a, d, f in numstat)
+
+    sh("git", "worktree", "add", "--detach",
+       "/home/z/my-project/wt_check_s231", BASE_SHA)
+    chk = subprocess.run(["git", "apply", "--check", str(p)],
+                         cwd="/home/z/my-project/wt_check_s231",
+                         capture_output=True, text=True)
+    apply_rc = chk.returncode
+    sh("git", "worktree", "remove", "/home/z/my-project/wt_check_s231", "--force")
+
+    # per-file sha256 rows (adopted from the S230 receipt's suggestion)
+    rows = "\n".join(
+        f"| `{f}` | +{a} / −{d} | `{hashlib.sha256(diff_post(f).encode()).hexdigest()[:16]}…` |"
+        for a, d, f in numstat)
+
+    gates = json.loads((BASE / "run/s231_gates/s231_gates.json").read_text())
+    gate_rows = "\n".join(
+        f"| {t} | `{v['face']}` | {v['expect8']}… | {'MATCH' if v['match'] else 'DRIFT vs S225-M pin — mainline (pristine A/B identical)'} |"
+        for t, v in gates.items())
+
+    body = f"""# S231 — the S226 engine delta re-lands on current main `{BASE_SHA}` (wave9) + the pin-drift audit finding + the Koin put/get probe (per #526) — patch in this comment per K-2 (truncation-safe format adopted)
+
+**Base:** `{BASE_SHA}` (current `origin/main`, PR #625 merge; `git ls-remote`-verified at posting time). Sandbox note: the S226 worktree was lost to a sandbox recycle — this wave re-lands on a fresh fetch.
+
+## 1. The engine delta (what the S230 receipt recorded as not-applied)
+
+The 3 FORTIFY symbols (`__memset_chk` / `__vsnprintf_chk` / `__stack_chk_fail`) re-land on `bionic_compat.c` (+31 lines). **Byte-neutrality proven live**: unote `3b8dcb0adbbc17a9` and gmdice `3891679dff449331` faces byte-identical WITH the delta; the bouncy/dooz faces below are byte-identical to a **pristine `{BASE_SHA}` rebuild without the delta** (A/B in this sandbox).
+
+## 2. AUDIT FINDING — the 6-pin HOLD state is stale at `{BASE_SHA}` (no re-pin record)
+
+| Gate | face at `{BASE_SHA}` (this sandbox) | S225-M-era pin | verdict |
+|---|---|---|---|
+{gate_rows}
+
+bouncy `98abca389fb01380` and dooz `d602648e8e401895` differ from the last recorded pins (S225-M commit message / S230 receipt binary `06f98d2a9c21ea92` claims HOLD). Attribution: the **pristine** `{BASE_SHA}` rebuild (no S231 delta) reproduces the SAME drifted faces → the drift is mainline (S226→S230→wave9: launch-blank/window-law territory), not the S231 delta. No re-pin record found in `evidence/` (grep `98abca38`/`d602648e` → only unrelated s188 traces). The 6-pin HOLD claim needs a fresh re-census + re-pin on the current main.
+
+## 3. The S231 Koin probe (#526's prescribed "add the gets", generalized)
+
+`android_shadows.cpp` +62 lines, env-gated `MINIANDROID_S231_KOIN_TRACE`, bounded 120 per side: `[S231-KOIN-GET]`/`[S231-KOIN-PUT]` rows make the indexKey put/get keys byte-comparable for the whole Koin index family (not just featureflag). Zero behavior change (probe-only; env off = inert). TB face at `{BASE_SHA}`: `43bfdac6023cba66` (== the S226 battery face; F-NEW-485 still LIVE-REDUCED, `_koin` SGET-MISS row present, koin_ise=0).
+
+## 4. Patch per K-2 — truncation-safe format (adopted from the receipt)
+
+| Item | Value |
+|---|---|
+| Base | `{BASE_SHA}` (apply parts in order on a clean tree) |
+| Shape | {len(numstat)} files, +{added} / −{deleted} |
+| Patch SHA256 | `{psha}…` |
+| `git apply --check` | {'**CLEAN rc=0**' if apply_rc == 0 else f'**FAILED rc={apply_rc}**'} on a pristine `{BASE_SHA}` worktree, verified before posting |
+| Per-file sha256 (post-image, sha16) | below |
+
+{rows}
+
+Parts below. **If any part truncates in transit, the per-file rows make it detectable at receipt time.**
+"""
+    parts = split_patch(diff, 24000)
+    n = len(parts)
+    full = body.replace("Parts below.", f"Parts 1..{n} below.")
+    # post as comments: first the receipt body, then patch parts
+    head = api("POST", f"issues/{ISSUE}/comments", {"body": full})
+    print("HEAD", head["id"], f"len {len(full)}")
+    for i, part in enumerate(parts, 1):
+        meta = f"""## S231 patch — PART {i}/{n}/{n} — base `{BASE_SHA}`, patch sha16 `{psha}`, apply-check {'CLEAN rc=0' if apply_rc == 0 else f'FAILED rc={apply_rc}'}
+
+<details><summary>PATCH PART {i}/{n}</summary>
+
+
