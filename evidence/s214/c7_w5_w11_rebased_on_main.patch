+/** CODER7 WAVE-5 store probe — the evidence recorder (Rec law from wave-3:
+ *  statics survive the whole run; the final step flushes
+ *  c7store_results.jsonl. String.concat law (no StringBuilder). */
+public class Rec {
+    public static String out = "";
+
+    public static void line(String verdict, String op, String detail) {
+        String row = "C7|".concat(op).concat("|").concat(verdict)
+                .concat("|").concat(detail == null ? "null" : detail)
+                .concat("\n");
+        out = out.concat(row);
+    }
+}
