+/** CODER7 WAVE-6: the foreign service that now EXECUTES its real
+ *  lifecycle (LoadedApk-lite). startService from the running package
+ *  brings THIS instance up (newInstance law: <init>()V → onCreate →
+ *  onStartCommand); onStartCommand appends the service's foreign
+ *  identity to the shared sandbox handshake file — the X21 verdict
+ *  reads it back. */
+public class ShareService extends Service {
+    public static int startCommands = 0;
+
+    private static void handshake(Context ctx, String line) {
+        try {
+            // AOSP MODE_APPEND law: append when present, create when
+            // absent — no java.io.File probe needed (the engine sandbox
+            // maps Context paths, not bare relative File paths).
+            FileOutputStream fos = ctx.openFileOutput(
+                "xpkg_handshake.txt", Context.MODE_APPEND);
+            fos.write((line + "\n").getBytes("UTF-8"));
+            fos.close();
+        } catch (Throwable t) {
+            // marker absent = lifecycle did not run; X21 fails honestly.
+        }
+    }
+
+    @Override public void onCreate() {
+        super.onCreate();
+        handshake(this, "svc-create:pkg=" + getPackageName());
+    }
