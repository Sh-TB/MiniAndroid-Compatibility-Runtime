+#!/usr/bin/env bash
+# c7_w5_run_probe.sh — CODER7 WAVE-5 PMS-lite probe runner.
+#
+# Runs the three-package store probe (fixtures/c7_pkg_store_probe):
+#   COLD ×3 — the SQLite package cache is deleted before every run
+#             (every APK re-parsed: cache=COLD rows).
+#   WARM ×3 — the cache db persists (cache=WARM rows: no AXML re-parse —
+#             the "apps load sooner" evidence).
+#
+# Usage: bash scripts/c7_w5_run_probe.sh <tag>
+set -uo pipefail
+R=/home/z/my-project/c7tree
+BIN=${BIN:-$R/miniandroid/build/miniandroid}
+TAG=${1:?tag}
+OUT=$R/run/c7w5/$TAG
+rm -rf "$OUT"; mkdir -p "$OUT"
+STORE=$R/run/c7w5/store
+rm -rf "$STORE"; mkdir -p "$STORE"
+cp "$R"/fixtures/c7_pkg_store_probe/apks/*.apk "$STORE/"
+ls -la "$STORE"
+export MINIANDROID_PKG_STORE="$STORE"
+
+run_one() { # <dir> <apk>
+  local o=$1 apk=$2
+  rm -rf "$o"; mkdir -p "$o"
+  # fresh-install semantics: every run starts from an EMPTY app data dir
+  # (the verdict file is MODE_APPEND — a stale dir would accumulate rows)
+  rm -rf "$R/runtime/data/data/data/c7.store.main" \
+         "$R/runtime/data/data/data/c7.store.browser" \
+         "$R/runtime/data/data/data/c7.store.share"
+  MINIANDROID_FILE_IO="$o/file_io.jsonl" timeout 180 "$BIN" run "$apk" \
+    --width 1080 --height 1920 --frames 3 --max-seconds 60 -o "$o" \
+    > "$o/run.log" 2>&1
+  echo "run rc=$? -> $o"
+  # snapshot the app-side verdict rows (MODE_PRIVATE file under the
+  # per-package sandbox: runtime/data/data/data/<pkg>/files/) BEFORE the
+  # next run overwrites them.
+  local res="$R/runtime/data/data/data/c7.store.main/files/c7store_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7store_results.jsonl"
+}
+
+# ── COLD ×3 ────────────────────────────────────────────────────────────────
+for i in 1 2 3; do
+  rm -f "$STORE/c7_pkg_cache.sqlite3"
+  run_one "$OUT/main_cold$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── WARM ×3 (cache persists across runs; pre-run populates it) ────────────
+run_one "$OUT/main_warm_pre" "$STORE/c7pkgstore_main.apk"
+for i in 1 2 3; do
+  run_one "$OUT/main_warm$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── evidence collection ───────────────────────────────────────────────────
+cd "$OUT"
+for d in main_cold1 main_cold2 main_cold3 main_warm1 main_warm2 main_warm3; do
+  if [ -f "$d/c7store_results.jsonl" ]; then cp "$d/c7store_results.jsonl" "$d.results.jsonl"; else echo "MISSING results in $d"; fi
+done
+cat main_cold*.results.jsonl > c7store_cold_results.jsonl 2>/dev/null
+cat main_warm*.results.jsonl > c7store_warm_results.jsonl 2>/dev/null
+for i in 1 2 3; do
+  grep -h 'C7-STORE' "main_cold$i/run.log" | sed "s/^/COLD$i /" >> store_cache_rows_cold.txt
+  grep -h 'C7-STORE' "main_warm$i/run.log" | sed "s/^/WARM$i /" >> store_cache_rows_warm.txt
+done
+echo '═══ verdict tallies (cold×3 / warm×3) ═══'
+for d in main_cold1 main_cold2 main_cold3 main_warm1 main_warm2 main_warm3; do
+  echo "$d PASS=$(grep -c '|PASS|' $d.results.jsonl 2>/dev/null) FAIL=$(grep -c '|FAIL|' $d.results.jsonl 2>/dev/null)"
+done
+echo '═══ cold×3 row-identity check ═══'
+for i in 2 3; do
+  if diff -q main_cold1.results.jsonl main_cold$i.results.jsonl >/dev/null 2>&1; then
+    echo "cold1 == cold$i (byte-identical)"
+  else
+    echo "cold1 != cold$i"; diff main_cold1.results.jsonl main_cold$i.results.jsonl | head -5
+  fi
+done
+echo '═══ cache rows (cold vs warm) ═══'
+cat store_cache_rows_cold.txt store_cache_rows_warm.txt
+echo '═══ SHA-256 ═══'
+sha256sum c7store_cold_results.jsonl c7store_warm_results.jsonl main_cold1.results.jsonl 2>/dev/null
+echo "RUNNER DONE tag=$TAG"
