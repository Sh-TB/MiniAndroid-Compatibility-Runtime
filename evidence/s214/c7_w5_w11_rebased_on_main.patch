index 00000000..8a05ae3e
--- /dev/null
+++ b/scripts/c7_w8_androguard_check.py
@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+# c7_w8_androguard_check.py — CODER7 WAVE-8: INDEPENDENT third-party
+# verification of the store-probe APKs with ANDROGUARD (the S186 probe-db
+# tool; user directive). Extends the W6/W7 cross-parser contract with the
+# W8 facts the engine now gates on:
+#   * PROVIDER readPermission/writePermission (the per-op CRUD gate —
+#     L1) parsed independently from the AXML;
+#   * the foreign launchMode fixture (TopActivity singleTask — L4);
+#   * the running package's uses-permission (SHARE_READ declared,
+#     SECURE_READ/SHARE_WRITE absent — the gate's grant inputs).
+# A mismatch would mean the engine's index diverges from the real
+# Android manifest semantics; agreement is cross-parser evidence.
+#
+# Output: JSON verdict to stdout; exit 0 iff every expectation holds.
+import json
+import sys
+
+# androguard v4 routes its AXML parser trace through loguru to STDOUT —
+# silence it BEFORE the import so the JSON verdict is the only stdout
+# content (the runner captures stdout as the verdict file).
+from loguru import logger
+
+logger.remove()
+
+from androguard.core.apk import APK
+
+EXPECTED = {
+    "c7pkgstore_browser": {
+        "package": "c7.store.browser",
+        "receivers": {
+            "c7.store.browser.BrowserPingReceiver": {"exported": True,
+                                                     "enabled": True},
+            "c7.store.browser.NoisyReceiver": {"exported": False,
+                                               "enabled": True},
+        },
+        "providers": {
+            "c7.store.browser.ClipProvider": {"exported": True,
+                                              "enabled": True},
+            "c7.store.browser.DeadProvider": {"exported": True,
+                                              "enabled": False},
+        },
+        "services": {},
+        "activities": {
+            "c7.store.browser.BrowserActivity": {"exported": True,
+                                                 "enabled": True},
+            "c7.store.browser.NoDefaultActivity": {"exported": True,
+                                                   "enabled": True},
+            "c7.store.browser.HiddenViewActivity": {"exported": False,
+                                                    "enabled": True},
+            "c7.store.browser.DeadViewActivity": {"exported": True,
+                                                  "enabled": False},
+            # CODER7 WAVE-8 L4: the foreign launchMode fixture.
+            "c7.store.browser.TopActivity": {"exported": True,
+                                             "enabled": True,
+                                             "launchMode": "singleTask"},
+        },
+    },
+    "c7pkgstore_share": {
+        "package": "c7.store.share",
+        "services": {
+            "c7.store.share.ShareService": {"exported": True,
+                                            "enabled": True},
+        },
+        "receivers": {},
+        "providers": {
+            # CODER7 WAVE-8 L1: the permission-gate facts.
+            "c7.store.share.ShareProvider": {
+                "exported": True, "enabled": True,
+                "readPermission": "c7.perm.SHARE_READ",
+                "writePermission": "c7.perm.SHARE_WRITE",
+            },
+            "c7.store.share.SecureProvider": {
+                "exported": True, "enabled": True,
+                "readPermission": "c7.perm.SECURE_READ",
+                "writePermission": None,
+            },
+        },
+        "activities": {},
+    },
+    "c7pkgstore_main": {
+        "package": "c7.store.main",
+        "receivers": {
+            # CODER7 WAVE-8 L2: the own PI-send receiver.
+            "c7.store.main.PingReceiver": {"exported": True,
+                                           "enabled": True},
+        },
+        "services": {},
+        "providers": {},
+        "activities": {},
+        # The gate's grant inputs: exactly ONE of the three c7.perm.*
+        # permissions is declared (AOSP uses-permission law).
+        "uses_permissions": ["c7.perm.SHARE_READ"],
+    },
+}
+
+
+import xml.etree.ElementTree as ET
+
+_MANIFEST_CACHE = {}
+
+
+def manifest_tree(apk):
+    """Decode the binary AXML once per APK (androguard v4-stable API) and
+    return the parsed ElementTree root."""
+    key = apk.get_package()
+    if key not in _MANIFEST_CACHE:
+        _MANIFEST_CACHE[key] = ET.fromstring(
+            apk.get_android_manifest_axml().get_xml())
+    return _MANIFEST_CACHE[key]
+
+
+ANDROID_NS = "{http://schemas.android.com/apk/res/android}"
+
+
+def find_el(apk, kind, name):
+    tag = {"receiver": "receiver", "service": "service",
+           "provider": "provider", "activity": "activity"}[kind]
+    root = manifest_tree(apk)
+    for app in root.findall("application"):
+        for el in app.findall(tag):
+            nm = el.get(ANDROID_NS + "name") or ""
+            if nm == name or nm == "." + name.rsplit(".", 1)[-1]:
+                return el
+    return None
+
+
+def flag(apk, kind, name, attr):
+    """attr value of `android:<attr>` on the <kind android:name=name> element
+    under <application>; None when the element (or attribute) is absent.
+    enabled absent ⇒ AOSP default true. Boolean attrs otherwise default
+    false; string attrs answer None when absent."""
+    el = find_el(apk, kind, name)
+    if el is None:
+        return None
+    v = el.get(ANDROID_NS + attr)
+    if attr == "exported":
+        return v is not None and str(v) == "true"
+    if attr == "enabled":
+        return v is None or str(v) == "true"
+    if attr in ("readPermission", "writePermission", "launchMode"):
+        return None if v is None else str(v)
+    return v
+
+
+def uses_permissions(apk):
+    root = manifest_tree(apk)
+    out = []
+    for p in root.findall("uses-permission"):
+        v = p.get(ANDROID_NS + "name")
+        if v:
+            out.append(str(v))
+    return sorted(out)
+
+
+def main():
+    results = {}
+    all_ok = True
+    for fixture, exp in EXPECTED.items():
+        apk_path = ("fixtures/c7_pkg_store_probe/apks/" + fixture +
+                    ".apk")
+        try:
+            a = APK(apk_path)
+        except Exception as e:  # noqa: BLE001
+            results[fixture] = {"error": "APK open failed: %s" % e}
+            all_ok = False
+            continue
+        pkg_ok = a.get_package() == exp["package"]
+        comp = {"package": a.get_package(), "pkg_ok": pkg_ok}
+        if not pkg_ok:
+            all_ok = False
+        for kind in ("receivers", "services", "providers", "activities"):
+            singular = {"receivers": "receiver", "services": "service",
+                        "providers": "provider",
+                        "activities": "activity"}[kind]
+            got = {}
+            for cls, law in exp[kind].items():
+                ex = flag(a, singular, cls, "exported")
+                en = flag(a, singular, cls, "enabled")
+                match = (ex is True if law["exported"] else ex is False) \
+                    and (en is True if law["enabled"] else en is False)
+                if "launchMode" in law:
+                    lm = flag(a, singular, cls, "launchMode")
+                    # aapt2 compiles the enum to its INT form (0..3) —
+                    # androguard surfaces the raw value; the AOSP
+                    # ActivityInfo constants: 0 standard, 1 singleTop,
+                    # 2 singleTask, 3 singleInstance. Accept either the
+                    # int spelling or the string spelling.
+                    LM_NAMES = {"0": "standard", "1": "singleTop",
+                                "2": "singleTask", "3": "singleInstance"}
+                    lm_name = LM_NAMES.get(str(lm), str(lm))
+                    got_lm = lm_name == law["launchMode"]
+                    match = match and got_lm
+                    got[cls] = {"exported": ex, "enabled": en,
+                                "launchMode": lm_name, "match": match}
+                    if not got_lm:
+                        all_ok = False
+                    continue
+                if "readPermission" in law or \
+                        "writePermission" in law:
+                    rp = flag(a, singular, cls, "readPermission")
+                    wp = flag(a, singular, cls, "writePermission")
+                    rp_ok = (law.get("readPermission") is None
+                             and rp is None) or \
+                            (law.get("readPermission") == rp)
+                    wp_ok = (law.get("writePermission") is None
+                             and wp is None) or \
+                            (law.get("writePermission") == wp)
+                    match = match and rp_ok and wp_ok
+                    got[cls] = {"exported": ex, "enabled": en,
+                                "readPermission": rp,
+                                "writePermission": wp, "match": match}
+                    if not (rp_ok and wp_ok):
+                        all_ok = False
+                    continue
+                got[cls] = {"exported": ex, "enabled": en, "match": match}
+                if not match:
+                    all_ok = False
+            comp[kind] = got
+        if "uses_permissions" in exp:
+            got_up = uses_permissions(a)
+            up_ok = got_up == sorted(exp["uses_permissions"])
+            comp["uses_permissions"] = {"got": got_up, "match": up_ok}
+            if not up_ok:
+                all_ok = False
+        results[fixture] = comp
+    verdict = {"tool": "androguard-4.1.4", "all_ok": all_ok,
+               "fixtures": results}
+    print(json.dumps(verdict, indent=1, sort_keys=True))
+    return 0 if all_ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
