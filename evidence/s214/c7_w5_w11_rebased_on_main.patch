+package c7.store.main;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import java.io.FileOutputStream;
+
+/** CODER7 WAVE-8 L2: the OWN-package receiver the PendingIntent.send
+ *  broadcast law delivers into. The receiver appends the marker the
+ *  verdict ops X31/X32/X33 read — the delivery proof is the receiver's
+ *  own bytecode writing it, never an engine assertion. The extra value
+ *  rides the intent (X33 asserts the FROZEN intent's extra wins over the
+ *  fill-in on an IMMUTABLE record). */
+public class PingReceiver extends BroadcastReceiver {
+    public static int deliveries = 0;
+
+    private static void handshake(Context ctx, String line) {
+        try {
+            FileOutputStream fos = ctx.openFileOutput(
+                "xpkg_handshake.txt", Context.MODE_APPEND);
+            fos.write((line + "\n").getBytes("UTF-8"));
+            fos.close();
+        } catch (Throwable t) {
+            // No silent fabrication: a failed handshake leaves the marker
+            // absent (the verdict then fails honestly).
+        }
+    }
+
+    @Override public void onReceive(Context ctx, Intent i) {
+        deliveries++;
+        String k = i == null ? "null" : i.getStringExtra("k");
+        handshake(ctx, "pi-recv:deliveries=" + deliveries
+                            + ";k=" + (k == null ? "null" : k));
+    }
+}
