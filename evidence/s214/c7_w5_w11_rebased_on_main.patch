+package c7.laws;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.ParcelFileDescriptor;
+
+/** CODER7 WAVE-9 — the provider the resolver-depth laws land on. Every
+ *  override records what the ROUTE actually delivered (mode strings,
+ *  calling package), so the verdict rows measure the engine's dispatch,
+ *  never a fabricated answer. bulkInsert is IMPLEMENTED HERE on purpose:
+ *  the L01 op tests the ContentResolver→provider ROUTE (the resolver
+ *  gate must route the method; a resolver that never forwards it fails
+ *  the row honestly). */
+public class NumProvider extends ContentProvider {
+    public static String lastReadMode = null;
+    public static String lastWriteMode = null;
+    public static String lastCallingPackage = "unset";
+    public static int insertCalls = 0;
+    public static int bulkInsertCalls = 0;
+    public static int queryCalls = 0;
+
+    static final String AUTH = "c7.laws.num";
+
+    @Override public boolean onCreate() { return true; }
+
+    @Override public String getType(Uri uri) {
+        return "vnd.android.cursor.dir/vnd.c7.laws.num";
+    }
+
+    @Override public Cursor query(Uri uri, String[] projection,
+                                  String selection, String[] selArgs,
+                                  String sortOrder) {
+        queryCalls++;
+        lastCallingPackage = getCallingPackage();
+        MatrixCursor mc = new MatrixCursor(new String[]{"k", "v"});
+        mc.addRow(new Object[]{"a", "1"});
+        return mc;
+    }
+
+    @Override public Uri insert(Uri uri, ContentValues values) {
+        insertCalls++;
+        lastCallingPackage = getCallingPackage();
+        return Uri.parse("content://" + AUTH + "/row/" + insertCalls);
+    }
+
+    @Override public int bulkInsert(Uri uri, ContentValues[] values) {
+        bulkInsertCalls++;
+        lastCallingPackage = getCallingPackage();
+        return values == null ? 0 : values.length;
+    }
+
+    @Override public int update(Uri uri, ContentValues values,
+                                String selection, String[] selArgs) {
+        return 1;
+    }
+
+    @Override public int delete(Uri uri, String selection,
+                                String[] selArgs) {
+        return 1;
+    }
+
+    @Override public ParcelFileDescriptor openFile(Uri uri, String mode) {
+        if ("r".equals(mode)) lastReadMode = mode;
+        else lastWriteMode = mode;
+        // The engine's openFileDescriptor route must deliver the MODE:
+        // return a real descriptor over a tiny in-sandbox file.
+        try {
+            java.io.File f = new java.io.File(
+                getContext().getFilesDir(), "num_open_" + mode + ".txt");
+            java.io.FileOutputStream fos = new java.io.FileOutputStream(f);
+            fos.write(("mode=" + mode).getBytes("UTF-8"));
+            fos.close();
+            return ParcelFileDescriptor.open(f,
+                android.os.ParcelFileDescriptor.parseMode(mode));
+        } catch (Throwable t) {
+            return null;  // honest: null only when the sandbox refuses
+        }
+    }
+}
