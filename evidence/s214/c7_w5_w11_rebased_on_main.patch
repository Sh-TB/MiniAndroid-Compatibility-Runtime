+++ b/scripts/c7_w7_run_probe.sh
@@ -0,0 +1,143 @@
+#!/usr/bin/env bash
+# c7_w7_run_probe.sh — CODER7 WAVE-7 probe runner (cross-package ACTIVITY
+# LAUNCH: AOSP ActivityStarter + checkComponentPermission law). Extends the
+# WAVE-6 runner with:
+#   * the 23-op verdict contract (X01-X16 WAVE-5 rows + X20-X23 WAVE-6 rows
+#     + X24-X26 W7 rows: implicit cross-package start, non-exported deny,
+#     disabled deny)
+#   * the W7 engine-row evidence greps (ACT-XPKG-RESOLVE / ACT-XPKG-EXEC /
+#     C7-ACT-GATE) — the foreign activity's REAL lifecycle
+#   * the lifecycle_trace.json launch record (launched=true, callbacks)
+#   * the handshake act-create marker written by the FOREIGN onCreate
+#   * the androguard cross-parser check (now also the ACTIVITY gate facts)
+# COLD ×3 — the SQLite package cache is deleted before every run.
+# WARM ×3 — the cache persists (cache=WARM rows: no AXML re-parse).
+#
+# Usage: bash scripts/c7_w7_run_probe.sh <tag>
+set -uo pipefail
+R=/home/z/my-project/c7tree
+BIN=${BIN:-$R/miniandroid/build/miniandroid}
+TAG=${1:?tag}
+OUT=$R/run/c7w7/$TAG
+rm -rf "$OUT"; mkdir -p "$OUT"
+STORE=$R/run/c7w7/store
+rm -rf "$STORE"; mkdir -p "$STORE"
+cp "$R"/fixtures/c7_pkg_store_probe/apks/*.apk "$STORE/"
+ls -la "$STORE"
+export MINIANDROID_PKG_STORE="$STORE"
+
+run_one() { # <dir> <apk>
+  local o=$1 apk=$2
+  rm -rf "$o"; mkdir -p "$o"
+  # fresh-install semantics: every run starts from an EMPTY app data dir
+  # (AOSP install wipes app data; the append-only handshake file would
+  # otherwise accumulate across the battery's runs and change the X20/X24
+  # detail bytes run-to-run).
+  rm -rf "$R/runtime/data/data/data/c7.store.main"
+  MINIANDROID_FILE_IO="$o/file_io.jsonl" timeout 240 "$BIN" run "$apk" \
+    --width 1080 --height 1920 --frames 3 --max-seconds 60 -o "$o" \
+    > "$o/run.log" 2>&1
+  echo "run rc=$? -> $o"
+  # snapshot the app-side verdict rows (MODE_PRIVATE file under the
+  # per-package sandbox) BEFORE the next run overwrites them.
+  local res="$R/runtime/data/data/data/c7.store.main/files/c7store_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7store_results.jsonl"
+  local hs="$R/runtime/data/data/data/c7.store.main/files/xpkg_handshake.txt"
+  [ -f "$hs" ] && cp "$hs" "$o/xpkg_handshake.txt"
+}
+
+# ── androguard cross-parser verification (independent AXML truth; W7 adds
+#    the ACTIVITY launch-gate facts) ────────────────────────────────────────
+python3 "$R/scripts/c7_w6_androguard_check.py" \
+  > "$OUT/androguard_check.json" 2> "$OUT/androguard_check.err"
+echo "androguard_check rc=$? (0 = every exported/enabled law incl. W7 activities matches)"
+
+# ── COLD ×3 ────────────────────────────────────────────────────────────────
+for i in 1 2 3; do
+  rm -f "$STORE/c7_pkg_cache.sqlite3"
+  run_one "$OUT/main_cold$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── WARM ×3 (cache persists across runs; pre-run populates it) ────────────
+run_one "$OUT/main_warm_pre" "$STORE/c7pkgstore_main.apk"
+for i in 1 2 3; do
+  run_one "$OUT/main_warm$i" "$STORE/c7pkgstore_main.apk"
+done
+
+# ── evidence collection ───────────────────────────────────────────────────
+cd "$OUT"
+: > store_cache_rows_cold.txt
+: > store_cache_rows_warm.txt
+for i in 1 2 3; do
+  grep -E 'C7-STORE-DONE|C7-STORE\]' main_cold$i/run.log \
+    >> store_cache_rows_cold.txt 2>/dev/null
+  grep -E 'C7-STORE-DONE|C7-STORE\]' main_warm$i/run.log \
+    >> store_cache_rows_warm.txt 2>/dev/null
+done
+echo '═══ verdict op summary (cold1) ═══'
+cut -d'|' -f2,3 main_cold1/c7store_results.jsonl 2>/dev/null
+echo '═══ W7 launch evidence rows (cold1, file_io.jsonl) ═══'
+grep -E '"op":"(ACT-XPKG-RESOLVE|ACT-XPKG-EXEC|ACT-START)"' \
+  main_cold1/file_io.jsonl 2>/dev/null | head -12
+echo '═══ W7 stderr launch rows (cold1, run.log) ═══'
+grep -E 'C7-ACT-XPKG|C7-ACT-GATE|G08-LAUNCH\] launched' \
+  main_cold1/run.log 2>/dev/null | head -10
+echo '═══ lifecycle launch record (cold1; drained at the frame boundary) ═══'
+python3 - <<'PYEOF' 2>/dev/null || echo "(lifecycle parse failed)"
+import json
+d = json.load(open("main_cold1/frames/manifest.json"))
+al = d.get("activity_launch") or {}
+cbs = {c.get("method"): c for c in (al.get("callbacks") or [])}
+ok_launch = al.get("launched") is True
+ok_comp = al.get("component_descriptor") == "Lc7/store/browser/BrowserActivity;"
+init_ok = cbs.get("<init>", {}).get("dispatched") is True
+create_ok = cbs.get("onCreate", {}).get("dispatched") is True
+print("launched:", al.get("launched"), "| component:",
+      al.get("component_descriptor"))
+for name in ("<init>", "onCreate"):
+    c = cbs.get(name) or {}
+    print("  cb:", name, "class:", c.get("class"),
+          "dispatched:", c.get("dispatched"),
+          "instructions:", c.get("instructions"))
+hs = open("main_cold1/xpkg_handshake.txt").read() \
+    if __import__("os").path.exists("main_cold1/xpkg_handshake.txt") else ""
+marker_ok = "act-create:pkg=c7.store.browser" in hs
+verdict = "PASS" if (ok_launch and ok_comp and init_ok
+                     and create_ok and marker_ok) else "FAIL"
+print("W7-LAUNCH-CONTRACT:", verdict,
+      f"(launched={ok_launch} component={ok_comp} init={init_ok} "
+      f"create={create_ok} marker={marker_ok})")
+PYEOF
+echo '═══ handshake markers (cold1; the FOREIGN onCreate wrote act-create) ═══'
+cat main_cold1/xpkg_handshake.txt 2>/dev/null || echo "(no handshake file)"
+echo '═══ SHA-256 ═══'
+for i in 1 2 3; do
+  sha256sum main_cold$i/c7store_results.jsonl main_warm$i/c7store_results.jsonl \
+    2>/dev/null
+done
+cat main_cold1/c7store_results.jsonl main_cold2/c7store_results.jsonl \
+    main_cold3/c7store_results.jsonl > c7store_cold_results.jsonl 2>/dev/null
+cat main_warm1/c7store_results.jsonl main_warm2/c7store_results.jsonl \
+    main_warm3/c7store_results.jsonl > c7store_warm_results.jsonl 2>/dev/null
+sha256sum c7store_cold_results.jsonl c7store_warm_results.jsonl 2>/dev/null
+echo '═══ X01-X23 prefix equality vs WAVE-6 golden ═══'
+# NOTE: the X20 row detail embeds the handshake content (which carries a
+# trailing newline), so the W6 20-row file is 21 LINES. The prefix law:
+# the whole W6-era file (21 lines / 20 ops) is a byte-exact prefix of the
+# W7 23-op file.
+GOLDEN=$R/evidence/c7_w7/x23_w6_golden.jsonl
+if [ -f "$GOLDEN" ]; then
+  head -21 main_cold1/c7store_results.jsonl > /tmp/c7w7_prefix.jsonl
+  if cmp -s /tmp/c7w7_prefix.jsonl "$GOLDEN"; then
+    echo "X01-X23 prefix (20 W6 ops / 21 lines): BYTE-IDENTICAL to the WAVE-6 golden"
+  else
+    echo "X01-X23 prefix: DIFFERS from the WAVE-6 golden"
+    diff "$GOLDEN" /tmp/c7w7_prefix.jsonl | head
+  fi
+else
+  echo "(golden not found at $GOLDEN — snapshot after first cold run)"
+  head -21 main_cold1/c7store_results.jsonl > "$GOLDEN" 2>/dev/null || true
+fi
+echo '═══ cache rows (cold vs warm) ═══'
+cat store_cache_rows_cold.txt store_cache_rows_warm.txt
+echo "RUNNER DONE tag=$TAG"
