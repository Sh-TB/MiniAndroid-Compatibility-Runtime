+    @Override public String getType(Uri uri) {
+        return "vnd.android.cursor.dir/vnd.c7.w11.p";
+    }
+
+    @Override public Cursor query(Uri uri, String[] projection,
+                                  String selection, String[] selArgs,
+                                  String sortOrder) {
+        queryCalls++;
+        MatrixCursor mc = new MatrixCursor(new String[]{"k", "v"});
+        for (int i = 0; i < live.size(); i++)
+            mc.addRow(new Object[]{"k" + i, live.get(i)});
+        return mc;
+    }
+
+    @Override public Uri insert(Uri uri, ContentValues values) {
+        int n = live.size() + 1;
+        live.add(String.valueOf(n));
+        return Uri.parse("content://" + AUTH + "/row/" + n);
+    }
+
+    @Override public int update(Uri uri, ContentValues values,
+                                String selection, String[] selArgs) {
+        Integer v = values == null ? null : values.getAsInteger("n");
+        lastUpdateValue = v == null ? -1 : v.intValue();
+        lastUpdateSel = selection == null ? "null" : selection;
+        return live.size();
