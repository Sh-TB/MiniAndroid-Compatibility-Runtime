+    android:versionName="1.0">
+    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />
+    <application android:name=".LawsApplication" android:label="C7Laws">
+        <activity android:name=".Main" android:exported="true">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity>
+        <activity android:name=".Second" android:exported="false" />
+        <!-- CODER7 WAVE-9: PermReceiver is gated by a permission the
+             running app NEVER holds (L31: the send must not deliver). -->
+        <receiver android:name=".LawsReceiver" android:exported="true">
+            <intent-filter>
+                <action android:name="c7.laws.PING" />
+            </intent-filter>
+        </receiver>
+        <receiver android:name=".LawsReceiver2" android:exported="true">
+            <intent-filter>
+                <action android:name="c7.laws.PING2" />
+            </intent-filter>
+        </receiver>
+        <receiver android:name=".PermReceiver" android:exported="true"
+            android:permission="c7.perm.GATED">
+            <intent-filter>
+                <action android:name="c7.laws.PINGG" />
+            </intent-filter>
+        </receiver>
+        <service android:name=".LawsService" android:exported="true" />
+        <!-- CODER7 WAVE-9: the provider the resolver-depth laws land on
+             (bulkInsert route / observers / getCallingPackage / modes). -->
+        <provider android:name=".NumProvider"
+            android:authorities="c7.laws.num" android:exported="true" />
+    </application>
+    <!-- DECLARED but the manifest PermReceiver gate uses c7.perm.GATED which
+         is NOT declared: the L31 send must be denied. c7.laws.OPEN is used
+         as the L32 dynamic-receiver sender permission that IS held. -->
+    <uses-permission android:name="c7.laws.OPEN" />
+</manifest>
