+package c7.w11;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.IBinder;
+
+/** CODER7 WAVE-11 — the service the onTaskRemoved / onTimeout /
+ *  peekService laws land on. onTaskRemoved (AOSP ActiveServices: the
+ *  launching task removal) and onTimeout (API 34 shortService budget)
+ *  are delivered at the frame-2 system-signal point; each writes its
+ *  own verdict row and flushes (the ONLY honest evidence channel —
+ *  the row exists iff the callback REALLY ran). */
+public class W11Service extends Service {
+    public static int lastStartId = -1;
+    public static int taskRemovedRuns = 0;
+    public static int timeoutRuns = 0;
+
+    @Override public void onCreate() { super.onCreate(); }
+
+    @Override public int onStartCommand(Intent intent, int flags,
+                                        int startId) {
+        lastStartId = startId;
+        return Service.START_STICKY;
+    }
+
+    @Override public IBinder onBind(Intent intent) {
+        // A real binder object — peekService (N13) answers THIS instance
+        // while the service is running, never a fabricated one.
+        return new android.os.Binder();
+    }
+
+    @Override public void onTaskRemoved(Intent rootIntent) {
+        taskRemovedRuns++;
+        String act = rootIntent == null ? "null" : rootIntent.getAction();
+        Rec.ok("N07", "task_removed=1;root=" + (act == null ? "null" : act)
+            + ";startId=" + lastStartId);
+        Rec.flush(this, "c7w11_results.jsonl");
+        super.onTaskRemoved(rootIntent);
+    }
+
+    @Override public void onTimeout(int startId) {
+        timeoutRuns++;
+        // The API 34 contract: the delivered startId is the service's OWN
+        // last startId, and the service must stop (the engine tracks the
+        // stop-or-kill obligation — the row records the fact only).
+        boolean own = startId == lastStartId;
+        if (own) Rec.ok("N08", "timeout=1;startId=" + startId
+            + ";stop_now=1");
+        else Rec.bad("N08", "timeout=1;startId=" + startId
+            + ";own_last=" + lastStartId);
+        Rec.flush(this, "c7w11_results.jsonl");
+        stopSelf();
+        super.onTimeout(startId);
+    }
+}
