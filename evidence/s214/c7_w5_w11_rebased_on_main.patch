@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+# c7_w8_auto_probe.sh — CODER7 WAVE-8 L3: the data-root auto-index probe.
+#
+# The L3 law: MINIANDROID_PKG_STORE unset ⇒ the engine indexes its OWN
+# install store (<data-root>/data/app/<pkg>/base.apk — the AOSP /data/app
+# scan) at boot. This probe:
+#   1. builds a FRESH data-root and installs the three store fixtures
+#      through the engine's OWN `install` command (F-NEW-231 mapping);
+#   2. runs the main fixture FROM the installed base.apk with NO
+#      MINIANDROID_PKG_STORE (MINIANDROID_DATA_ROOT=<fresh root>);
+#   3. requires the 33-op verdict file to be BYTE-IDENTICAL to the
+#      explicit-store battery's — auto-index ≡ explicit store, proven
+#      byte-for-byte (plus the C7-STORE-AUTO engine rows).
+# ×2 cold for determinism.
+set -uo pipefail
+R=/home/z/my-project/c7tree
+BIN=${BIN:-$R/miniandroid/build/miniandroid}
+TAG=${1:?tag}
+OUT=$R/run/c7w8/auto_$TAG
+rm -rf "$OUT"; mkdir -p "$OUT"
+DROOT="$OUT/dataroot"
+mkdir -p "$DROOT"
+REF=$R/run/c7w8/w8main/main_cold1/c7store_results.jsonl
+[ -f "$REF" ] || REF=$R/run/c7w8/*/main_cold1/c7store_results.jsonl
+
+for p in c7pkgstore_browser c7pkgstore_share c7pkgstore_main; do
+  ( cd "$R" && "$BIN" install \
+      "$R/fixtures/c7_pkg_store_probe/apks/$p.apk" \
+      --data-root "$DROOT" > "$OUT/install_$p.log" 2>&1 ) \
+    || echo "install $p rc=$?"
+done
+ls -la "$DROOT/data/app/"
+
+run_auto() { # <dir>
+  local o=$1
+  rm -rf "$o"; mkdir -p "$o"
+  rm -rf "$DROOT/data/data/c7.store.main"
+  ( cd "$R" && env -u MINIANDROID_PKG_STORE \
+    MINIANDROID_DATA_ROOT="$DROOT" \
+    MINIANDROID_FILE_IO="$o/file_io.jsonl" timeout 240 "$BIN" run \
+    "$DROOT/data/app/c7.store.main/base.apk" \
+    --width 1080 --height 1920 --frames 9 --max-seconds 120 -o "$o" \
+    > "$o/run.log" 2>&1 )
+  echo "run rc=$? -> $o"
+  local res="$DROOT/data/data/c7.store.main/files/c7store_results.jsonl"
+  [ -f "$res" ] && cp "$res" "$o/c7store_results.jsonl"
+  local hs="$DROOT/data/data/c7.store.main/files/xpkg_handshake.txt"
+  [ -f "$hs" ] && cp "$hs" "$o/xpkg_handshake.txt"
+}
+
+for i in 1 2; do
+  rm -f "$DROOT/data/app/c7_pkg_cache.sqlite3"
+  run_auto "$OUT/auto_cold$i"
+done
+
+cd "$OUT"
+echo '═══ auto-index engine rows (cold1) ═══'
+grep -E 'C7-STORE-AUTO|C7-W8' auto_cold1/run.log | head -6
+echo '═══ verdict SHAs (×2 cold) ═══'
+sha256sum auto_cold1/c7store_results.jsonl auto_cold2/c7store_results.jsonl 2>/dev/null
+echo '═══ equivalence vs the explicit-store battery ═══'
+if [ -f "$REF" ]; then
+  cmp -s "$REF" auto_cold1/c7store_results.jsonl \
+    && echo "AUTO-INDEX == EXPLICIT STORE (byte-identical 33-op verdict)" \
+    || { echo "EQUIVALENCE FAILED"; diff <(cut -d'|' -f2,3 "$REF") \
+         <(cut -d'|' -f2,3 auto_cold1/c7store_results.jsonl) | head -20; }
+else
+  echo "(reference battery not found — run c7_w8_run_probe.sh first)"
+fi
+echo '═══ handshake (cold1) ═══'
+cat auto_cold1/xpkg_handshake.txt 2>/dev/null | head -12
+echo 'AUTO RUNNER DONE' tag=$TAG
