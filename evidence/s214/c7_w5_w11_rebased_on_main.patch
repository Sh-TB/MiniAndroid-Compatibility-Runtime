+package c7.w10;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+
+/** CODER7 WAVE-10 — the provider the BATCH-CRUD laws land on. The in-memory
+ *  table is deliberately deterministic: insert grows rows, update answers
+ *  the live row count, delete clears it, query mirrors it — so every
+ *  ContentProviderResult the engine builds is assertable from the app side.
+ *  getStreamTypes is overridden on purpose (the resolver must route it; the
+ *  AOSP base answers null — the no-override arm is a separate honest row). */
+public class BatchProvider extends ContentProvider {
+    public static int rows = 0;
+    public static int insertCalls = 0;
+    public static int updateCalls = 0;
+    public static int deleteCalls = 0;
+    public static int streamTypesCalls = 0;
+    public static String lastMimeFilter = "unset";
+
+    static final String AUTH = "c7.w10.batch";
+
+    @Override public boolean onCreate() { return true; }
+
+    @Override public String getType(Uri uri) {
+        return "vnd.android.cursor.dir/vnd.c7.w10.batch";
+    }
+
+    @Override public Cursor query(Uri uri, String[] projection,
+                                  String selection, String[] selArgs,
+                                  String sortOrder) {
+        MatrixCursor mc = new MatrixCursor(new String[]{"k", "v"});
+        for (int i = 0; i < rows; i++)
+            mc.addRow(new Object[]{"k" + i, String.valueOf(i)});
+        return mc;
+    }
+
+    @Override public Uri insert(Uri uri, ContentValues values) {
+        insertCalls++;
+        rows++;
+        return Uri.parse("content://" + AUTH + "/row/" + rows);
+    }
+
+    @Override public int update(Uri uri, ContentValues values,
+                                String selection, String[] selArgs) {
+        updateCalls++;
+        return rows;
+    }
+
+    @Override public int delete(Uri uri, String selection,
+                                String[] selArgs) {
+        deleteCalls++;
+        int gone = rows;
+        rows = 0;
+        return gone;
+    }
+
+    @Override public String[] getStreamTypes(Uri uri, String mimeTypeFilter) {
+        streamTypesCalls++;
+        lastMimeFilter = mimeTypeFilter;
+        return new String[]{"vnd.android.cursor.dir/vnd.c7.w10.batch"};
+    }
+}
