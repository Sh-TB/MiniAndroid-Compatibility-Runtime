+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+
+/** CODER7 WAVE-11 — the receiver the URI-grant laws land on (N01/N02/N03).
+ *  AOSP: an intent delivered with FLAG_GRANT_READ_URI_PERMISSION grants
+ *  the TARGET package the covered modes; checkUriPermission consults the
+ *  grant table; a revoke kills the grant. The receiver is the only honest
+ *  vantage point: the check runs INSIDE the delivered component. */
+public class GrantRec extends BroadcastReceiver {
+    @Override public void onReceive(Context ctx, Intent intent) {
+        String act = intent.getAction();
+        Uri granted = Uri.parse("content://c7.w11.p/x");
+        Uri ungranted = Uri.parse("content://c7.w11.p/none");
+        int MODE_READ = 1; // Intent.FLAG_GRANT_READ_URI_PERMISSION
+        if ("c7.w11.GRANT".equals(act)) {
+            // N01: the granted uri — read mode MUST answer GRANTED(0).
+            int a1 = ctx.checkUriPermission(granted, 0, 0, MODE_READ);
+            if (a1 == 0) Rec.ok("N01", "granted uri check=GRANTED(0)");
+            else Rec.bad("N01", "granted uri check=" + a1);
