+    public static final List<String> live = new ArrayList<String>();
+    public static int lastUpdateValue = -1;
+    public static String lastUpdateSel = "unset";
+    public static int lastDeleteCount = -1;
+    public static String lastSelArg0 = "unset";
+    public static String lastLive = "[]";
+    public static String lastEqLit = "unset";
+    public static String lastArgClass = "unset";
+    public static String lastGet1 = "unset";
+    public static String trace = "";
+    public static int queryCalls = 0;
