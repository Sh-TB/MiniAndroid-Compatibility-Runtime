+// ═══════════════════════════════════════════════════════════════════════
+// S170-CONC (CODER 8, wave 3) — COMPLETABLEFUTURE COMPLETION + FIRING.
+// Was: a runAsync/supplyAsync task drained but the CF stayed PENDING
+// forever (no completion hook) and dependents never fired.
+// ═══════════════════════════════════════════════════════════════════════
+void DalvikExecutionEngine::fire_completable_future_completion(
+    uint32_t task_oid, bool threw, uint32_t exc_oid, bool has_result,
+    uint32_t result_oid, const std::string& result_desc) {
+    if (shadow_registry_ == nullptr) return;
+    auto* ex_cf = shadow_registry_->find_as<framework::ExecutorShadow>();
+    if (ex_cf == nullptr) return;
+    // S174-CONC (CODER 8, wave 5) — CF DEADLINE DRAIN HOOK (FIX 16):
+    // every drain boundary is also a deadline boundary — CFs whose
+    // orTimeout/completeOnTimeout deadline is due at the current virtual
+    // time complete here (TimeoutException vs fallback), and their
+    // staged dependents fire through the SAME shared law. A REAL
+    // completion first always wins (the shadow law is a no-op on
+    // settled records — the JDK postComplete guard).
+    if (auto* hs_dl = shadow_registry_->find_as<framework::HandlerShadow>()) {
+        auto fired_dl = ex_cf->cf_check_deadlines(hs_dl->virtual_now_ms());
+        for (uint32_t cf_dl : fired_dl) {
+            auto deps_dl = ex_cf->cf_take_fired(cf_dl);
+            if (!deps_dl.empty()) fire_cf_dependent_list(deps_dl, false, 0,
+                                                         false, 0, "", 0);
+        }
+    }
+    uint32_t cf = ex_cf->cf_for_task(task_oid);
+    if (cf == 0) return;  // not a CF task
+    auto deps = ex_cf->complete_cf(cf, threw, exc_oid, has_result,
+                                   result_oid, result_desc);
+    std::cerr << "[EXECUTOR][CF] task o" << task_oid << " completed CF o" << cf
+              << " → " << (threw ? "EXCEPTION" : "COMPLETED")
+              << ", dependents=" << deps.size() << std::endl;
+    // S173-CONC (wave 4): the SHARED firing law (kinds 0–5, deep chains).
+    fire_cf_dependent_list(deps, threw, exc_oid, has_result, result_oid,
+                           result_desc, 0);
+}
