+
+bool ExecutorShadow::ecs_take(uint32_t ecs_oid, uint32_t& out_future) {
+    auto it = ecs_states_.find(ecs_oid);
+    if (it == ecs_states_.end() || it->second.completion_order.empty())
+        return false;
+    out_future = it->second.completion_order.front();
+    it->second.completion_order.erase(it->second.completion_order.begin());
+    return true;
+}
+
+bool ExecutorShadow::ecs_peek_completed(uint32_t ecs_oid,
+                                        uint32_t& out_future) const {
+    auto it = ecs_states_.find(ecs_oid);
+    if (it == ecs_states_.end() || it->second.completion_order.empty())
+        return false;
+    out_future = it->second.completion_order.front();
+    return true;
+}
+
+uint32_t ExecutorShadow::ecs_executor_of(uint32_t ecs_oid) const {
+    auto it = ecs_states_.find(ecs_oid);
+    return it != ecs_states_.end() ? it->second.executor_oid : 0;
