+// TEST 59 — CompletableFuture.allOf composite law.
+static void test59_cf_allof(DalvikHeap& heap, ThreadShadow* ts,
+                            HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 59] CompletableFuture.allOf composite law\n";
+    uint32_t s1 = ex->create_completable_future();
+    uint32_t s2 = ex->create_completable_future();
+    uint32_t s3 = ex->create_completable_future();
+    uint32_t all = ex->create_cf_composite(true, {s1, s2, s3});
+    check(ex->is_cf(all), "composite CF is a real CF record");
+    check(ex->cf_record(all)->state == ExecutorShadow::kFuturePending,
+          "composite PENDING while sources pending");
+    ex->complete_cf(s1, false, 0, true, 0, "");
+    check(ex->cf_record(all)->state == ExecutorShadow::kFuturePending,
+          "1/3 done → still PENDING");
+    ex->complete_cf(s2, false, 0, false, 0, "");
+    check(ex->cf_record(all)->state == ExecutorShadow::kFuturePending,
+          "2/3 done → still PENDING");
+    ex->complete_cf(s3, false, 0, false, 0, "");
+    check(ex->cf_record(all)->state == ExecutorShadow::kFutureCompleted,
+          "3/3 done → composite COMPLETED (JDK allOf law)");
+    // Degenerate allOf(): no sources → already completed.
+    uint32_t empty_all = ex->create_cf_composite(true, {});
+    check(ex->cf_record(empty_all)->state == ExecutorShadow::kFutureCompleted,
+          "allOf() with NO sources → already completed");
+    // Exceptional source → composite completes exceptionally (first wins).
+    uint32_t s4 = ex->create_completable_future();
+    uint32_t s5 = ex->create_completable_future();
+    uint32_t all2 = ex->create_cf_composite(true, {s4, s5});
+    uint32_t exc = heap.allocate("Ljava/lang/IllegalStateException;", 0, 0);
+    ex->complete_cf(s4, true, exc, false, 0, "");
+    check(ex->cf_record(all2)->state == ExecutorShadow::kFutureException,
+          "exceptional source → composite EXCEPTIONAL");
+    ex->complete_cf(s5, false, 0, false, 0, "");
+    check(ex->cf_record(all2)->state == ExecutorShadow::kFutureException,
+          "late source cannot un-throw the composite (first-wins)");
+    ev(ts, hs, "TEST59 allOf composite");
+}
