+    check(tt.handled && tt.bool_val == false,
+          "tryTransfer with no waiting consumer → FALSE (JDK law)");
+    check(ls->xfer_size(q) == 3,
+          "the failed tryTransfer did NOT enqueue (JDK contract)");
+    // take: the PENDING TRANSFER wins over the FIFO storage.
+    CallResult t1 = call(ls, kLTQ, "take", true, q);
+    check(t1.handled && t1.object_id == e3,
+          "take consumes the pending TRANSFER first (consumer-first xfer)");
+    check(!ls->xfer_has_pending(q), "transfer slot consumed");
+    CallResult t2 = call(ls, kLTQ, "take", true, q);
+    check(t2.handled && t2.object_id == e1, "then the FIFO head (e1)");
+    CallResult t3 = call(ls, kLTQ, "poll", true, q);
+    check(t3.handled && t3.object_id == e2, "then e2 (FIFO order kept)");
+    check(ls->xfer_size(q) == 0, "queue drained");
+    CallResult npe = call(ls, kLTQ, "put", true, q, {null_arg()});
+    check(npe.is_exc && npe.exc_class == "Ljava/lang/NullPointerException;",
+          "put(null) → NPE");
+    ev(ts, hs, "TEST83 LTQ");
+}
