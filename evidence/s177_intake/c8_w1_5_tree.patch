+// TEST 70 — MessageQueue.next() real dequeue law (the MessageQueue
+// surface rides the LooperShadow — registry order falls through Handler).
+static void test70_mq_next(DalvikHeap& heap, ThreadShadow* ts,
+                           HandlerShadow* hs, LooperShadow* lop) {
+    std::cout << "\n[TEST 70] MessageQueue.next() dequeue law\n";
+    uint32_t mq = heap.allocate(kMQ, 0, 0);
+    uint32_t m1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t m2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t m3 = heap.allocate(kTaskCls, 0, 0);
+    // TEST 70 runs after TEST 46 quit the main looper (quit is forever —
+    // the post GATE would reject every post), so the queue is seeded via
+    // the enqueue_tokened PRIMITIVE the post law lands on; the next()
+    // DISPATCH arm is exercised through the LooperShadow surface.
+    hs->enqueue_tokened(m2, 0, kTaskCls, 0);
+    hs->enqueue_tokened(m1, 0, kTaskCls, 0);
+    hs->enqueue_tokened(m3, 400, kTaskCls, 0);
+    ev(ts, hs, "TEST70 queue: m2, m1 due now; m3 due +400ms");
+    CallResult n1 = call(lop, kMQ, "next", true, mq);
+    check(n1.handled && n1.object_id == m2,
+          "next() == m2 (earliest enqueue_seq among the due)");
+    CallResult n2 = call(lop, kMQ, "next", true, mq);
+    check(n2.handled && n2.object_id == m1, "next() == m1 second (FIFO)");
+    CallResult n3 = call(lop, kMQ, "next", true, mq);
+    check(n3.handled && n3.ret_kind == CallResult::RetKind::NULL_REF,
+          "next() with only a FUTURE message → null (park law, was: "
+          "unconditional null even with due messages)");
+    hs->advance_virtual(400);
+    CallResult n4 = call(lop, kMQ, "next", true, mq);
+    check(n4.handled && n4.object_id == m3,
+          "after the clock crosses the delay, next() == m3");
+    // Each SEEDED message dispatches EXACTLY ONCE: after m3, whatever is
+    // still due belongs to earlier waves' scheduling laws — none of ours
+    // may reappear, and the drain reaches null.
+    bool seeded_again = false, saw_null = false;
+    for (int i = 0; i < 64; ++i) {
+        CallResult r = call(lop, kMQ, "next", true, mq);
+        if (!r.handled) break;
+        if (r.ret_kind == CallResult::RetKind::NULL_REF) {
+            saw_null = true;
+            break;
+        }
+        if (r.object_id == m1 || r.object_id == m2 || r.object_id == m3)
+            seeded_again = true;
+    }
+    check(!seeded_again,
+          "each seeded message dispatched exactly once (no re-queue)");
+    check(saw_null, "the drain reaches null after the seeded set");
+    ev(ts, hs, "TEST70 MessageQueue.next");
+}
