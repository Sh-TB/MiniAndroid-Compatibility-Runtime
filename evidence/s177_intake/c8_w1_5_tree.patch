+// ── dispatch helper ────────────────────────────────────────────────────────
+static CallResult call(miniandroid::framework::Shadow* s,
+                       const std::string& cls,
+                       const std::string& method, bool has_recv,
+                       uint32_t recv,
+                       std::vector<CallContext::Arg> args = {}) {
+    CallContext ctx;
+    ctx.class_name = cls;
+    ctx.method = method;
+    ctx.has_receiver = has_recv;
+    ctx.receiver_id = recv;
+    ctx.receiver_class = cls;
+    ctx.args = std::move(args);
+    return s->dispatch(ctx);
+}
