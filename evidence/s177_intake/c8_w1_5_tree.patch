+// TEST 45 — CompletableFuture chaining + manual completion law.
+static void test45_cf_chaining(DalvikHeap& heap, ThreadShadow* ts,
+                               HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 45] CompletableFuture chaining law\n";
+    uint32_t src = heap.allocate(kCF, 0, 0);
+    call(ex, kCF, "<init>", true, src);
+    check(ex->cf_record(src) &&
+              ex->cf_record(src)->state == ExecutorShadow::kFuturePending,
+          "new CompletableFuture() → PENDING");
+    uint32_t fn = heap.allocate(kTaskCls, 0, 0);
+    CallResult dep = call(ex, kCF, "thenApply", true, src, {obj_arg(fn)});
+    check(dep.handled && dep.object_id != 0 && dep.object_id != src,
+          "thenApply on a PENDING source → a NEW dependent CF");
+    check(ex->cf_dependent_count(src) == 1,
+          "getNumberOfDependents == 1 (registered on the source)");
+    // Second complete must win; the dependent fires with it.
+    uint32_t v1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t v2 = heap.allocate(kTaskCls, 0, 0);
+    // complete() is the engine law; the shadow-surface completion primitive
+    // (complete_cf) is the same authority the engine law calls.
+    auto deps = ex->complete_cf(src, false, 0, true, v1, "Lapp/Task;");
+    check(deps.size() == 1 && deps[0].cf_oid == dep.object_id,
+          "completion returned the registered dependent for firing");
+    check(ex->cf_record(src)->result_oid == v1, "source result == v1");
+    auto deps2 = ex->complete_cf(src, false, 0, true, v2, "Lapp/Task;");
+    check(deps2.empty() && ex->cf_record(src)->result_oid == v1,
+          "SECOND complete is a no-op (JDK first-wins law)");
+    // The dependent completes (no REAL DEX fn body in this harness —
+    // the engine law runs the REAL apply(); the recorded state law is
+    // what is verified here).
+    ex->complete_cf(dep.object_id, false, 0, false, 0, "");
+    check(ex->cf_record(dep.object_id)->state ==
+              ExecutorShadow::kFutureCompleted,
+          "dependent fired → COMPLETED (JDK postComplete law)");
+    ev(ts, hs, "TEST45 cf chaining law");
+    // cancel: a PENDING CF cancels; a done CF refuses.
+    uint32_t c3 = heap.allocate(kCF, 0, 0);
+    call(ex, kCF, "<init>", true, c3);
+    check(ex->cancel_cf(c3), "cancel on PENDING → true");
+    check(ex->cf_record(c3)->state == ExecutorShadow::kFutureCancelled,
+          "state → CANCELLED");
+    check(!ex->cancel_cf(c3), "double cancel → false");
+}
