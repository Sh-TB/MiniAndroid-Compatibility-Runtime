+// TEST 01 — two+ thread creation & identity (tids, names, currentThread).
+static void test01_identity(DalvikHeap& heap, DalvikHeapAdapter& adapter,
+                            ThreadShadow* ts, HandlerShadow* hs) {
+    std::cout << "\n[TEST 01] two+ thread creation & identity\n";
+    uint32_t t2 = heap.allocate(kThread, 0, 0);
+    uint32_t t3 = heap.allocate(kThread, 0, 0);
+    uint32_t r2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t r3 = heap.allocate(kTaskCls, 0, 0);
+    call(ts, kThread, "<init>", true, t2, {obj_arg(r2), str_arg("worker-A")});
+    call(ts, kThread, "<init>", true, t3, {obj_arg(r3), str_arg("worker-B")});
+    ev(ts, hs, "TEST01 identity A=Thread-2 B=Thread-3");
+
+    CallResult id_a = call(ts, kThread, "getId", true, t2);
+    check(id_a.handled && id_a.long_val == 2, "tid(A) == 2 (monotonic, main=1)");
+    CallResult name_a = call(ts, kThread, "getName", true, t2);
+    check(name_a.handled && name_a.string_val == "worker-A",
+          "getName(A) == ctor name");
+    CallResult name_def = call(ts, kThread, "getName", true, t3);
+    // ctor name set → worker-B
+    check(name_def.handled && name_def.string_val == "worker-B",
+          "getName(B) == worker-B");
+    uint32_t main = ts->main_thread_id();
+    check(ts->thread_tid(main) == 1, "main tid == 1");
+    check(ts->thread_name(main) == "main", "main name == main");
+    check(ts->thread_tid(t2) != ts->thread_tid(t3), "tids distinct");
+
+    // F-110d drained-body identity: inside a drained body, currentThread()
+    // returns THAT thread's object; outside, the main singleton.
+    {
+        IdentityGuard g(ts, t2);
+        CallResult cur = call(ts, kThread, "currentThread", false, 0);
+        check(cur.handled && cur.object_id == t2,
+              "currentThread inside body A == A (drained identity)");
+        ev(ts, hs, "TEST01 drained-body identity currentThread==A");
+    }
+    CallResult cur_main = call(ts, kThread, "currentThread", false, 0);
+    check(cur_main.handled && cur_main.object_id == main,
+          "currentThread outside == main singleton");
+}
