+    auto fire1 = ex->complete_cf(src, false, 0, true, 0, "");
+    check(fire1.size() == 1 && fire1[0].cf_oid == dep1,
+          "src completion returns dep1 for firing");
+    auto fire2 = ex->complete_cf(dep1, false, 0, true, 0, "");
+    check(fire2.size() == 1 && fire2[0].cf_oid == dep2,
+          "dep1 completion returns dep2 for firing (chain reaches depth 2)");
+    auto fire3 = ex->complete_cf(dep2, false, 0, false, 0, "");
+    check(fire3.empty(), "leaf completion has no further dependents");
+    ev(ts, hs, "TEST62 deep chain");
