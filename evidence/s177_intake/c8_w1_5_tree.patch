+// TEST 90 — ScheduledFuture surface (FIX 19): getDelay answers the
+// REMAINING time in the GIVEN unit; isPeriodic distinguishes one-shot vs
+// periodic.
+static void test90_scheduled_future(DalvikHeap& heap, ThreadShadow* ts,
+                                    HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 90] ScheduledFuture getDelay/isPeriodic\n";
+    uint32_t tpe = heap.allocate(kSTPE, 0, 0);
+    call(ex, kSTPE, "<init>", true, tpe, {int_arg(1)});
+    uint32_t t1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t t2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t ms_unit = heap.allocate("Ljava/util/concurrent/TimeUnit;", 0, 0);
+    heap.set_object_field(ms_unit, "ordinal", dalvik::DalvikValue::make_int(2));
+    CallResult f1 = call(ex, kSTPE, "schedule", true, tpe,
+                         {obj_arg(t1), long_arg(500), obj_arg(ms_unit)});
+    check(f1.handled && f1.object_id != 0, "schedule(500ms) → a real future");
+    check(call(ex, kFTask, "isPeriodic", true, f1.object_id).bool_val == false,
+          "one-shot schedule → isPeriodic FALSE");
+    CallResult gd = call(ex, kFTask, "getDelay", true, f1.object_id);
+    check(gd.handled && gd.long_val == 500,
+          "getDelay (MILLISECONDS default) == 500 remaining");
+    CallResult gdn = call(ex, kFTask, "getDelay", true, f1.object_id);
+    check(gdn.handled, "getDelay answers a REAL long");
+    hs->advance_virtual(200);
+    CallResult gd2 = call(ex, kFTask, "getDelay", true, f1.object_id);
+    check(gd2.handled && gd2.long_val == 300,
+          "getDelay tracks the virtual clock (500-200 == 300)");
+    CallResult f2 = call(ex, kSTPE, "scheduleAtFixedRate", true, tpe,
+                         {obj_arg(t2), long_arg(100), long_arg(50),
+                          obj_arg(ms_unit)});
+    check(f2.handled && f2.object_id != 0, "scheduleAtFixedRate → future");
+    check(call(ex, kFTask, "isPeriodic", true, f2.object_id).bool_val,
+          "fixed-rate schedule → isPeriodic TRUE");
+    ev(ts, hs, "TEST90 ScheduledFuture");
+}
