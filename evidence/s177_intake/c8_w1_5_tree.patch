+// TEST 66 — ReentrantLock tryLock(t,u) + lockInterruptibly primitives.
+static void test66_timed_lock(DalvikHeap& heap, ThreadShadow* ts,
+                              HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 66] ReentrantLock timed/interruptible primitives\n";
+    uint32_t lock = heap.allocate(kRLock, 0, 0);
+    call(ls, kRLock, "<init>", true, lock);
+    uint32_t a = heap.allocate(kThread, 0, 0);
+    uint32_t b = heap.allocate(kThread, 0, 0);
+    IdentityGuard ga(ts, a);
+    check(ls->reentrant_acquire(lock, a), "A acquires");
+    IdentityGuard gb(ts, b);
+    // B's timed tryLock parks with a DEADLINE (the engine law's wake stamp
+    // = now + timeout; verified via the wait-set record).
+    int64_t now = hs->virtual_now_ms();
+    ts->register_wait(b, lock, now + 500);
+    check(ts->next_wake_for(b) == now + 500,
+          "tryLock(500ms) parks with a DEADLINE wake (was: ignored)");
+    check(ts->thread_state(b) == ThreadShadow::ThreadState::TIMED_WAITING,
+          "timed tryLock waiter → TIMED_WAITING");
+    // The owner releases → ONE contender wakes (the unlock law).
+    {
+        IdentityGuard ga2(ts, a);
+        bool threw = false;
+        ls->reentrant_release(lock, a, &threw);
+        check(!threw, "owner release clean");
+    }
+    bool intr = false, notif = false;
+    check(ts->consume_wait_resume_result(b, lock, &intr, &notif) && notif,
+          "deadline wake delivered (notified → the re-entry race arm)");
+    // lockInterruptibly flag-consumption primitive: a pre-set interrupt
+    // aborts BEFORE the acquisition (the engine law throws at re-entry).
+    ts->set_interrupted(b);
+    check(ts->consume_interrupted(b), "lockInterruptibly consumes the flag");
+    check(!ts->consume_interrupted(b), "flag consumed exactly once");
+    ev(ts, hs, "TEST66 timed lock primitives");
