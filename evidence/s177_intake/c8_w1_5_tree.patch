+// TEST 84 — DelayQueue (FIX 13): the due-time ledger — peek answers the
+// head REGARDLESS of expiry; poll/take answer only EXPIRED heads; order is
+// (due, insertion).
+static void test84_delay_queue(DalvikHeap& heap, ThreadShadow* ts,
+                               HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 84] DelayQueue law\n";
+    uint32_t q = heap.allocate(kDQ, 0, 0);
+    call(ls, kDQ, "<init>", true, q);
+    uint32_t e1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e3 = heap.allocate(kTaskCls, 0, 0);
+    int64_t dq_now = hs->virtual_now_ms();
+    // Seeds: the app-shaped __dq_due__ field (relative delay in ms).
+    heap.set_object_field(e1, "__dq_due__",
+                          dalvik::DalvikValue::make_long(100));
+    heap.set_object_field(e2, "__dq_due__",
+                          dalvik::DalvikValue::make_long(50));
+    heap.set_object_field(e3, "__dq_due__",
+                          dalvik::DalvikValue::make_long(0));
+    check(call(ls, kDQ, "offer", true, q, {obj_arg(e1)}).bool_val,
+          "offer(e1, due+100)");
+    check(call(ls, kDQ, "offer", true, q, {obj_arg(e2)}).bool_val,
+          "offer(e2, due+50)");
+    check(call(ls, kDQ, "put", true, q, {obj_arg(e3)}).handled,
+          "put(e3, due now)");
+    check(ls->dq_size(q) == 3, "three elements");
+    int64_t due = 0;
+    uint32_t head = 0;
+    std::string hdesc;
+    check(ls->dq_peek(q, head, hdesc, due) && head == e3 && due == dq_now,
+          "peek == e3 (earliest deadline; due = the offer-time clock)");
+    // poll BEFORE expiry: only e3 is due.
+    CallResult p1 = call(ls, kDQ, "poll", true, q);
+    check(p1.handled && p1.object_id == e3, "poll returns the EXPIRED head");
+    CallResult p2 = call(ls, kDQ, "poll", true, q);
+    check(p2.handled && p2.ret_kind == CallResult::RetKind::NULL_REF,
+          "poll with an UNEXPIRED head → null (JDK law — never blocks)");
+    check(ls->dq_size(q) == 2, "unexpired elements stay queued");
+    hs->advance_virtual(50);  // e2's deadline
+    CallResult p3 = call(ls, kDQ, "poll", true, q);
+    check(p3.handled && p3.object_id == e2,
+          "after the virtual advance the due head is takeable");
+    hs->advance_virtual(50);  // e1's deadline
+    CallResult p4 = call(ls, kDQ, "take", true, q);
+    check(p4.handled && p4.object_id == e1,
+          "take answers once the LAST head expires");
+    check(ls->dq_size(q) == 0, "drained in (due, seq) order");
+    ev(ts, hs, "TEST84 DelayQueue");
+}
