+    check(ad.handled && ad.object_id != 0 &&
+              ad.object_class == "Ljava/util/concurrent/Executors$RunnableAdapter;",
+          "callable(R) → REAL adapter object (was: unimplemented path)");
+    check(ex->callable_adapter(ad.object_id) != nullptr &&
+              ex->callable_adapter(ad.object_id)->runnable_oid == run,
+          "adapter records the wrapped runnable");
+    uint32_t res = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    CallResult ad2 = call(ex, kExecutors, "callable", false, 0,
+                          {obj_arg(run), obj_arg(res)});
