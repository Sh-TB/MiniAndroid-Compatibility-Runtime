+// TEST 06 — Thread.join drive primitives (drive-to-termination law).
+static void test06_join(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs) {
+    std::cout << "\n[TEST 06] Thread.join drive primitives\n";
+    uint32_t t4 = heap.allocate(kThread, 0, 0);
