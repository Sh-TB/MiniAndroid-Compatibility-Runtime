+    call(ts, kThread, "start", true, t4);
+    check(ts->is_thread_alive(t4), "started thread alive");
+    check(ts->has_pending_start_for(t4), "pending start recorded");
+    // The joinee body parks 50 virtual ms (the F-110b park law the join
+    // law drives): wake = 50.
+    ts->mark_thread_yielded(t4, r4, 50);
+    check(ts->next_wake_for(t4) == 50, "join sees parked wake at 50");
+    // The join law: advance the clock to the wake, re-drain, terminate.
+    uint32_t yr = 0;
+    check(ts->take_due_yielded_for(t4, 50, yr), "drive re-drained the body");
+    ts->mark_thread_terminated(t4);
+    check(!ts->is_thread_alive(t4) && !ts->has_pending_start_for(t4),
