+    std::cout << "checks: " << g_checks << "  failed: " << g_fails << "\n";
+    std::cout << (g_fails == 0 ? "=== ALL GREEN ===" : "=== FAILURES PRESENT ===")
+              << "\n";
+    return g_fails == 0 ? 0 : 1;
+}
