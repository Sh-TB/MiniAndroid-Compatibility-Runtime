+static void test62_cf_deep_chain(DalvikHeap& heap, ThreadShadow* ts,
+                                 HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 62] CF deep chain (dependent of dependent)\n";
+    uint32_t src = ex->create_completable_future();
+    // Register dependent dep1 on src (PENDING), then dep2 on dep1 (PENDING).
+    CallResult c1 = call(ex, kCF, "thenApply", true, src, {null_arg()});
+    uint32_t dep1 = c1.object_id;
+    CallResult c2 = call(ex, kCF, "thenApply", true, dep1, {null_arg()});
+    uint32_t dep2 = c2.object_id;
