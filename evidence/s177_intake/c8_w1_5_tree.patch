+// TEST 82 — ExecutorCompletionService (FIX 11): the completion ledger is
+// fed by complete_task (the ONE completion authority) in COMPLETION order;
+// take() drains LEAST-COMPLETED-FIRST — not submission order (the JDK
+// QueueingFuture law); poll on an empty ledger answers null.
+static void test82_ecs(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs,
+                       ExecutorShadow* ex) {
+    std::cout << "\n[TEST 82] ExecutorCompletionService completion order\n";
+    uint32_t ecs = heap.allocate(kECS, 0, 0);
+    call(ex, kECS, "<init>", true, ecs, {obj_arg(0)});
+    uint32_t t1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t t2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t t3 = heap.allocate(kTaskCls, 0, 0);
+    CallResult f1 = call(ex, kECS, "submit", true, ecs, {obj_arg(t1)});
+    CallResult f2 = call(ex, kECS, "submit", true, ecs, {obj_arg(t2)});
+    CallResult f3 = call(ex, kECS, "submit", true, ecs, {obj_arg(t3)});
+    check(f1.handled && f1.object_id != 0 && f2.object_id != 0 &&
+              f3.object_id != 0,
+          "three submits → three real FutureTask objects");
+    check(ex->ecs_pending(ecs) == 0,
+          "nothing COMPLETED yet (submission ≠ completion)");
+    CallResult poll_empty = call(ex, kECS, "poll", true, ecs);
+    check(poll_empty.handled && poll_empty.ret_kind ==
+              CallResult::RetKind::NULL_REF,
+          "poll with no completion → null (JDK law)");
+    // Complete in REVERSE submission order — the drain order must follow
+    // COMPLETIONS, not submissions.
+    ex->complete_task(t3, false, 0, false, 0, "");
+    ex->complete_task(t1, false, 0, false, 0, "");
+    ex->complete_task(t2, false, 0, false, 0, "");
+    check(ex->ecs_pending(ecs) == 3, "three completions queued");
+    CallResult k1 = call(ex, kECS, "take", true, ecs);
+    check(k1.object_id == f3.object_id,
+          "take 1 == the FIRST COMPLETED future (t3, submitted LAST)");
+    CallResult k2 = call(ex, kECS, "take", true, ecs);
+    check(k2.object_id == f1.object_id, "take 2 == second completed (t1)");
+    CallResult k3 = call(ex, kECS, "take", true, ecs);
+    check(k3.object_id == f2.object_id, "take 3 == last completed (t2)");
+    check(ex->ecs_pending(ecs) == 0, "ledger drained exactly");
+    ev(ts, hs, "TEST82 ECS completion order");
+}
