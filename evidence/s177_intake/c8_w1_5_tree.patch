+// ═══════════════════════════════════════════════════════════════════════
+// S173-CONC (CODER 8, wave 4) — SHARED CF dependent-firing law.
+// Kind routing (OpenJDK CompletableFuture.postComplete / the UniCompletion
+// family):
+//   0 thenApply(fn)    : fn(result) → dependent completes with fn's return
+//   1 thenAccept(fn)   : fn(result) → dependent completes null-result
+//   2 thenRun(fn)      : fn()      → dependent completes null-result
+//   3 exceptionally(fn): COMPLETED source passes through; EXCEPTIONAL
+//                        source invokes fn(exc) — fn's return (or, when no
+//                        fn body ran, null) becomes the dependent outcome
+//   4 handle(fn)       : BOTH paths invoke fn(result, exc) — fn's return
+//                        completes the dependent (BiFunction)
+//   5 whenComplete(fn) : BOTH paths invoke fn(result, exc) — the dependent
+//                        MIRRORS the source outcome regardless of fn
+//                        (BiConsumer; the source result/exception passes
+//                        through — the JDK postComplete relay law)
+// Sub-dependents fire recursively with a depth cap (compose/allOf deep
+// chains run to quiescence; a cycle cannot hang the serialized engine).
+// ═══════════════════════════════════════════════════════════════════════
+void DalvikExecutionEngine::fire_cf_dependent_list(
+    const std::vector<framework::ExecutorShadow::CompletableFutureRecord::
+                       Dependent>& deps,
+    bool src_threw, uint32_t src_exc, bool src_has_result, uint32_t src_result,
+    const std::string& src_desc, int depth) {
+    if (shadow_registry_ == nullptr) return;
+    auto* ex_cf = shadow_registry_->find_as<framework::ExecutorShadow>();
+    if (ex_cf == nullptr) return;
+    if (depth > 12) {
+        std::cerr << "[EXECUTOR][CF][BOUNDARY] dependent chain deeper than "
+                  << "12 — remaining dependents fire at the next "
+                  << "completion boundary" << std::endl;
+        return;
+    }
+    for (const auto& d : deps) {
+        if (d.cf_oid == 0) continue;
+        bool dep_threw = false;
+        uint32_t dep_exc = 0;
+        bool dep_has_result = false;
+        uint32_t dep_result = 0;
+        std::string dep_desc;
+        if (d.kind == 3) {
+            // exceptionally(fn): a SUCCESSFUL source passes through.
+            if (src_threw) {
+                dep_exc = src_exc;
+            } else {
+                dep_has_result = src_has_result;
+                dep_result = src_result;
+                dep_desc = src_desc;
+            }
+        } else if (d.kind == 5) {
+            // whenComplete(fn): the source outcome RELAYS to the
+            // dependent (fn runs but cannot replace the outcome).
+            dep_threw = src_threw;
+            dep_exc = src_exc;
+            dep_has_result = src_has_result;
+            dep_result = src_result;
+            dep_desc = src_desc;
+        } else if (d.kind == 6) {
+            // S174-CONC (wave 5): MIRROR (copy()/minimalCompletionStage
+            // dependents — no fn; the source outcome passes through, the
+            // OpenJDK CopyCompletion/MinimalCompletionStage relay law).
+            dep_threw = src_threw;
+            dep_exc = src_exc;
+            dep_has_result = src_has_result;
+            dep_result = src_result;
+            dep_desc = src_desc;
+        } else if (d.kind == 2) {
+            // thenRun: source outcome propagates as exception only.
+            if (src_threw) dep_exc = src_exc;
+        } else if (d.kind == 1) {
+            // thenAccept: source result is consumed; the dependent itself
+            // completes with null result.
+            if (src_threw) dep_exc = src_exc;
