+// TEST 83 — LinkedTransferQueue (FIX 12): FIFO storage; transfer arms the
+// rendezvous slot (producer parks); tryTransfer is immediate-false with no
+// waiting consumer; take consumes a PENDING TRANSFER before the FIFO.
+static void test83_ltq(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs,
+                       LocksShadow* ls) {
+    std::cout << "\n[TEST 83] LinkedTransferQueue law\n";
+    uint32_t q = heap.allocate(kLTQ, 0, 0);
+    call(ls, kLTQ, "<init>", true, q);
+    uint32_t e1 = heap.allocate(kTaskCls, 0, 0);
