+// Bound the drained-body identity for the duration of a scope (the F-110d
+// currentThread law — the engine does this around every drained body).
+struct IdentityGuard {
+    ThreadShadow* ts;
+    uint32_t saved = 0;
+    bool bound = false;
+    IdentityGuard(ThreadShadow* t, uint32_t oid) : ts(t) {
+        if (ts && oid != 0 && ts->current_thread_id() != oid) {
+            saved = ts->current_thread_id();
+            ts->set_active_drained_thread(oid);
+            bound = true;
+        }
+    }
+    ~IdentityGuard() {
+        if (bound) ts->set_active_drained_thread(saved);
+    }
+};
