+              ex->cf_record(dep2)->state == ExecutorShadow::kFuturePending,
+          "both chain stages PENDING");
+    // Completing src returns dep1 for firing; completing dep1 (with the
+    // outcome the engine law computed) returns dep2 — the chain runs to
+    // quiescence through the SAME law (the engine drives it recursively;
