+    uint32_t pkey = LocksShadow::put_wait_key(dq);
+    check(pkey != dq, "put-wait key is DISTINCT from the deque monitor");
+    check(ts->waiters_on(pkey) == 0, "no put-waiters before the park");
+    ts->register_wait(self, pkey, INT64_MAX);
+    check(ts->waiters_on(pkey) == 1, "put-park registered on the role key");
