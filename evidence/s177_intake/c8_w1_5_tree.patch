+// TEST 33 — CountDownLatch core law (ctor/getCount/countDown/release-all).
+static void test33_latch(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs,
+                         LocksShadow* ls) {
+    std::cout << "\n[TEST 33] CountDownLatch core law\n";
+    uint32_t latch = heap.allocate(kLatch, 0, 0);
+    CallResult ctor = call(ls, kLatch, "<init>", true, latch, {long_arg(2)});
+    check(ctor.handled, "ctor(2) accepted");
+    CallResult neg = call(ls, kLatch, "<init>", true, heap.allocate(kLatch, 0, 0),
+                          {long_arg(-1)});
+    check(neg.handled && neg.is_exc &&
+              neg.exc_class == "Ljava/lang/IllegalArgumentException;",
+          "ctor(-1) → IllegalArgumentException (JDK law)");
+    CallResult cnt = call(ls, kLatch, "getCount", true, latch);
+    check(cnt.handled && cnt.long_val == 2, "getCount == 2");
+    // Two waiters parked on the latch (per-monitor wait set).
+    uint32_t w1 = heap.allocate(kThread, 0, 0);
+    uint32_t w2 = heap.allocate(kThread, 0, 0);
+    ts->register_wait(w1, latch, INT64_MAX);
+    ts->register_wait(w2, latch, INT64_MAX);
+    ev(ts, hs, "TEST33 two latch waiters parked");
+    check(ts->waiters_on(latch) == 2, "2 waiters registered on the latch");
+    call(ls, kLatch, "countDown", true, latch);
+    check(ts->waiters_on(latch) == 2, "count 2→1 releases NO waiter");
+    call(ls, kLatch, "countDown", true, latch);
+    check(ts->waiters_on(latch) == 2,
+          "count reaches ZERO: BOTH waiters released (notify_all law)");
+    bool intr33 = false, not33 = false;
+    check(ts->consume_wait_resume_result(w1, latch, &intr33, &not33) &&
+              not33,
+          "waiter 1 consumes its release at the await site (notified=true)");
+    check(ts->consume_wait_resume_result(w2, latch, &intr33, &not33) &&
+              not33,
+          "waiter 2 consumes its release too (all released at zero)");
+    cnt = call(ls, kLatch, "getCount", true, latch);
+    check(cnt.handled && cnt.long_val == 0, "getCount == 0 after 2 countDowns");
+    check(call(ls, kLatch, "await", true, latch).handled,
+          "await on count==0 returns immediately (open latch)");
+}
