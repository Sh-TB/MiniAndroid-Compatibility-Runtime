+// TEST 86 — CF obtrudeValue/obtrudeException (FIX 15): the ONLY methods
+// allowed to rewrite a COMPLETED future; pending dependents observe the
+// new outcome.
+static void test86_cf_obtrude(DalvikHeap& heap, ThreadShadow* ts,
+                              HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 86] CF obtrude law\n";
+    // (a) obtrude on a PENDING CF completes it.
+    uint32_t cf1 = ex->create_completable_future();
+    uint32_t v1 = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    auto deps1 = ex->obtrude_cf(cf1, false, 0, true, v1, "Ljava/lang/Integer;");
+    check(ex->cf_record(cf1)->state == ExecutorShadow::kFutureCompleted,
+          "obtrudeValue on PENDING → COMPLETED");
+    check(ex->cf_record(cf1)->result_oid == v1, "result carried");
+    check(deps1.empty(), "no dependents yet");
+    // (b) obtrude on a COMPLETED CF REWRITES the outcome (the JDK-unique
+    // power).
+    uint32_t cf2 = ex->create_completable_future();
+    uint32_t old_v = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    ex->complete_cf(cf2, false, 0, true, old_v, "Ljava/lang/Integer;");
+    uint32_t new_v = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    auto deps2 = ex->obtrude_cf(cf2, false, 0, true, new_v,
+                                "Ljava/lang/Integer;");
+    check(ex->cf_record(cf2)->result_oid == new_v,
+          "obtrude REWROTE the completed outcome (JDK obtrudeValue law)");
+    check(deps2.empty(),
+          "no dependents were registered — nothing to fire");
+    // (b2) a dependent registered on a PENDING source fires with the
+    // obtruded outcome (the still-linked set observes the rewrite).
+    uint32_t cf4 = ex->create_completable_future();
+    CallResult dep4 = call(ex, kCF, "thenApply", true, cf4, {null_arg()});
+    uint32_t dep4_oid = dep4.object_id;
+    check(dep4.handled && dep4_oid != 0 &&
+              ex->cf_record(dep4_oid)->state ==
+                  ExecutorShadow::kFuturePending,
+          "dependent registered on the PENDING source (unfired)");
+    uint32_t v4 = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    auto deps4 = ex->obtrude_cf(cf4, false, 0, true, v4,
+                                "Ljava/lang/Integer;");
+    check(deps4.size() == 1 && deps4[0].cf_oid == dep4_oid,
+          "the still-pending dependent fires with the obtruded outcome");
+    check(ex->cf_record(cf4)->result_oid == v4, "obtruded value recorded");
+    // (c) obtrudeException flips to EXCEPTION.
+    uint32_t cf3 = ex->create_completable_future();
+    uint32_t exc = heap.allocate("Ljava/lang/IllegalStateException;", 0, 0);
+    ex->obtrude_cf(cf3, true, exc, false, 0, "");
+    check(ex->cf_record(cf3)->state == ExecutorShadow::kFutureException,
+          "obtrudeException → EXCEPTION state");
+    check(ex->cf_record(cf3)->exc_oid == exc, "cause recorded");
+    ev(ts, hs, "TEST86 obtrude");
+}
