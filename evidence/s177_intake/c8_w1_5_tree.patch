+// TEST 17 — sendMessage binds target + when, enqueues, token removal.
+static void test17_send(DalvikHeap& heap, ThreadShadow* ts,
+                        HandlerShadow* hs) {
+    std::cout << "\n[TEST 17] sendMessage → real enqueue + target/when law\n";
