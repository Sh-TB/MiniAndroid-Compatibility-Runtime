+              ex->callable_adapter(ad2.object_id)->has_result &&
+              ex->callable_adapter(ad2.object_id)->result_oid == res,
+          "callable(R, result) records the result payload");
+    CallResult npe = call(ex, kExecutors, "callable", false, 0, {null_arg()});
+    check(npe.handled && npe.is_exc &&
+              npe.exc_class == "Ljava/lang/NullPointerException;",
+          "callable(null) → NullPointerException (JDK law)");
+    // FutureTask direct lifecycle: <init>(Callable) registers; the state
+    // guard is the run() law's no-op arm (engine law composes it).
