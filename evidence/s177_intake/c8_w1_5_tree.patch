+              ex->future_record(ft)->state == ExecutorShadow::kFuturePending,
+          "direct FutureTask.<init> → PENDING record");
+    ex->complete_task(run, false, 0, true, 0, "");
+    check(ex->future_record(ft) != nullptr &&
+              ex->future_record(ft)->state == ExecutorShadow::kFutureCompleted,
+          "drain hook flipped the direct FutureTask → COMPLETED");
+    ev(ts, hs, "TEST64 callable adapter + direct FutureTask");
