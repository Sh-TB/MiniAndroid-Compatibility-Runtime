+    uint32_t ph = heap.allocate(kPhaser, 0, 0);
+    CallResult neg = call(ls, kPhaser, "<init>", true,
+                          heap.allocate(kPhaser, 0, 0), {long_arg(-1)});
+    check(neg.handled && neg.is_exc, "ctor(-1) → IllegalArgumentException");
+    call(ls, kPhaser, "<init>", true, ph, {long_arg(2)});
+    check(call(ls, kPhaser, "getPhase", true, ph).long_val == 0,
+          "initial phase == 0");
+    check(call(ls, kPhaser, "getRegisteredParties", true, ph).long_val == 2,
+          "getRegisteredParties == 2");
+    check(call(ls, kPhaser, "getArrivedParties", true, ph).long_val == 0,
+          "getArrivedParties == 0");
+    CallResult a1 = call(ls, kPhaser, "arrive", true, ph);
+    check(a1.handled && a1.long_val == 0, "first arrive returns phase 0");
+    check(call(ls, kPhaser, "getArrivedParties", true, ph).long_val == 1,
+          "1 arrival registered");
+    CallResult a2 = call(ls, kPhaser, "arrive", true, ph);
+    check(a2.handled && a2.long_val == 0,
+          "advancing arrival returns the PREVIOUS phase (JDK arrive law)");
+    check(call(ls, kPhaser, "getPhase", true, ph).long_val == 1,
+          "phase advanced 0 → 1");
+    check(call(ls, kPhaser, "getArrivedParties", true, ph).long_val == 0,
+          "new generation: arrivals reset");
+    call(ls, kPhaser, "arriveAndDeregister", true, ph);
+    check(call(ls, kPhaser, "getRegisteredParties", true, ph).long_val == 1,
+          "arriveAndDeregister removed one party");
+    call(ls, kPhaser, "arriveAndDeregister", true, ph);
+    check(call(ls, kPhaser, "isTerminated", true, ph).bool_val,
+          "empty phaser terminates at the advance (default onAdvance law)");
+    ev(ts, hs, "TEST53 phaser ledger");
