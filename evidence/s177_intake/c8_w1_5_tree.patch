+// TEST 73 — LinkedBlockingDeque TAKE-side park primitives (engine-law
+// substrate): an empty deque parks the taker on the deque monitor
+// (WAITING), a put's notify releases it, the re-entry consume reports the
+// wake, and an interrupt flips the SAME record into the interrupt shape.
+static void test73_lbd_take_park(DalvikHeap& heap, ThreadShadow* ts,
+                                 HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 73] LinkedBlockingDeque take-park primitives\n";
+    uint32_t dq = heap.allocate(kLBD, 0, 0);
+    call(ls, kLBD, "<init>", true, dq, {long_arg(2)});
+    uint32_t self = ts->current_thread_id();
+    check(ls->queue_size(dq) == 0, "deque EMPTY (park precondition)");
+    check(ts->waiters_on(dq) == 0, "no waiters before the park");
+    // The engine law parks exactly like this: register on the deque oid.
+    ts->register_wait(self, dq, INT64_MAX);
+    check(ts->waiters_on(dq) == 1, "take-park registered on the deque monitor");
+    CallResult st = call(ts, kThread, "getState", true, self);
+    check(st.handled && st.string_val == "WAITING",
+          "unbounded take-park state == WAITING (JDK getState law)");
+    // A put/offer wakes the taker (the shadow enqueue notifies the deque).
+    uint32_t e1 = heap.allocate(kTaskCls, 0, 0);
+    call(ls, kLBD, "putLast", true, dq, {obj_arg(e1)});
+    check(ts->waiters_on(dq) == 1, "waiter still registered until consume");
+    bool was_intr = false, was_notified = false;
+    check(ts->consume_wait_resume_result(self, dq, &was_intr, &was_notified) &&
+              was_notified && !was_intr,
+          "re-entry consume: notified by the put, not interrupted");
+    CallResult t1 = call(ls, kLBD, "takeFirst", true, dq);
+    check(t1.handled && t1.object_id == e1, "woken take consumes the element");
+    // Interrupt while parked → the interrupt shape (FIX 03 law).
+    ts->register_wait(self, dq, INT64_MAX);
+    call(ts, kThread, "interrupt", true, self);
+    bool intr2 = false, notified2 = false;
+    check(ts->consume_wait_resume_result(self, dq, &intr2, &notified2) &&
+              intr2 && !notified2,
+          "interrupted take-park surfaces the interrupt at re-entry");
+    // The engine's IME throw at the take site consumes the thread's
+    // interrupt flag (the JDK exception law) — mirrored here.
+    check(ts->consume_interrupted(self),
+          "the IME throw consumed the interrupt flag (consume-once law)");
+    ev(ts, hs, "TEST73 deque take-park");
+}
