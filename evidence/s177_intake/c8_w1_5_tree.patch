+static void test09_executor(DalvikHeap& heap, ThreadShadow* ts,
+                            HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 09] Executor task execution (submit → COMPLETED)\n";
+    CallResult pool = call(ex, kExecutors, "newFixedThreadPool", false, 0,
+                           {int_arg(2)});
+    check(pool.handled && pool.object_id != 0, "factory returned an executor");
+    uint32_t exec = pool.object_id;
+    uint32_t task = heap.allocate(kTaskCls, 0, 0);
+    CallResult fut = call(ex, kTPE, "submit", true, exec, {obj_arg(task)});
+    check(fut.handled && fut.object_id != 0,
+          "submit returned a REAL FutureTask (was a loud stub)");
+    check(ex->is_future(fut.object_id), "future registered");
+    const auto* rec = ex->future_record(fut.object_id);
+    check(rec && rec->state == ExecutorShadow::kFuturePending,
+          "future PENDING after submit");
+    check(hs->queue_size() == 1, "task rides the ONE MessageQueue");
+    ev(ts, hs, "TEST09 submit → queue");
+    // Drain hook: the engine runs the body, then complete_task flips.
+    std::vector<uint32_t> drained;
+    hs->drain_ready(&drained);
