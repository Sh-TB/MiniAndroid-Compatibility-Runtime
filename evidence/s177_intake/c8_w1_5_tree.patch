+          "put(e1) enqueues");
+    check(call(ls, kLTQ, "offer", true, q, {obj_arg(e2)}).bool_val,
+          "offer(e2) true (unbounded)");
+    check(ls->xfer_size(q) == 2, "size 2 (FIFO storage)");
+    // transfer with NO waiting consumer → pending slot (producer parks).
+    call(ls, kLTQ, "transfer", true, q, {obj_arg(e3)});
+    check(ls->xfer_has_pending(q), "transfer armed the rendezvous slot");
+    check(ls->xfer_size(q) == 3, "size counts the pending transfer");
