+    call(ls, kABQ, "put", true, q, {obj_arg(e1)});
+    check(call(ls, kABQ, "remainingCapacity", true, q).long_val == 0,
+          "capacity 1, one element → remainingCapacity 0");
+    CallResult off = call(ls, kABQ, "offer", true, q, {obj_arg(e2)});
+    check(off.handled && off.bool_val == false,
+          "offer on FULL → false (immediate form)");
+    // put on FULL parks the producer on the PUT-side wait key.
