+    CallResult tgt = call(hs, kMessage, "getTarget", true, m);
+    check(tgt.handled && tgt.object_id == h,
+          "getTarget() == the sending handler (AOSP enqueueMessage law)");
+    CallResult when = call(hs, kMessage, "getWhen", true, m);
+    check(when.handled && when.long_val == hs->virtual_now_ms(),
+          "msg.when stamped with the virtual send time");
+    check(hs->queue_size() == 1, "message queued for dispatch");
+    CallResult hm = call(hs, kHandler, "hasMessages", true, h, {int_arg(5)});
+    check(hm.handled && hm.bool_val, "hasMessages(5) sees the sent message");
+    // null-message law: AOSP throws NPE.
+    CallResult npe = call(hs, kHandler, "sendMessage", true, h, {null_arg()});
+    check(npe.handled && npe.is_exc &&
+              npe.exc_class == "Ljava/lang/NullPointerException;",
+          "sendMessage(null) → NullPointerException (was fake-true)");
+    // token removal by msg.obj identity (removeCallbacksAndMessages(obj)).
+    uint32_t obj = heap.allocate("Ljava/lang/Long;", 0, 0);
+    CallResult msg2 = call(hs, kHandler, "obtainMessage", true, h,
+                           {int_arg(6), obj_arg(obj)});
+    call(hs, kHandler, "sendMessage", true, h, {obj_arg(msg2.object_id)});
+    check(hs->queue_size() == 2, "two messages queued");
+    size_t removed = hs->remove_by_token(obj);
+    check(removed == 1, "removeCallbacksAndMessages(obj) removed exactly 1");
+    check(hs->queue_size() == 1, "the OTHER message survived");
+    hs->remove_all();
+    ev(ts, hs, "TEST17 send/target/when/token verified");
+}
