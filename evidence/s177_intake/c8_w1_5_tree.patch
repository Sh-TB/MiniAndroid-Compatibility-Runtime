+bool ExecutorShadow::cancel_cf(uint32_t cf_oid) {
+    auto it = cf_records_.find(cf_oid);
+    if (it == cf_records_.end() || it->second.state != kFuturePending)
+        return false;
+    it->second.state = kFutureCancelled;
+    // Cancel rides the token law: purge the queued async task (runAsync).
+    auto tk = cf_task_.find(cf_oid);
+    if (tk != cf_task_.end()) {
+        if (auto* hs = registry_ ? registry_->find_as<HandlerShadow>()
+                                 : nullptr)
+            hs->remove_by_token(cf_oid);
+        cf_task_.erase(tk);
+    }
+    return true;
+}
