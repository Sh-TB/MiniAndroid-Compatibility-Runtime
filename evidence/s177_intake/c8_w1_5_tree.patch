+std::vector<ExecutorShadow::CompletableFutureRecord::Dependent>
+ExecutorShadow::complete_cf(uint32_t cf_oid, bool threw, uint32_t exc_oid,
+                            bool has_result, uint32_t result_oid,
+                            const std::string& result_desc) {
+    std::vector<CompletableFutureRecord::Dependent> to_fire;
+    auto it = cf_records_.find(cf_oid);
+    if (it == cf_records_.end()) return to_fire;
+    CompletableFutureRecord& rec = it->second;
+    if (rec.state != kFuturePending) return to_fire;  // JDK: first wins
+    rec.state = threw ? kFutureException
+                      : (has_result || !threw ? kFutureCompleted
+                                              : kFutureCompleted);
+    rec.exc_oid = exc_oid;
+    rec.has_result = has_result;
+    rec.result_oid = result_oid;
+    rec.result_desc = result_desc;
+    to_fire = rec.dependents;
+    rec.dependents.clear();
+    // ── S173-CONC (CODER 8, wave 4): COMPOSITE sources ledger ──────────
+    // This cf may be a SOURCE of allOf/anyOf composites. Every unsettled
+    // link advances; a composite that completes fires ITS dependents too
+    // (transitive — a composite can itself be a source of another
+    // composite, which is the deep-chain compose shape).
+    auto cit = cf_composites_.find(cf_oid);
+    if (cit != cf_composites_.end()) {
+        std::vector<CompositeLink> links = cit->second;
+        cf_composites_.erase(cit);
+        for (const auto& link : links) {
+            if (link.settled) continue;
+            const bool already =
+                cf_composite_settled_.count(link.composite_oid) != 0;
+            if (link.is_all) {
+                if (threw) {
+                    if (already) continue;
+                    // OpenJDK allOf: an exceptional source completes the
+                    // composite exceptionally (first exceptional wins).
+                    cf_composite_settled_[link.composite_oid] = true;
+                    cf_composite_remaining_.erase(link.composite_oid);
+                    std::cerr << "[EXECUTOR][CF][ALL] source o" << cf_oid
+                              << " threw → composite o"
+                              << link.composite_oid
+                              << " completes EXCEPTIONALLY" << std::endl;
+                    std::vector<CompletableFutureRecord::Dependent> sub = complete_cf(
+                        link.composite_oid, /*threw=*/true, exc_oid, false,
+                        0, "");
+                    to_fire.insert(to_fire.end(), sub.begin(), sub.end());
+                    continue;
+                }
+                auto rit = cf_composite_remaining_.find(link.composite_oid);
+                if (rit == cf_composite_remaining_.end()) continue;
+                if (--rit->second <= 0) {
+                    cf_composite_settled_[link.composite_oid] = true;
+                    cf_composite_remaining_.erase(rit);
+                    std::cerr << "[EXECUTOR][CF][ALL] last source o"
+                              << cf_oid << " done → composite o"
+                              << link.composite_oid << " COMPLETED"
+                              << std::endl;
+                    std::vector<CompletableFutureRecord::Dependent> sub =
+                        complete_cf(link.composite_oid, false, 0, false, 0,
+                                    "");
+                    to_fire.insert(to_fire.end(), sub.begin(), sub.end());
+                }
+            } else {
+                if (already) continue;
+                // anyOf: the FIRST completing source settles the composite
+                // with ITS outcome.
+                cf_composite_settled_[link.composite_oid] = true;
+                cf_composite_remaining_.erase(link.composite_oid);
+                std::cerr << "[EXECUTOR][CF][ANY] source o" << cf_oid
+                          << " settled → composite o" << link.composite_oid
+                          << " completes ("
+                          << (threw ? "exceptional" : "result") << ")"
+                          << std::endl;
+                std::vector<CompletableFutureRecord::Dependent> sub =
+                    threw ? complete_cf(link.composite_oid, true, exc_oid,
+                                        false, 0, "")
+                          : complete_cf(link.composite_oid, false, 0,
+                                        has_result, result_oid,
+                                        result_desc);
+                to_fire.insert(to_fire.end(), sub.begin(), sub.end());
+            }
+        }
+    }
+    return to_fire;
+}
