+uint32_t ExecutorShadow::create_cf_composite(
+    bool is_all, const std::vector<uint32_t>& sources) {
+    uint32_t cf = create_completable_future();
+    if (is_all && sources.empty()) {
+        // OpenJDK allOf(): NO sources → already-completed composite.
+        cf_composite_settled_[cf] = true;
+        complete_cf(cf, false, 0, false, 0, "");
+        return cf;
+    }
+    int64_t pending_count = 0;
+    bool any_pending = false;
+    for (uint32_t src : sources) {
+        const auto* rec = cf_record(src);
+        bool src_pending = rec != nullptr && rec->state == kFuturePending;
+        cf_composites_[src].push_back(
+            CompositeLink{cf, is_all, /*settled=*/false});
+        if (src_pending) {
+            ++pending_count;
+            any_pending = true;
+        }
+    }
+    cf_composite_remaining_[cf] = pending_count;
+    if (!any_pending) {
+        // Every source already settled at creation (completedFuture passed
+        // to allOf/anyOf): the composite resolves NOW (JDK law).
+        if (is_all) {
+            cf_composite_settled_[cf] = true;
+            cf_composite_remaining_.erase(cf);
+            complete_cf(cf, false, 0, false, 0, "");
+        } else if (!sources.empty()) {
+            const auto* first = cf_record(sources.front());
+            cf_composite_settled_[cf] = true;
+            cf_composite_remaining_.erase(cf);
+            if (first != nullptr && first->state == kFutureException)
+                complete_cf(cf, true, first->exc_oid, false, 0, "");
+            else if (first != nullptr)
+                complete_cf(cf, false, 0, first->has_result,
+                            first->result_oid, first->result_desc);
+        }
+    }
+    return cf;
+}
