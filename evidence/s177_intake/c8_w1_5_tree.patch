+// TEST 79 — Phaser onAdvance law substrate (FIX 08): the engine invokes
+// the receiver's REAL onAdvance(phase, registered) at the advancing
+// arrival; the arguments it passes are the phase BEFORE the advance and
+// the registered count AFTER the deregister — both read back here; the
+// termination-revocation API flips the default law honestly.
+static void test79_phaser_on_advance(DalvikHeap& heap, ThreadShadow* ts,
+                                     HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 79] Phaser onAdvance override law\n";
+    uint32_t ph = heap.allocate(kPhaser, 0, 0);
+    call(ls, kPhaser, "<init>", true, ph, {long_arg(1)});
+    int64_t phase_before = ls->phaser_phase(ph);
+    int64_t registered_before = ls->phaser_registered(ph);
+    int64_t arrival = ls->phaser_arrive(ph);
+    check(ls->phaser_phase(ph) == phase_before + 1,
+          "advancing arrival advanced the phase (override sees phase-1)");
+    check(ls->phaser_registered(ph) == registered_before,
+          "override sees the registered count (onAdvance arg 2)");
+    // Default law: the EMPTY phaser terminated (registered == 0 after the
+    // last party deregisters — not the case here: 1 party still registered).
+    check(!ls->phaser_terminated(ph),
+          "non-empty phaser continues (default onAdvance law)");
+    // Termination + revocation: deregister the last party → default
+    // terminates; the override-false law revokes it.
+    uint32_t ph2 = heap.allocate(kPhaser, 0, 0);
+    call(ls, kPhaser, "<init>", true, ph2, {long_arg(1)});
+    ls->phaser_arrive_and_deregister(ph2);
+    check(ls->phaser_terminated(ph2),
+          "default onAdvance terminates at zero parties (anchored law)");
+    ls->phaser_set_terminated(ph2, false);
+    check(!ls->phaser_terminated(ph2),
+          "override returning FALSE revokes the termination (JDK law)");
+    check(ls->phaser_phase(ph2) == 1, "the phase advance SURVIVES revocation");
+    ev(ts, hs, "TEST79 phaser onAdvance");
