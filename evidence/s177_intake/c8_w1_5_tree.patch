+// TEST 38 — ReentrantReadWriteLock shared/exclusive exclusion law.
+static void test38_rrwl(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs,
+                        LocksShadow* ls) {
+    std::cout << "\n[TEST 38] ReentrantReadWriteLock read/write exclusion\n";
+    uint32_t rwl = heap.allocate(kRWL, 0, 0);
+    call(ls, kRWL, "<init>", true, rwl);
+    CallResult rl = call(ls, kRWL, "readLock", true, rwl);
+    CallResult wl = call(ls, kRWL, "writeLock", true, rwl);
+    check(rl.handled && wl.handled && rl.object_id != 0 && wl.object_id != 0,
+          "readLock()/writeLock() return REAL objects");
+    const char* kRead = rl.object_class.c_str();
+    const char* kWrite = wl.object_class.c_str();
+    // Thread A takes the WRITE lock.
+    uint32_t ta = heap.allocate(kThread, 0, 0);
+    {
+        IdentityGuard g(ts, ta);
+        check(call(ls, kWrite, "lock", true, wl.object_id).handled,
+              "A writeLock.lock() acquired");
+        // Thread B's read tryLock is EXCLUDED by the writer.
+        uint32_t tb = heap.allocate(kThread, 0, 0);
+        {
+            IdentityGuard g2(ts, tb);
+            CallResult t = call(ls, kRead, "tryLock", true, rl.object_id);
+            check(t.handled && t.bool_val == false,
+                  "B readLock.tryLock() → FALSE while A holds the write lock "
+                  "(was: blind true)");
+            CallResult bad_unlock = call(ls, kWrite, "unlock", true,
+                                         wl.object_id);
+            check(bad_unlock.handled && bad_unlock.is_exc &&
+                      bad_unlock.exc_class ==
+                          "Ljava/lang/IllegalMonitorStateException;",
+                  "B WriteLock.unlock() → IllegalMonitorStateException "
+                  "(JDK law; was a logged no-op)");
+        }
+        // Write→read DOWNGRADE by the SAME owner is legal (JDK law).
+        check(call(ls, kRead, "lock", true, rl.object_id).handled,
+              "A downgrades write→read (same owner, legal)");
+        CallResult holds = call(ls, kRWL, "getReadHoldCount", true, rwl);
+        check(holds.handled && holds.int_val == 1,
+              "getReadHoldCount == 1 for the OWNER (per-thread law)");
+        check(call(ls, kWrite, "unlock", true, wl.object_id).handled,
+              "A releases the write lock (downgrade path)");
+        check(call(ls, kRWL, "isWriteLocked", true, rwl).bool_val == false,
+              "isWriteLocked == false after release");
+        check(call(ls, kRWL, "isReadLocked", true, rwl).bool_val == true,
+              "isReadLocked == true (the read hold survives)");
+        call(ls, kRead, "unlock", true, rl.object_id);
+        check(call(ls, kRWL, "isReadLocked", true, rwl).bool_val == false,
+              "read hold released");
+        // ReadLock.unlock without a hold → IMSE (per-owner JDK law).
+        CallResult no_hold = call(ls, kRead, "unlock", true, rl.object_id);
+        check(no_hold.handled && no_hold.is_exc &&
+                  no_hold.exc_class ==
+                      "Ljava/lang/IllegalMonitorStateException;",
+              "ReadLock.unlock with NO hold → IMSE (was a logged no-op)");
+    }
+    ev(ts, hs, "TEST38 rrwl exclusion walk");
+    (void)kRead; (void)kWrite;
+}
