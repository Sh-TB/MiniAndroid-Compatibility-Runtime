+// TEST 08 — wait/notify (register, wrong-monitor 0, one-release,
+// all-release, interrupt-throw).
+static void test08_wait_notify(DalvikHeap& heap, ThreadShadow* ts,
+                               HandlerShadow* hs) {
+    std::cout << "\n[TEST 08] Object wait/notify per-monitor wait set\n";
+    uint32_t mon = heap.allocate("Ljava/lang/Object;", 0, 0);
+    uint32_t other = heap.allocate("Ljava/lang/Object;", 0, 0);
+    uint32_t t6 = heap.allocate(kThread, 0, 0);
+    uint32_t t7 = heap.allocate(kThread, 0, 0);
+    call(ts, kThread, "<init>", true, t6, {str_arg("waiter-6")});
+    call(ts, kThread, "<init>", true, t7, {str_arg("waiter-7")});
+    ts->register_wait(t6, mon, INT64_MAX);
+    ts->register_wait(t7, mon, INT64_MAX);
+    ev(ts, hs, "TEST08 two waiters registered on monitor");
+    check(ts->waiters_on(mon) == 2, "2 waiters registered");
+    check(ts->notify_monitor(other, false) == 0,
+          "notify on ANOTHER monitor releases 0");
+    check(ts->notify_monitor(mon, false) == 1,
+          "notify releases exactly ONE waiter (deterministic choice)");
+    check(ts->notify_monitor(mon, true) == 1,
+          "notifyAll releases the remaining waiter");
+    // A released waiter leaves the wait set at its re-entry (consume law).
+    bool intr_dummy = false;
+    ts->consume_wait_resume(t6, mon, &intr_dummy);
+    ts->consume_wait_resume(t7, mon, &intr_dummy);
+    check(ts->waiters_on(mon) == 0, "wait set empty after release + re-entry");
+    // Interrupted waiter surfaces the interrupt at the wait re-entry.
+    uint32_t t8 = heap.allocate(kThread, 0, 0);
+    ts->register_wait(t8, mon, INT64_MAX);
+    ts->set_interrupted(t8);
+    bool was_interrupted = false;
+    check(ts->consume_wait_resume(t8, mon, &was_interrupted) &&
+              was_interrupted,
+          "interrupted waiter consumes InterruptedException at wait site");
+    // WAITING vs TIMED_WAITING states (S166 wait law observables).
+    ts->register_wait(t8, mon, INT64_MAX);
+    check(ts->thread_state(t8) == ThreadShadow::ThreadState::WAITING,
+          "wait(0) → WAITING state");
+    ts->register_wait(t8, mon, 250);
+    check(ts->thread_state(t8) == ThreadShadow::ThreadState::TIMED_WAITING,
+          "wait(250) → TIMED_WAITING state");
+}
