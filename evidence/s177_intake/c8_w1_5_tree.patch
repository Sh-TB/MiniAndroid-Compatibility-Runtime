+// TEST 91 — LockSupport blocker law (FIX 20): park(blocker) records;
+// getBlocker() answers the CALLING thread's blocker; unpark clears.
+static void test91_lock_support_blocker(DalvikHeap& heap, ThreadShadow* ts,
+                                        HandlerShadow* hs) {
+    std::cout << "\n[TEST 91] LockSupport park blocker / getBlocker\n";
+    uint32_t blocker = heap.allocate(kTaskCls, 0, 0);
+    uint32_t self = ts->current_thread_id();
+    check(ts->park_blocker_of(self) == 0, "no blocker before parking");
+    ts->set_park_blocker(self, blocker);
+    check(ts->park_blocker_of(self) == blocker,
+          "park(blocker) recorded the blocker (JDK law)");
+    // (the engine law records exactly this at park(blocker) entry)
+    ts->set_park_blocker(self, 0);
+    check(ts->park_blocker_of(self) == 0,
+          "unpark clears the blocker (JDK release law)");
+    // Blocker identity is PER-THREAD.
+    uint32_t t2 = heap.allocate(kThread, 0, 0);
+    call(ts, kThread, "<init>", true, t2, {obj_arg(heap.allocate(kTaskCls, 0, 0)),
+                                           str_arg("blk-probe")});
+    check(ts->park_blocker_of(t2) == 0,
+          "another thread's blocker is independent (per-thread law)");
+    ev(ts, hs, "TEST91 LockSupport blocker");
+}
