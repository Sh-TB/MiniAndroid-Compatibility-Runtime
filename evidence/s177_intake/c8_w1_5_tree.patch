+// ═══════════════════════════════════════════════════════════════════════════
+// S163-CONC (CODER 8) — FUTURETASK RUN/COMPLETE LAW.
+//
+// Runs the REAL task body behind a FutureTask and flips the future state:
+//   * cancelled future → silent no-op (OpenJDK FutureTask.run: state guard
+//     handles/rans only NEW→...; a cancelled task never runs its body),
+//   * Runnable task  → REAL DEX run(),
+//   * Callable-shaped task (run() absent) → REAL DEX call() with the REAL
+//     return value captured into the COMPLETED future record,
+//   * thrown body → EXCEPTION state (uncaught-in-flight delta is the
+//     engine's exception-honesty signal, F-016 family).
+// Returns true when a body actually executed.
+// ═══════════════════════════════════════════════════════════════════════════
+bool DalvikExecutionEngine::run_and_complete_future(uint32_t future_oid) {
+    if (shadow_registry_ == nullptr) return false;
+    auto* ex = shadow_registry_->find_as<framework::ExecutorShadow>();
+    if (ex == nullptr) return false;
+    const auto* rec = ex->future_record(future_oid);
+    if (rec == nullptr) return false;
+    if (rec->state == framework::ExecutorShadow::kFutureCancelled) {
+        std::cerr << "[EXECUTOR][FUTURE] run o" << future_oid
+                  << " skipped (CANCELLED — OpenJDK run() state guard)"
+                  << std::endl;
+        return false;
+    }
+    if (rec->state != framework::ExecutorShadow::kFuturePending) return false;
+    uint32_t task = rec->task_oid;
+    if (task == 0 || !heap_.has_object(task)) {
+        // Executor-completed without a DEX body (empty task): complete with
+        // the recorded payload or null — never leave the future pending.
+        ex->complete_task(task, false, 0);
+        return false;
+    }
+    std::string tcls = "Ljava/lang/Object;";
+    if (const auto* tobj = heap_.get(task))
+        if (!tobj->class_descriptor.empty()) tcls = tobj->class_descriptor;
+    DalvikValue self_t = DalvikValue::make_object(task, tcls);
+    DalvikValue task_ret;
+    DalvikExecutionResult task_res;
+    std::vector<DalvikValue> task_args{self_t};
+    size_t uncaught_before = task_res.uncaught_in_flight_count;
+    bool ran = try_recursive_invoke(tcls, "run", task_args, task_ret,
+                                    task_res, "()V");
+    bool has_result = false;
+    if (!ran) {
+        // Callable-shaped task: REAL DEX call() with the REAL return value.
+        DalvikExecutionResult call_res;
+        ran = try_recursive_invoke(tcls, "call", task_args, task_ret,
+                                   call_res,
+                                   "(Ljava/lang/Object;)Ljava/lang/Object;");
+        task_res.uncaught_in_flight_count += call_res.uncaught_in_flight_count;
+        has_result = ran && task_ret.type == DalvikType::OBJECT_REF;
+    }
+    bool threw = task_res.uncaught_in_flight_count > uncaught_before;
+    // S166-CONC (CODER 8) CAUSE CAPTURE: when the body threw, the in-flight
+    // exception DalvikValue (frame_unwind_exception_ — the FULL Dalvik
+    // propagation state) carries the REAL throwable object. Record its oid
+    // on the future so get() can wrap it as the ExecutionException cause
+    // (Throwable.getCause contract) instead of a message-only wrapper.
+    uint32_t task_exc_oid = 0;
+    if (threw && frame_unwind_exception_valid_ &&
+        frame_unwind_exception_.type == DalvikType::OBJECT_REF)
+        task_exc_oid = frame_unwind_exception_.object_id;
+    std::string rdesc;
+    if (has_result && heap_.has_object(task_ret.object_id)) {
+        if (const auto* ro = heap_.get(task_ret.object_id))
+            rdesc = ro->class_descriptor;
+    }
+    ex->complete_task(task, threw, task_exc_oid, has_result,
+                      has_result ? task_ret.object_id : 0, rdesc);
+    std::cerr << "[EXECUTOR][FUTURE] ran task o" << task << " cls=" << tcls
+              << " → " << (ran ? "REAL DEX body executed" : "no body found")
+              << (threw ? " (EXCEPTION)" : "") << std::endl;
+    // S170-CONC (CODER 8, wave 3): when this task rides a
+    // CompletableFuture (runAsync/supplyAsync), flip the CF and fire its
+    // dependents — same completion authority as FutureTask.
+    fire_completable_future_completion(task, threw, task_exc_oid, has_result,
+                                       has_result ? task_ret.object_id : 0,
+                                       rdesc);
+    return ran;
+}
