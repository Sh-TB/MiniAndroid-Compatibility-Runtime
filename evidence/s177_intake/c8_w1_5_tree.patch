+        ev(ts, hs, "TEST40 producer parked FULL");
+        check(ts->thread_state(producer) ==
+                  ThreadShadow::ThreadState::WAITING,
+              "put-when-full → WAITING on the put-side key");
+        // A take frees capacity and wakes ONE putter.
+        CallResult t = call(ls, kABQ, "take", true, q);
+        check(t.handled && t.object_id == e1, "take → e1");
+        bool intr40 = false, not40 = false;
+        check(ts->consume_wait_resume_result(producer, put_key, &intr40,
+                                             &not40) &&
+                  not40,
+              "take woke the parked PRODUCER (putter, not a taker)");
+        check(ts->waiters_on(put_key) == 0, "put-side wait set empty");
+    }
+    call(ls, kABQ, "put", true, q, {obj_arg(e2)});
+    check(call(ls, kABQ, "size", true, q).long_val == 1, "size == 1 after retry");
+}
