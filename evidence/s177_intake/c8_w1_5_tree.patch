+// TEST 44 — CompletableFuture creation law (completedFuture/failedFuture/
+// runAsync + state flips).
+static void test44_cf_creation(DalvikHeap& heap, ThreadShadow* ts,
+                               HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 44] CompletableFuture creation law\n";
+    uint32_t payload = heap.allocate(kTaskCls, 0, 0);
+    CallResult done = call(ex, kCF, "completedFuture", false, 0,
+                           {obj_arg(payload)});
+    check(done.handled && done.object_id != 0,
+          "completedFuture → REAL CF object (was: unimplemented path)");
+    const auto* rec = ex->cf_record(done.object_id);
+    check(rec && rec->state == ExecutorShadow::kFutureCompleted,
+          "completedFuture state == COMPLETED");
+    CallResult fail = call(ex, kCF, "failedFuture", false, 0,
+                           {obj_arg(payload)});
+    rec = ex->cf_record(fail.object_id);
+    check(rec && rec->state == ExecutorShadow::kFutureException &&
+              rec->exc_oid == payload,
+          "failedFuture state == EXCEPTION with the REAL cause");
+    // runAsync: REAL CF + the REAL task enqueued with the CF oid token.
+    uint32_t task = heap.allocate(kTaskCls, 0, 0);
+    CallResult ra = call(ex, kCF, "runAsync", false, 0, {obj_arg(task)});
+    check(ra.handled && ra.object_id != 0, "runAsync → REAL CF");
+    rec = ex->cf_record(ra.object_id);
+    check(rec && rec->state == ExecutorShadow::kFuturePending,
+          "runAsync CF starts PENDING");
+    check(ex->cf_task_of(ra.object_id) == task,
+          "the CF records its async task (cf→task law)");
+    size_t before = hs->queue_size();
+    check(before >= 1, "the async task rides the ONE MessageQueue");
+    std::vector<uint32_t> drained;
+    hs->drain_ready(&drained);
+    bool found = false;
+    for (uint32_t d : drained) if (d == task) found = true;
+    check(found, "runAsync task drained from the queue");
+    // Simulate the engine completion hook (same authority as complete_task
+    // in the wave-1 Future tests): flip the CF + capture dependents.
+    auto deps = ex->complete_cf(ra.object_id, /*threw=*/false, 0,
+                                /*has_result=*/false, 0, "");
+    rec = ex->cf_record(ra.object_id);
+    check(rec && rec->state == ExecutorShadow::kFutureCompleted,
+          "completion hook flipped the CF → COMPLETED");
+    check(deps.empty(), "no dependents registered → nothing to fire");
+    check(call(ex, kCF, "isDone", true, ra.object_id).bool_val == true,
+          "isDone == true after completion");
+    ev(ts, hs, "TEST44 cf creation laws");
+}
