+// TEST 69 — Thread.activeCount/enumerate registry law.
+static void test69_enumerate(DalvikHeap& heap, DalvikHeapAdapter& adapter,
+                             ThreadShadow* ts, HandlerShadow* hs) {
+    std::cout << "\n[TEST 69] Thread.activeCount/enumerate law\n";
+    int before = call(ts, kThread, "activeCount", false, 0).int_val;
+    check(before >= 1, "activeCount >= 1 (the main thread is live)");
+    uint32_t w1 = heap.allocate(kThread, 0, 0);
+    uint32_t r1 = heap.allocate(kTaskCls, 0, 0);
+    call(ts, kThread, "<init>", true, w1, {obj_arg(r1), str_arg("enum-A")});
+    check(call(ts, kThread, "activeCount", false, 0).int_val == before,
+          "NEW thread NOT counted (JDK: enumerate counts started threads)");
+    // start → RUNNABLE (the pending-start law marks the state).
+    call(ts, kThread, "start", true, w1);
+    int after = call(ts, kThread, "activeCount", false, 0).int_val;
+    check(after == before + 1, "started thread counted (activeCount +1)");
+    // enumerate fills a Thread[] (the dense-array model). JDK law: extra
+    // threads beyond the array capacity are SILENTLY IGNORED and the
+    // return is the number actually written — use a roomy array so the
+    // full live set fits (the earlier wave tests leave ~25 live workers).
+    uint32_t arr = heap.allocate("[Ljava/lang/Thread;", 0, 0);
+    adapter.set_object_int_field(arr, "__array_length__", 64);
+    CallResult n = call(ts, kThread, "enumerate", false, 0, {obj_arg(arr)});
+    check(n.handled && n.int_val == after,
+          "enumerate filled exactly the live count");
+    bool found = false;
+    for (int i = 0; i < n.int_val; ++i) {
+        auto v = heap.get_object_field(arr, "array[" + std::to_string(i) + "]");
+        if (v.has_value() && v->object_id == w1)
+            found = true;
+    }
+    check(found, "the started worker IS in the filled array");
+    // A SHORTER array truncates the fill (JDK silent-ignore law).
+    uint32_t short_arr = heap.allocate("[Ljava/lang/Thread;", 0, 0);
+    adapter.set_object_int_field(short_arr, "__array_length__", 2);
+    CallResult n2 = call(ts, kThread, "enumerate", false, 0,
+                         {obj_arg(short_arr)});
+    check(n2.handled && n2.int_val == 2,
+          "enumerate into a shorter array truncates (JDK silent-ignore)");
+    CallResult npe = call(ts, kThread, "enumerate", false, 0, {null_arg()});
+    check(npe.handled && npe.is_exc,
+          "enumerate(null) → NullPointerException (JDK law)");
+    ev(ts, hs, "TEST69 enumerate/activeCount");
+}
