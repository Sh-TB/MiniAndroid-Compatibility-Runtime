+// TEST 87 — CF orTimeout / completeOnTimeout (FIX 16): the deadline law —
+// orTimeout completes TimeoutException; completeOnTimeout completes the
+// fallback; a REAL completion first wins; a settled CF is inert.
+static void test87_cf_deadlines(DalvikHeap& heap, ThreadShadow* ts,
+                                HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 87] CF orTimeout / completeOnTimeout\n";
+    // (a) orTimeout: not completed → at the deadline the CF completes
+    // exceptionally with the minted TimeoutException.
+    uint32_t cf1 = ex->create_completable_future();
+    CallResult r1 = call(ex, kCF, "orTimeout", true, cf1,
+                         {null_arg(), long_arg(250)});
+    check(r1.handled && r1.object_id == cf1, "orTimeout returns THIS");
+    check(ex->cf_record(cf1)->state == ExecutorShadow::kFuturePending,
+          "still PENDING before the deadline");
+    check(ex->cf_record(cf1)->has_deadline &&
+              ex->cf_record(cf1)->deadline_ms == hs->virtual_now_ms() + 250,
+          "deadline = now + timeout (the ONE virtual clock)");
+    auto fired1 = ex->cf_check_deadlines(hs->virtual_now_ms() + 250);
+    bool hit1 = false;
+    for (uint32_t c : fired1) hit1 |= (c == cf1);
+    check(hit1, "deadline due → cf_check_deadlines fires it");
+    check(ex->cf_record(cf1)->state == ExecutorShadow::kFutureException,
+          "orTimeout deadline → TimeoutException (EXCEPTION state)");
+    check(ex->cf_record(cf1)->exc_oid != 0, "real TimeoutException object");
+    // (b) completeOnTimeout: fallback value at the deadline.
+    uint32_t cf2 = ex->create_completable_future();
+    uint32_t fb = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    call(ex, kCF, "completeOnTimeout", true, cf2, {obj_arg(fb), long_arg(100)});
+    auto fired2 = ex->cf_check_deadlines(hs->virtual_now_ms() + 100);
+    check(ex->cf_record(cf2)->state == ExecutorShadow::kFutureCompleted,
+          "completeOnTimeout → COMPLETED at the deadline");
+    check(ex->cf_record(cf2)->result_oid == fb, "fallback value carried");
+    // (c) REAL completion wins: completing before the deadline is final.
+    uint32_t cf3 = ex->create_completable_future();
+    call(ex, kCF, "orTimeout", true, cf3, {null_arg(), long_arg(100)});
+    uint32_t v = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    ex->complete_cf(cf3, false, 0, true, v, "Ljava/lang/Integer;");
+    auto fired3 = ex->cf_check_deadlines(hs->virtual_now_ms() + 1000);
+    bool hit3 = false;
+    for (uint32_t c : fired3) hit3 |= (c == cf3);
+    check(!hit3, "settled CF is INERT at its deadline (postComplete guard)");
+    check(ex->cf_record(cf3)->result_oid == v, "the REAL outcome stands");
+    ev(ts, hs, "TEST87 CF deadlines");
+}
