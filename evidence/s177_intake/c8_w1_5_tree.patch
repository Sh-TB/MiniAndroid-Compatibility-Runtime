+// ── event trace: sequence, thread identity, virtual ms, wall ms ──────────
+struct Event {
+    int seq;
+    std::string thread;
+    int64_t virt_ms;
+    int64_t wall_ms;
+    std::string what;
+};
+
+static std::vector<Event> g_events;
+static int64_t g_wall0_ms = 0;
+
+static int64_t steady_now_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+static void ev(ThreadShadow* ts, HandlerShadow* hs, const std::string& what) {
+    Event e;
+    e.seq = static_cast<int>(g_events.size()) + 1;
+    e.thread = ts ? ts->thread_name(ts->current_thread_id()) : "?";
+    e.virt_ms = hs ? hs->virtual_now_ms() : 0;
+    e.wall_ms = steady_now_ms() - g_wall0_ms;
+    e.what = what;
+    g_events.push_back(e);
+    std::cout << "  ev" << e.seq << " virt=" << e.virt_ms << "ms wall="
+              << e.wall_ms << "ms thread=" << e.thread << " :: " << what
+              << "\n";
+}
+
+// FNV-1a 64-bit over the virtual event signature (seq|thread|virt).
+static uint64_t fnv1a(const std::string& s) {
+    uint64_t h = 1469598103934665603ULL;
+    for (unsigned char c : s) {
+        h ^= c;
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+static std::string signature_digest() {
+    std::string sig;
+    for (const auto& e : g_events) {
+        sig += std::to_string(e.seq) + "|" + e.thread + "|" +
+               std::to_string(e.virt_ms) + "\n";
+    }
+    char buf[32];
+    std::snprintf(buf, sizeof buf, "%016llx",
+                  static_cast<unsigned long long>(fnv1a(sig)));
+    return std::string(buf);
+}
