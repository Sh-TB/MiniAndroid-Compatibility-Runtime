+static void test64_callable_adapter(DalvikHeap& heap, ThreadShadow* ts,
+                                    HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 64] Executors.callable + FutureTask direct run\n";
+    uint32_t run = heap.allocate(kTaskCls, 0, 0);
