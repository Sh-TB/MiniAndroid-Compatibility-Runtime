+static CallContext::Arg int_arg(int64_t v) {
+    CallContext::Arg a;
+    a.kind = CallContext::Arg::Kind::INT;
+    a.int_val = static_cast<int32_t>(v);
+    a.long_val = v;
+    return a;
+}
+static CallContext::Arg long_arg(int64_t v) {
+    CallContext::Arg a;
+    a.kind = CallContext::Arg::Kind::LONG;
+    a.long_val = v;
+    return a;
+}
+static CallContext::Arg obj_arg(uint32_t oid) {
+    CallContext::Arg a;
+    a.kind = CallContext::Arg::Kind::OBJECT;
+    a.object_id = oid;
+    return a;
+}
+static CallContext::Arg null_arg() {
+    CallContext::Arg a;
+    a.kind = CallContext::Arg::Kind::NULL_REF;
+    return a;
+}
+static CallContext::Arg bool_arg(bool v) {
+    CallContext::Arg a;
+    a.kind = CallContext::Arg::Kind::BOOL;
+    a.bool_val = v;
+    a.int_val = v ? 1 : 0;
