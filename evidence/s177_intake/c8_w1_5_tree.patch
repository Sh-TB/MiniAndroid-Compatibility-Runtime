+// TEST 88 — CF delayedExecutor (FIX 17): the synthetic executor joins the
+// ONE MessageQueue with the delay stamp; the command runs at the virtual
+// due — never before.
+static void test88_delayed_executor(DalvikHeap& heap, ThreadShadow* ts,
+                                    HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 88] CompletableFuture.delayedExecutor\n";
+    CallResult dx = call(ex, kCF, "delayedExecutor", true, 0,
+                         {long_arg(300)});
+    check(dx.handled && dx.object_id != 0,
+          "delayedExecutor(300ms) → a REAL executor object");
+    uint32_t task = heap.allocate(kTaskCls, 0, 0);
+    call(ex, "Ljava/util/concurrent/CompletableFuture$DelayedExecutor;",
+         "execute", true, dx.object_id, {obj_arg(task)});
+    std::vector<uint32_t> drained;
+    hs->drain_ready(&drained);
+    bool ran_early = false;
+    for (uint32_t d : drained) ran_early |= (d == task);
+    check(!ran_early, "NOT run before the virtual delay (never eager)");
+    hs->advance_virtual(300);
+    hs->drain_ready(&drained);
+    bool ran = false;
+    for (uint32_t d : drained) ran |= (d == task);
+    check(ran, "ran exactly at its virtual due (the ONE clock)");
+    ev(ts, hs, "TEST88 delayedExecutor");
+}
