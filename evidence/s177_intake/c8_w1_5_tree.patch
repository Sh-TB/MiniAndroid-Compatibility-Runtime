+// TEST 89 — CF copy / minimalCompletionStage (FIX 18): the settled copy is
+// a snapshot; the PENDING copy mirrors at completion (kind 6); the minimal
+// view is read-only.
+static void test89_cf_copy_minimal(DalvikHeap& heap, ThreadShadow* ts,
+                                   HandlerShadow* hs, ExecutorShadow* ex) {
+    std::cout << "\n[TEST 89] CF copy / minimalCompletionStage\n";
+    // (a) settled copy: same outcome NOW.
+    uint32_t src1 = ex->create_completable_future();
+    uint32_t v = heap.allocate("Ljava/lang/Integer;", 0, 0);
+    ex->complete_cf(src1, false, 0, true, v, "Ljava/lang/Integer;");
+    CallResult cp1 = call(ex, kCF, "copy", true, src1);
+    check(cp1.handled && cp1.object_id != src1,
+          "copy of a settled CF → a NEW CF");
+    check(ex->cf_record(cp1.object_id)->state ==
+                  ExecutorShadow::kFutureCompleted &&
+              ex->cf_record(cp1.object_id)->result_oid == v,
+          "the copy carries the SAME outcome (snapshot law)");
+    // (b) PENDING copy: mirrors the source at completion (no re-fire of
+    // already-fired dependents — the mirror registers unfired).
+    uint32_t src2 = ex->create_completable_future();
+    CallResult cp2 = call(ex, kCF, "copy", true, src2);
+    check(ex->cf_record(cp2.object_id)->state ==
+              ExecutorShadow::kFuturePending,
+          "copy of a PENDING CF stays PENDING");
+    auto mirror = ex->complete_cf(src2, false, 0, true, v, "Ljava/lang/Integer;");
+    check(mirror.size() == 1 && mirror[0].cf_oid == cp2.object_id &&
+              mirror[0].kind == 6,
+          "the copy is a kind-6 MIRROR dependent (JDK CopyCompletion)");
+    // The engine fire step (fire_cf_dependent_list kind 6) completes the
+    // mirror with the source outcome — the same law, driven here.
+    auto mirror_deps = ex->complete_cf(cp2.object_id, false, 0, true, v,
+                                       "Ljava/lang/Integer;");
+    check(ex->cf_record(cp2.object_id)->state ==
+                  ExecutorShadow::kFutureCompleted &&
+              ex->cf_record(cp2.object_id)->result_oid == v,
+          "the copy mirrored the source outcome at completion");
+    check(mirror_deps.empty(), "the mirror leaf has no further dependents");
+    // (c) minimalCompletionStage: a read-only view.
+    uint32_t src3 = ex->create_completable_future();
+    CallResult mv = call(ex, kCF, "minimalCompletionStage", true, src3);
+    check(mv.handled && mv.object_id != 0, "minimal view is a REAL CF object");
+    check(ex->cf_is_minimal(mv.object_id), "the view carries the minimal flag");
+    check(ex->cf_record(mv.object_id)->state ==
+              ExecutorShadow::kFuturePending,
+          "the view tracks the source (PENDING source → PENDING view)");
+    ev(ts, hs, "TEST89 copy/minimal");
+}
