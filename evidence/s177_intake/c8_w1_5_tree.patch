+// TEST 28 — ReentrantLock ownership law (tryLock/unlock per owner).
+static void test28_lock_ownership(DalvikHeap& heap, ThreadShadow* ts,
+                                  HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 28] ReentrantLock ownership law\n";
+    uint32_t lock = heap.allocate(kRLock, 0, 0);
+    uint32_t a = heap.allocate(kThread, 0, 0);
+    uint32_t b = heap.allocate(kThread, 0, 0);
+    call(ts, kThread, "<init>", true, a, {str_arg("locker-A")});
+    call(ts, kThread, "<init>", true, b, {str_arg("locker-B")});
+    bool ime = false;
+    // Owner A acquires twice (reentrant).
+    {
+        IdentityGuard g(ts, a);
+        check(ls->reentrant_acquire(lock, ts->current_thread_id()),
+              "lock() acquired by A");
+        check(ls->reentrant_try(lock, ts->current_thread_id()),
+              "tryLock() true for the owner (reentrant hold bumped)");
+    }
+    // B is locked out.
+    {
+        IdentityGuard g(ts, b);
+        check(!ls->reentrant_try(lock, ts->current_thread_id()),
+              "tryLock() FALSE while ANOTHER thread holds the lock (was "
+              "always-true)");
+        check(!ls->reentrant_acquire(lock, ts->current_thread_id()),
+              "lock() by B is CONTENDED (the caller parks — JDK block law)");
+        bool foreign_rel = ls->reentrant_release(
+            lock, ts->current_thread_id(), &ime);
+        check(!foreign_rel && ime,
+              "unlock() by a NON-OWNER → IllegalMonitorStateException law");
+        ev(ts, hs, "TEST28 foreign unlock rejected");
+    }
+    // A releases twice → free; a third release is the IME law.
+    {
+        IdentityGuard g(ts, a);
+        bool rel1 = ls->reentrant_release(lock, ts->current_thread_id(), &ime);
+        check(rel1 && !ime, "owner unlock #1");
+        bool rel2 = ls->reentrant_release(lock, ts->current_thread_id(), &ime);
+        check(rel2 && !ime, "owner unlock #2 — lock free");
+        bool rel3 = ls->reentrant_release(lock, ts->current_thread_id(), &ime);
+        check(!rel3 && ime,
+              "unlock of an UNHELD lock → IllegalMonitorStateException");
+    }
+    // isHeldByCurrentThread / isLocked observables.
+    {
+        IdentityGuard g(ts, b);
+        check(ls->reentrant_acquire(lock, ts->current_thread_id()),
+              "free lock acquired by B");
+        CallResult held = call(ls, kRLock, "isHeldByCurrentThread", true, lock);
+        check(held.handled && held.bool_val,
+              "isHeldByCurrentThread true for B (was isLocked-echo)");
+        IdentityGuard g2(ts, a);
+        CallResult held_a =
+            call(ls, kRLock, "isHeldByCurrentThread", true, lock);
+        check(held_a.handled && !held_a.bool_val,
+              "isHeldByCurrentThread false for A");
+    }
+}
