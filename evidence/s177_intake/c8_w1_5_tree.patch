+// TEST 50 — LockSupport park state-name law (WAITING vs TIMED_WAITING).
+static void test50_park_state(DalvikHeap& heap, ThreadShadow* ts,
+                              HandlerShadow* hs) {
+    std::cout << "\n[TEST 50] LockSupport park state-name law\n";
+    uint32_t p1 = heap.allocate(kThread, 0, 0);
+    uint32_t p2 = heap.allocate(kThread, 0, 0);
+    call(ts, kThread, "<init>", true, p1, {str_arg("park-unbounded")});
+    call(ts, kThread, "<init>", true, p2, {str_arg("park-nanos")});
+    // The engine park law corrects the state by park form (the wave-1
+    // registry default was TIMED_WAITING for every park shape).
+    ts->mark_thread_yielded(p1, p1, INT64_MAX);   // unbounded park()
+    ts->set_state(p1, ThreadShadow::ThreadState::WAITING);
+    ts->mark_thread_yielded(p2, p2, hs->virtual_now_ms() + 1);  // parkNanos
+    check(ts->thread_state(p1) == ThreadShadow::ThreadState::WAITING,
+          "park() (no deadline) → WAITING (was TIMED_WAITING for every form)");
+    check(ts->thread_state(p2) == ThreadShadow::ThreadState::TIMED_WAITING,
+          "parkNanos → TIMED_WAITING");
+    CallResult s1 = call(ts, kThread, "getState", true, p1);
+    check(s1.handled && s1.string_val == "WAITING",
+          "getState() answers WAITING for the unbounded park");
+    CallResult s2 = call(ts, kThread, "getState", true, p2);
+    check(s2.handled && s2.string_val == "TIMED_WAITING",
+          "getState() answers TIMED_WAITING for parkNanos");
+    ev(ts, hs, "TEST50 park state names");
+}
