+// TEST 07 — Thread interrupt (flag, unpark, consume-once, static
+// interrupted()).
+static void test07_interrupt(DalvikHeap& heap, ThreadShadow* ts,
+                             HandlerShadow* hs) {
+    std::cout << "\n[TEST 07] Thread interrupt (flag + unpark + consume)\n";
+    uint32_t t5 = heap.allocate(kThread, 0, 0);
+    uint32_t r5 = heap.allocate(kTaskCls, 0, 0);
+    call(ts, kThread, "<init>", true, t5, {obj_arg(r5), str_arg("sleeper")});
+    call(ts, kThread, "start", true, t5);
+    ts->mark_thread_yielded(t5, r5, 5000);
+    check(ts->next_wake_for(t5) == 5000, "parked to 5000");
+    call(ts, kThread, "interrupt", true, t5);
+    ev(ts, hs, "interrupt: unpark + status consume");
+    check(ts->next_wake_for(t5) == 0,
+          "interrupt collapsed the parked wake to now (unpark law)");
+    CallResult isint = call(ts, kThread, "isInterrupted", true, t5);
+    check(isint.handled && isint.bool_val, "isInterrupted() true");
+    {
+        // static interrupted() queries AND clears the CURRENT thread.
+        IdentityGuard g(ts, t5);
+        CallResult st = call(ts, kThread, "interrupted", false, 0);
+        check(st.handled && st.bool_val, "static interrupted() saw the flag");
+        CallResult st2 = call(ts, kThread, "interrupted", false, 0);
+        check(st2.handled && !st2.bool_val,
+              "static interrupted() cleared it exactly once");
+    }
+    CallResult isint2 = call(ts, kThread, "isInterrupted", true, t5);
+    check(isint2.handled && !isint2.bool_val,
+          "flag consumed — isInterrupted() false (isInterrupted never clears)");
