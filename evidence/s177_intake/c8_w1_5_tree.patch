+    heap.set_object_field(e3, "__pq_pri__",
+                          dalvik::DalvikValue::make_long(20));
+    check(call(ls, kPBQ, "put", true, q, {obj_arg(e1)}).handled,
+          "put never fails (unbounded JDK law)");
+    check(call(ls, kPBQ, "offer", true, q, {obj_arg(e2)}).bool_val,
+          "offer always true (unbounded)");
+    check(call(ls, kPBQ, "add", true, q, {obj_arg(e3)}).bool_val,
+          "add always true");
+    CallResult pk = call(ls, kPBQ, "peek", true, q);
+    check(pk.handled && pk.object_id == e2,
+          "peek == the MIN priority element (e2 pri=10)");
+    CallResult t1 = call(ls, kPBQ, "take", true, q);
+    check(t1.handled && t1.object_id == e2, "take == min (e2)");
+    CallResult t2 = call(ls, kPBQ, "poll", true, q);
+    check(t2.handled && t2.object_id == e3, "next min (e3 pri=20)");
+    CallResult t3 = call(ls, kPBQ, "poll", true, q);
+    check(t3.handled && t3.object_id == e1, "then (e1 pri=30)");
+    check(ls->pbq_size(q) == 0, "drained by priority");
+    CallResult npe = call(ls, kPBQ, "put", true, q, {null_arg()});
+    check(npe.is_exc && npe.exc_class == "Ljava/lang/NullPointerException;",
+          "put(null) → NPE");
+    // Insertion fallback: no seed → FIFO order (the natural-order
+    // serialized counterpart).
+    uint32_t f1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t f2 = heap.allocate(kTaskCls, 0, 0);
+    call(ls, kPBQ, "add", true, q, {obj_arg(f1)});
+    call(ls, kPBQ, "add", true, q, {obj_arg(f2)});
+    CallResult fp = call(ls, kPBQ, "peek", true, q);
+    check(fp.handled && fp.object_id == f1,
+          "no seed → insertion order (deterministic fallback)");
+    ev(ts, hs, "TEST85 PBQ");
+}
