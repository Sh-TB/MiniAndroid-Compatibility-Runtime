+// TEST 55 — LinkedBlockingDeque law (both-ended FIFO, capacity, null NPE).
+static void test55_deque(DalvikHeap& heap, ThreadShadow* ts, HandlerShadow* hs,
+                         LocksShadow* ls) {
+    std::cout << "\n[TEST 55] LinkedBlockingDeque law\n";
+    CallResult neg = call(ls, kLBD, "<init>", true,
+                          heap.allocate(kLBD, 0, 0), {long_arg(0)});
+    check(neg.handled && neg.is_exc, "ctor(0) → IllegalArgumentException");
+    uint32_t dq = heap.allocate(kLBD, 0, 0);
+    call(ls, kLBD, "<init>", true, dq, {long_arg(2)});
+    uint32_t e1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e3 = heap.allocate(kTaskCls, 0, 0);
+    check(call(ls, kLBD, "offerLast", true, dq, {obj_arg(e1)}).bool_val,
+          "offerLast(e1) true");
+    check(call(ls, kLBD, "offerFirst", true, dq, {obj_arg(e2)}).bool_val,
+          "offerFirst(e2) true");
+    check(call(ls, kLBD, "size", true, dq).int_val == 2, "size == 2");
+    CallResult pk_l = call(ls, kLBD, "peekFirst", true, dq);
+    check(pk_l.handled && pk_l.object_id == e2, "peekFirst == e2 (head)");
+    CallResult pk_r = call(ls, kLBD, "peekLast", true, dq);
+    check(pk_r.handled && pk_r.object_id == e1, "peekLast == e1 (tail)");
+    check(call(ls, kLBD, "remainingCapacity", true, dq).int_val == 0,
+          "remainingCapacity == 0 at capacity");
+    check(call(ls, kLBD, "offerLast", true, dq, {obj_arg(e3)}).bool_val == false,
+          "offerLast on FULL → FALSE (JDK law)");
+    CallResult t1 = call(ls, kLBD, "takeFirst", true, dq);
+    check(t1.handled && t1.object_id == e2, "takeFirst == e2 (FIFO head)");
+    CallResult t2 = call(ls, kLBD, "takeLast", true, dq);
+    check(t2.handled && t2.object_id == e1, "takeLast == e1 (LIFO tail)");
+    check(call(ls, kLBD, "pollFirst", true, dq).ret_kind ==
+              CallResult::RetKind::NULL_REF,
+          "pollFirst on empty → null");
+    CallResult npe = call(ls, kLBD, "putFirst", true, dq, {null_arg()});
+    check(npe.handled && npe.is_exc &&
+              npe.exc_class == "Ljava/lang/NullPointerException;",
+          "putFirst(null) → NullPointerException");
+    ev(ts, hs, "TEST55 deque laws");
+}
