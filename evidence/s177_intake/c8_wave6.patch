+// TEST 103 — timed-park substrate (FIX 01 engine law): a FINITE wait
+// deadline registers TIMED_WAITING and expires; the expiry probe (FIX 10
+// accessor) is the SAME primitive the timed park laws re-check.
+static void test103_timed_park_substrate(DalvikHeap& heap, ThreadShadow* ts,
+                                         HandlerShadow* hs) {
+    std::cout << "\n[TEST 103] timed-park wake substrate (parkNanos law)\n";
+    uint32_t self = ts->current_thread_id();
+    int64_t now = hs->virtual_now_ms();
+    // parkNanos(500ms): wake = now + 500 (ceil(5e8/1e6)).
+    ts->register_wait(self, 0, now + 500);
+    check(std::string(ts->state_name_for(self)) == std::string("TIMED_WAITING"),
+          "finite deadline → TIMED_WAITING");
+    check(!ts->wait_expired(self, 0, now + 100),
+          "deadline NOT expired at now+100");
+    check(ts->wait_expired(self, 0, now + 500),
+          "deadline EXPIRED at now+500 (the wake the F-150 pop fires)");
+    ts->consume_wait_resume_result(self, 0, nullptr, nullptr);
+    // Unbounded park: WAITING, never expires.
+    ts->register_wait(self, 0, INT64_MAX);
+    check(std::string(ts->state_name_for(self)) == std::string("WAITING"),
+          "INT64_MAX deadline → WAITING (park state-name law)");
+    check(!ts->wait_expired(self, 0, now + 1000000),
+          "unbounded park never expires");
+    ts->consume_wait_resume_result(self, 0, nullptr, nullptr);
+    ev(ts, hs, "TEST103 timed park");
+}
