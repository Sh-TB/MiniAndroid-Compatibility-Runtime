+// TEST 104 — TimeUnit.sleep/timedJoin substrate (FIX 02 engine law): the
+// routes re-enter bridge_to_api as Thread.sleep/join with a pre-scaled
+// duration — the ThreadShadow drive primitives they compose.
+static void test104_timeunit_substrate(DalvikHeap& heap, ThreadShadow* ts,
+                                       HandlerShadow* hs) {
+    std::cout << "\n[TEST 104] TimeUnit.sleep/timedJoin substrate\n";
+    // Thread.sleep law substrate: virtual clock advance outside drained
+    // bodies (the exact observable TimeUnit.MILLIS.sleep(250) produces).
+    int64_t t0 = hs->virtual_now_ms();
+    hs->advance_virtual(250);
+    check(hs->virtual_now_ms() == t0 + 250,
+          "250ms sleep advances the ONE virtual clock by 250");
+    // timedJoin substrate: the join drive consumes a pending start for the
+    // TARGET only (the drive the TimeUnit.timedJoin route re-enters).
+    uint32_t task = heap.allocate(kTaskCls, 0, 0);
+    uint32_t t = heap.allocate(kThread, 0, 0);
+    call(ts, kThread, "<init>", true, t, {obj_arg(task), str_arg("tu-join")});
+    call(ts, kThread, "start", true, t);
+    check(ts->has_pending_start_for(t), "pending start recorded");
+    uint32_t r = 0;
+    check(ts->consume_pending_start_for(t, r) && r == task,
+          "join drive consumes the TARGET's body (scoped consume)");
+    ev(ts, hs, "TEST104 timeunit");
+}
