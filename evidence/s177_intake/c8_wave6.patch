+// TEST 110 — LTQ take park substrate (FIX 17): the empty-take park
+// condition + the producer-side wake the parked consumer re-checks.
+static void test110_ltq_park_substrate(DalvikHeap& heap, ThreadShadow* ts,
+                                       HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 110] LTQ take-park substrate\n";
+    uint32_t q = heap.allocate(kLTQ, 0, 0);
+    call(ls, kLTQ, "<init>", true, q);
+    uint32_t el = heap.allocate(kTaskCls, 0, 0);
+    // Empty: the take law's park condition (xfer_take fails).
+    uint32_t got = 0;
+    std::string d;
+    check(!ls->xfer_take(q, got, d), "empty xfer_take fails (park condition)");
+    // The consumer parks on the queue key; the producer's put notifies it
+    // (the SAME law the parked-take re-entry consumes).
+    uint32_t self = ts->current_thread_id();
+    ts->register_wait(self, q, INT64_MAX);
+    call(ls, kLTQ, "put", true, q, {obj_arg(el)});
+    bool was_intr = false, was_notified = false;
+    check(ts->consume_wait_resume_result(self, q, &was_intr, &was_notified),
+          "put's notify produced a resume record on the queue key");
+    check(was_notified, "the resume is a REAL wake (notified=true)");
+    CallResult t = call(ls, kLTQ, "take", true, q);
+    check(t.handled && t.object_id == el, "take answers after the wake");
+    ev(ts, hs, "TEST110 LTQ park");
+}
