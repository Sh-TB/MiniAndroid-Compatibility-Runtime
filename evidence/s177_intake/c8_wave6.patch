+          "not expired at now+50 → park until the deadline");
+    check(ls->dq_poll_due(q, now + 100, el, d) && el == early,
+          "expired at now+100 → the EARLY element answers (min-delay law)");
+    ev(ts, hs, "TEST111 dq head");
