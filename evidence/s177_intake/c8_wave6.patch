+static void test105_cf_getnow_substrate(DalvikHeap& heap, ThreadShadow* ts,
+                                        HandlerShadow* hs,
+                                        ExecutorShadow* ex) {
+    std::cout << "\n[TEST 105] CF.getNow record substrate\n";
