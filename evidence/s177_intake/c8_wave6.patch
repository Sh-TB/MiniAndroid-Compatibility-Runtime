+// TEST 93 — isFair real flag (FIX 05): ctor(boolean fair) stores the mode;
+// isFair() answers the STORED value (was: hardcoded false on every object).
+static void test93_is_fair(DalvikHeap& heap, ThreadShadow* ts,
+                           HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 93] ReentrantLock/RWLock isFair real flag\n";
+    uint32_t unfair = heap.allocate(kRLock, 0, 0);
+    call(ls, kRLock, "<init>", true, unfair);  // no-arg ctor → unfair
+    check(call(ls, kRLock, "isFair", true, unfair).bool_val == false,
+          "default ctor → isFair false");
+    uint32_t fair = heap.allocate(kRLock, 0, 0);
+    call(ls, kRLock, "<init>", true, fair, {bool_arg(true)});
+    check(call(ls, kRLock, "isFair", true, fair).bool_val == true,
+          "ctor(true) → isFair true (real store)");
+    uint32_t rwl_fair = heap.allocate(kRWL, 0, 0);
+    call(ls, kRWL, "<init>", true, rwl_fair, {bool_arg(true)});
+    check(call(ls, kRWL, "isFair", true, rwl_fair).bool_val == true,
+          "RWL ctor(true) → isFair true");
+    uint32_t rwl_unfair = heap.allocate(kRWL, 0, 0);
+    call(ls, kRWL, "<init>", true, rwl_unfair);
+    check(call(ls, kRWL, "isFair", true, rwl_unfair).bool_val == false,
+          "RWL default ctor → isFair false");
