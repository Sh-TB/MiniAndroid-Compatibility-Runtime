+// TEST 107 — drainTo substrate (FIX 09 engine law): the F-NEW-167 heap-field
+// FIFO model the drain walks — count + slots + the shift the law performs.
+static void test107_drain_to_substrate(DalvikHeap& heap, ThreadShadow* ts,
+                                       HandlerShadow* hs) {
+    std::cout << "\n[TEST 107] drainTo heap-field FIFO substrate\n";
+    uint32_t q = heap.allocate(kLBQ, 0, 0);
+    // Seed the F-NEW-167 model: 3 elements in __bq_i<i>__ slots.
+    uint32_t e1 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e2 = heap.allocate(kTaskCls, 0, 0);
+    uint32_t e3 = heap.allocate(kTaskCls, 0, 0);
+    heap.set_object_field(q, "__bq_n__", dalvik::DalvikValue::make_int(3));
+    heap.set_object_field(q, "__bq_i0__", dalvik::DalvikValue::make_object(
+                                             e1, kTaskCls));
+    heap.set_object_field(q, "__bq_i1__", dalvik::DalvikValue::make_object(
+                                             e2, kTaskCls));
+    heap.set_object_field(q, "__bq_i2__", dalvik::DalvikValue::make_object(
+                                             e3, kTaskCls));
+    auto n = heap.get_object_field(q, "__bq_n__");
+    check(n.has_value() && n->int_val == 3, "FIFO count seeded (3)");
+    auto head = heap.get_object_field(q, "__bq_i0__");
+    check(head.has_value() && head->object_id == e1,
+          "FIFO head slot reads back (the drain walks these slots)");
+    ev(ts, hs, "TEST107 drainTo");
+}
