+// TEST 108 — wait_expired probe (FIX 10 accessor): the timed-block expiry
+// signal the Exchanger.exchange(x,t,u) re-entry throws on.
+static void test108_wait_expired(DalvikHeap& heap, ThreadShadow* ts,
+                                 HandlerShadow* hs) {
+    std::cout << "\n[TEST 108] wait_expired probe law\n";
+    uint32_t self = ts->current_thread_id();
+    uint32_t mon = heap.allocate(kTaskCls, 0, 0);
+    int64_t now = hs->virtual_now_ms();
+    ts->register_wait(self, mon, now + 50);
+    check(!ts->wait_expired(self, mon, now + 10),
+          "not expired before the deadline");
+    check(ts->wait_expired(self, mon, now + 50),
+          "expired AT the deadline");
+    // notify clears the expiry (a REAL wake is not a timeout).
+    ts->notify_monitor(mon, false);
+    check(!ts->wait_expired(self, mon, now + 100),
+          "notified waiter never reports expired");
+    ts->consume_wait_resume_result(self, mon, nullptr, nullptr);
+    check(!ts->wait_expired(self, mon, now + 100),
+          "consumed record → no expiry (fresh-wait state)");
+    ev(ts, hs, "TEST108 wait_expired");
+}
