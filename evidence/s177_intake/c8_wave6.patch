+// TEST 102 — Message recycle surface (FIX 16): recycle RESETS the payload
+// and sets the flag isRecycled() reads; toString carries the full field set.
+static void test102_message_recycle(DalvikHeap& heap, ThreadShadow* ts,
+                                    HandlerShadow* hs) {
+    std::cout << "\n[TEST 102] Message recycle/isRecycled/toString\n";
+    uint32_t h = heap.allocate(kHandler, 0, 0);
+    call(hs, kHandler, "<init>", true, h);
+    CallResult m = call(hs, kHandler, "obtainMessage", true, h,
+                        {int_arg(42)});
+    check(m.handled && m.object_id != 0, "obtainMessage(42) → Message");
+    check(call(hs, kMessage, "isRecycled", true, m.object_id).bool_val ==
+              false,
+          "fresh message isRecycled false");
+    std::string s1 = call(hs, kMessage, "toString", true, m.object_id).string_val;
+    check(s1.find("what=42") != std::string::npos &&
+              s1.find("arg1=") != std::string::npos &&
+              s1.find("when=") != std::string::npos,
+          "toString carries what/when/arg fields (got " + s1 + ")");
+    call(hs, kMessage, "recycle", true, m.object_id);
+    check(call(hs, kMessage, "isRecycled", true, m.object_id).bool_val == true,
+          "recycle → isRecycled true");
+    check(call(hs, kMessage, "getWhat", true, m.object_id).int_val == 0,
+          "recycle RESETS the payload (what=0; was stale 42)");
+    // Double recycle is legal (AOSP recycleUnchecked law).
+    call(hs, kMessage, "recycle", true, m.object_id);
+    check(call(hs, kMessage, "isRecycled", true, m.object_id).bool_val == true,
+          "double recycle is legal");
+    ev(ts, hs, "TEST102 message recycle");
+}
