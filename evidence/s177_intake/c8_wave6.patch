+// TEST 109 — CyclicBarrier observables + reset (FIX 12): isBroken/
+// getNumberWaiting read the REAL barrier ledger; reset breaks the current
+// generation and starts a fresh one.
+static void test109_barrier_observables(DalvikHeap& heap, ThreadShadow* ts,
+                                        HandlerShadow* hs, LocksShadow* ls) {
+    std::cout << "\n[TEST 109] CyclicBarrier isBroken/getNumberWaiting/reset\n";
+    uint32_t b = heap.allocate(kBar, 0, 0);
+    call(ls, kBar, "<init>", true, b, {int_arg(2)});
+    check(ls->barrier_is_broken(b) == false, "fresh barrier not broken");
+    check(ls->barrier_number_waiting(b) == 0, "no parties waiting");
+    // One party waits (the await park state the ENGINE law produces).
+    uint32_t self = ts->current_thread_id();
+    ls->barrier_register_waiter(b);  // substrate of the await law
+    check(ls->barrier_number_waiting(b) == 1,
+          "one registered party → getNumberWaiting 1");
+    // Break: the WAITING parties surface BrokenBarrierException at their
+    // re-entry (the state the re-entry arm reads).
+    ls->barrier_break(b);
+    check(ls->barrier_is_broken(b) == true,
+          "broken barrier → isBroken true (waiter re-entry reads this)");
+    // reset(): break + clear to a FRESH generation — the barrier itself is
+    // NOT broken afterwards (JDK law: only the waiters saw the break).
+    ls->barrier_reset(b);
+    check(ls->barrier_is_broken(b) == false,
+          "after reset the FRESH generation is not broken (JDK law)");
+    check(ls->barrier_number_waiting(b) == 0,
+          "reset clears the wait ledger (fresh generation)");
+    ev(ts, hs, "TEST109 barrier");
+}
