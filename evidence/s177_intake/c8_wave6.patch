+              rec->result_oid != 0,
+          "completedFuture record → COMPLETED + result (the getNow read)");
+    CallResult pending = call(ex, kCF, "newIncompleteFuture", false, 0);
+    rec = ex->cf_record(pending.object_id);
+    check(rec && rec->state == ExecutorShadow::kFuturePending,
+          "incomplete CF record → PENDING (getNow answers valueIfAbsent)");
+    ev(ts, hs, "TEST105 getNow");
