+    // 1) inSampleSize law: (dim + s - 1) / s, s clamped to >= 1.
+    const int32_t s = in.in_sample_size < 1 ? 1 : in.in_sample_size;
+    r.sampled_width = (in.raw_width + s - 1) / s;
+    r.sampled_height = (in.raw_height + s - 1) / s;
