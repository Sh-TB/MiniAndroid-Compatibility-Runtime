+            else
+                fail("STK-02", "caught=" + StickyCatch2.caught);
+        } catch (Throwable t) { fail("STK-02", t); }
+
+        // ══ STK-04: re-cached sticky (fresh send after removal) ══
+        StickyCatch3.caught = 0; StickyCatch3.val = "";
+        try {
+            Intent s2 = new Intent("com.probe.c7runtime.STK");
+            s2.putExtra("v", "v2");
