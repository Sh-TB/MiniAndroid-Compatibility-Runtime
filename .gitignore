# Dependencies
node_modules/
skills/

# Build artifacts
miniandroid/build/
miniandroid/build_exp*/

# Object files and binaries
*.o
*.bin
*.exe
*.out
*.so
*.dylib
*.a

# Temporary files
temp_apk_downloads/
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDE and editor files
.idea/
.vscode/
*.xcodeproj/
*.xcworkspace/
*.iml

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Upload directory (transient)
upload/

# Tool results (transient)
tool-results/

# EXP-043 run artifacts (regenerated each run)
miniandroid/run/exp042_auto/
miniandroid/run/exp043_*/

# === EXP-083 run/ forensics cleanup ===

# Runtime dumps (regenerable on every run)
**/view_tree.json
**/stderr.log
**/stdout.log
**/screenshot.ppm

# Build ASAN binary (regenerable from CMake)
miniandroid/build_asan/

# Generated reports (DEX call-graphs, indexes — regenerable from tools)
miniandroid/reports/*.json

# APK extraction trees (extractable from APK on demand)
miniandroid/run/**/AndroidManifest.xml
miniandroid/run/**/classes*.dex
miniandroid/run/**/resources.arsc

# F-Droid index cache (regenerable)
miniandroid/download/exp*/fdroid_index*.json

# Old completed EXP dirs (≤ EXP-080) are compacted into archive/.
# Do not auto-track their regenerated outputs going forward.
miniandroid/run/exp0*/
miniandroid/run/exp03*/
miniandroid/run/exp04*/
miniandroid/run/exp05*/
miniandroid/run/exp06*/
miniandroid/run/exp07*/

# Active experiment directories (EXP-081+) remain trackable for in-progress work.
