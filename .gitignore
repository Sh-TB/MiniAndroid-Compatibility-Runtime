# Dependencies
node_modules/
skills/

# === EXP-084 STRICT SOURCE-ONLY POLICY ===
# Per RULES 0–19, no APKs, build artifacts, or run output may be tracked.

# APK / AAB / archive (RULE 0) — NEVER tracked
*.apk
*.aab
*.apks
*.xapk

# Build output (RULE 3, 4) — regenerate from CMakeLists.txt + Makefile
miniandroid/build/
miniandroid/build_asan/
miniandroid/build_exp*/
build/
build_asan/
build_exp*/

# Run output (RULE 2) — regenerate on every test run
miniandroid/run/
run/

# Download directory (RULE 1) — external inputs only, never tracked
miniandroid/download/

# Reports (RULE 6) — generated, never tracked
miniandroid/reports/

# Experiments — only README.md / REPORT.md tracked (RULE 5)
miniandroid/experiments/*/
!miniandroid/experiments/*/
miniandroid/experiments/**/*
!miniandroid/experiments/**/README.md
!miniandroid/experiments/**/REPORT.md

# Logs and temporary files
*.log
*.stderr
*.stdout
*.tmp
*.dmp
*.core
*.swp
*.swo
*~

# Raw screenshots (RULE 8) — never tracked
*.ppm

# Object files and binaries (RULE 9)
*.o
*.obj
*.bin
*.exe
*.out
*.so
*.dylib
*.dll
*.a

# Specifically forbidden binaries
miniandroid/tools/miniandroid_exp042
miniandroid/tools/miniandroid_exp042.exe

# IDE and editor files
.idea/
.vscode/
*.xcodeproj/
*.xcworkspace
*.iml
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Upload directory (transient)
upload/

# Tool results (transient)
tool-results/

# CMake / build cache
CMakeCache.txt
CMakeFiles/
compile_commands.json
cmake_install.cmake
Makefile.in

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Tool results (transient)
tool-results/

# Environment
.env
.env.local

# Root-level download/ (legacy stub)
download/
