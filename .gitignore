**/heap_trace.json
**/method_trace.json
**/opcode_trace.json
**/register_trace.json
**/view_tree.json
**/lifecycle_trace*.json.bak
*.err
*.bak
*.rej
*.orig
*.tmp
*~

# --- logs and temporary files ------------------------------------------------
*.log
.cache/
tmp/
tmp_*/
.build_*/
.forgejo*/

