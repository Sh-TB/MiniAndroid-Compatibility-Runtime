tools/dl/
tools/ccache-bin/
tools/ccache_dl/
tools/ccache_cache/
tools/ccache.conf
tools/toolchain/
tools/aapt2/
tools/d8/
tools/ecj/
tools/android-34/
tools/android-34.jar
tools/r8/
tools/go/
tools/gopath/
zoektdb
upstream/cont12_maven/
upstream/dodge-src/

# --- workspace-local, machine-only areas ------------------------------------
/upload/
/download/
/skills/
/logs/
/tool-results/
/backup*/
/backup-s51/
external_backup/
/local/
/work/
.secrets/
.env
credentials.json
*.keystore
*.jks
secrets*
worklog.md
androguard.db*
.current_size_*

# --- untracked-by-default evidence doctrine ---------------------------------
# Tracked curated evidence remains tracked (gitignore never untracks).
# New evidence lands here first as LOCAL files; promotion to Git is an
# explicit `git add -f` reviewed against the size budget + validator.
/evidence/
/docs/evidence/
/forensic_data/
/reference/
/third_party/

# S-SLIM: byte-identical twins of tracked pinned-tree files (s44 canonical;
# ledger: evidence/audit/DUPLICATE_AND_UNUSED_LEDGER.csv)
/docs/upstream/MessageSchema.java
/upstream/s43/ui_android_src/androidMain/androidx/compose/ui/platform/AndroidComposeViewAccessibilityDelegateCompat.android.kt
