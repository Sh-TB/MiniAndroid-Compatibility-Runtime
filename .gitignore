# CAMPAIGN 011 (§28) — build/cache/artifact hygiene
# APK policy (§20): ZERO APK/AAB inside the repository, releases, or source ZIPs.
# Test APKs are fetched by scripts/download_test_apks.py into an EXTERNAL cache.

# build outputs
miniandroid/build/
/build/
*.o
*.d

# APK / Android app bundles — never commit
*.apk
*.aab
*.so

# local APK caches (legacy in-repo path + external)
miniandroid/download/
apk_cache/

# external tool build artifacts
**/robolectric-oracle/target/

# large local run artifacts (keep curated evidence under docs/evidence instead)
miniandroid/run/u011/
miniandroid/run/**/*.log
miniandroid/run/**/*.ppm
miniandroid/run/**/*.json

# local logs / temporary artifacts
*.log
*.tmp
.cache/

# secrets / credentials — should never exist here
*.keystore
*.jks
credentials.json
secrets*
.env

# UNIFIED_011.3: run/ evidence dirs are external artifacts; curated evidence lives in docs/evidence/
miniandroid/run/clicktest_*/
miniandroid/run/corpus_*/
miniandroid/run/real_whatsapp/
miniandroid/run/u0113_*/

# =============================================================================
# RELEASE PACKAGING HYGIENE (2026-09-04)
# ---------------------------------------------------------------------------
# Incident: the Windows cross-build tree `miniandroid/build-win/` was never
# ignored (the old rules only covered `miniandroid/build/`), so one `git add`
# committed 13,600+ llvm-mingw toolchain files, the 80 MB compiler archive,
# downloaded dependency source trees (win_src) and object files.
#
# RULE: the repository stays SOURCE + intentional project assets.
# Build trees, toolchains, downloaded dependency sources, staging dirs and
# generated binaries are NEVER committed. Files that are intentionally
# released are attached to GitHub Releases as artifacts.
# `scripts/release/validate_release_content.py` enforces the same rule on every
# release package before it is published.
# =============================================================================

# Windows cross-build tree: llvm-mingw toolchain + win_deps + win_src + objects
miniandroid/build-win/
build-win/
win_src/
win_deps/
llvm-mingw*/
llvm-mingw.tar.xz

# any other cross-build / experiment work trees
/build-*/
work/

# compiler + linker byproducts anywhere
*.obj
*.lib
*.ninja
*.ninja_deps
.ninja_log
CMakeCache.txt
CMakeFiles/
compile_commands.json

# downloaded dependency archives and extracted dependency source trees
# (upstream sources are fetched by build scripts into ignored work dirs)
**/freetype-*/
**/harfbuzz-*/
**/fribidi-*/
**/zlib-*/
**/libpng-*/
**/jpeg-*/
**/libwebp-*/
**/rlottie-*/
**/hb.tgz
**/jpeg.zip

# generated release staging (always created fresh by scripts/release/package_release.sh
# and validated by scripts/release/validate_release_content.py before packaging)
release_staging/
dist/
release_audit/

# raw demo-run output (the curated, hash-pinned proof is committed under docs/demos/)
miniandroid/run/demo_evidence/
miniandroid/run/demo_timer_evidence/

# stray runtime data written by corpus runs at the repository root
/runtime/
.build_*/

# M9 (§41 hygiene): session run/ evidence dirs are external artifacts;
# curated evidence lives in docs/evidence/hello_color_golden/
miniandroid/run/m9_*/

# S19: shared APK/DEX/ARSC artifact cache (content-addressed, regenerable via
# tools/verify/apk_artifacts.py; curated proof artifacts live under docs/ and
# the repo-root artifacts/ committed in 3ea1ffc3)
artifacts/
# S19: session probe run dirs follow the m9_* external-artifact law
miniandroid/run/s19_*/

# repository-structure migration: demo app build output + generated runtime binary
examples/demo-app/build/
miniandroid/core

# container workspace dirs (local-only, never part of the repository)
/skills/
/upload/
/download/
/logs/
/tool-results/
/MiniAndroid-Compatibility-Runtime/

# toolchain binaries (restored by scripts/build/bootstrap_toolchain.sh — never committed)
/tools/aapt2/
/tools/d8/
/tools/ecj/
/tools/android-34.jar
/tools/platform-34-ext*_r0*.zip
androguard.db

# =============================================================================
# S48 EVIDENCE TAXONOMY (2026-09-16) — raw campaign exhaust stays external
# -----------------------------------------------------------------------------
# Raw run dumps and forensic-session traces live in the EXTERNAL archive
# (/home/z/archive/miniandroid) with per-file SHA-256 provenance recorded in
# docs/evidence/ARCHIVE_MANIFEST.json. Compact evidence (report.md,
# execution_summary.json, screenshot.png, golden artifacts) is the source of
# truth and lives under docs/evidence/. Never re-add the classes below.
# =============================================================================
miniandroid/run/**/*_stderr.txt
miniandroid/run/**/*_stdout.txt
gpg_*/
gpg_lambda_probe.out

# S51 purge scratch + local backup (never commit)
/backup-s51/
/tool-results/
local/
miniandroid/run/

# S58 hygiene: repo-root session run/ dirs are external artifacts (same law as
# miniandroid/run/ M9 §41). A root run/ dir was auto-committed with a UUID
# message at bef5f601 (raw pre-fix traces; commit dropped, SHAs archived on
# disk). Curated evidence belongs in docs/evidence/<session>/ + SHA256SUMS.
/run/

# S61: local Go toolchain + zoekt/codesearch build (SEARCH_LEDGER documents them; binaries are reproducible via the ledger recipe)
/tools/go/
/tools/gopath/
zoektdb

# S69 source pins: tarballs are re-fetchable via PROVENANCE.json (codeload URL
# + SHA256); the two heavy extracted trees (tripeaks 12M, bouncy 8.8M) stay
# external — their key law files are curated under docs/upstream/apps/.
upstream/corpus/**/*.tar.gz
upstream/corpus/com.dozingcatsoftware.bouncy/src/
upstream/corpus/eu.veldsoft.tri.peaks/src/

.secrets/
miniandroid/build-asan/
upstream/dodge-src/
