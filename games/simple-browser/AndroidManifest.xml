<?xml version="1.0" encoding="utf-8"?>
<!-- S133 VC2: Mini Browser (com.miniandroid.browser) — full-page
     render through android.webkit.WebView (the runtime's HTML5 engine).
     VC1 (versionCode 1, frozen in evidence/s100_browser) was the
     text-reader architecture point. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.miniandroid.browser"
    android:versionCode="2"
    android:versionName="2.0">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="26" />
    <application android:label="Mini Browser">
        <activity android:name=".BrowserActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
