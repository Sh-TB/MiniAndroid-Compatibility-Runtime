<?xml version="1.0" encoding="utf-8"?>
<!-- F-NEW-320 probe layout: a plain FrameLayout hosting the Flinger view
     (a DEX-defined View overriding computeScroll — the R-NEW-430 per-frame
     dispatch family runs it every frame once overrides are detected). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.probe.f320.Flinger
        android:id="@+id/flinger"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</FrameLayout>
