<?xml version="1.0" encoding="utf-8"?>
<!--
  HELLOWORLD-GOLDEN fixture layout — compiled by aapt2 to BINARY AXML
  inside the APK and inflated by MiniAndroid's AXML parser + ARSC
  resource resolver. Attribute values mirror the previous programmatic
  tree exactly (same strings/sizes/colors) so the pixel-law checks of
  the golden validation remain valid.

  Chain exercised by THIS file alone:
    resources.arsc (@string lookup) → binary AXML attribute decoding →
    LayoutInflater → View tree → measure → layout → draw → pixels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/hello_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello_headline"
        android:textSize="28sp"
        android:textColor="#141414" />

    <TextView
        android:id="@+id/hello_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello_subtitle"
        android:textSize="14sp"
        android:textColor="#606060" />

    <Button
        android:id="@+id/ok_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok_label" />
</LinearLayout>
