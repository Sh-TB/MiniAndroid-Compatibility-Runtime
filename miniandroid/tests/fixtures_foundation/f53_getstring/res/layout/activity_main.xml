    <TextView android:id="@+id/tv_ctx"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="34sp" android:textColor="@color/txt"/>
    <TextView android:id="@+id/tv_fmt"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="34sp" android:textColor="@color/txt"/>
    <TextView android:id="@+id/tv_res"
