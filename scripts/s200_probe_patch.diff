+void pgl_dbg_arm() {
+    // S200 Target-B: arm the per-draw vertex dump (called by the bridge
+    // immediately before each draw call).
+    static const bool dbg = std::getenv("MINIANDROID_GL_DEBUG");
+    if (!dbg) return;
+    // flip the static armed flag inside the shader via a file-scope latch
+    g_dbg_armed = true;
