+void pgl_raster_state_dump(const char* tag) {
+    // S200 Target-B: raster-stage state at draw time — blend/scissor/depth/
+    // viewport/cull (the stage between the fragment shader and the pixel).
+    static const bool dbg = std::getenv("MINIANDROID_GL_DEBUG");
+    static int shown = 0;
+    if (!dbg || shown >= 6) return;
+    ++shown;
+    std::fprintf(stderr,
+        "[GLDBG] raster@%s vp=%d,%d %ux%u guard=%d,%d..%d,%d "
+        "blend=%d sRGB=0x%X dRGB=0x%X sA=0x%X dA=0x%X "
+        "depth=%d func=0x%X mask=%d cull=%d mode=0x%X scissor=%d\n",
+        tag, (int)c->xmin, (int)c->ymin, (unsigned)c->width,
+        (unsigned)c->height, (int)c->lx, (int)c->ly, (int)c->ux, (int)c->uy,
+        (int)c->blend[0], (unsigned)c->blend_sRGB[0],
+        (unsigned)c->blend_dRGB[0], (unsigned)c->blend_sA[0],
+        (unsigned)c->blend_dA[0], (int)c->depth_test,
+        (unsigned)c->depth_func, (int)c->depth_mask, (int)c->cull_face,
+        (unsigned)c->cull_mode, (int)c->scissor_test);
