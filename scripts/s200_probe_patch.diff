+unsigned pgl_bound_texture_2d() {
+    return c ? c->bound_textures[GL_TEXTURE_2D - GL_TEXTURE_UNBOUND - 1] : 0;
+}
+
+void pgl_texture_audit(const char* tag, GLuint name) {
+    // S200 Target-B: texture-object audit — does the PGL object for this
+    // name hold image data, and of what dimensions?
+    static const bool dbg = std::getenv("MINIANDROID_GL_DEBUG");
+    static int shown = 0;
+    if (!dbg || shown >= 24) return;
+    ++shown;
+    glTexture* t = pgl_tex_2d(name);
+    if (!t) {
+        std::fprintf(stderr, "[GLDBG] texaudit@%s name=%u OBJECT_MISSING\n",
+                     tag, (unsigned)name);
+        return;
+    }
+    std::fprintf(stderr,
+        "[GLDBG] texaudit@%s name=%u w=%d h=%d levels=%d data=%p "
+        "b0=%02x b1=%02x b2=%02x b3=%02x\n",
+        tag, (unsigned)name, (int)t->w, (int)t->h, (int)t->num_levels,
+        (void*)t->data,
+        t->data ? ((const unsigned char*)t->data)[0] : 0,
+        t->data ? ((const unsigned char*)t->data)[1] : 0,
+        t->data ? ((const unsigned char*)t->data)[2] : 0,
+        t->data ? ((const unsigned char*)t->data)[3] : 0);
+}
+
+void pgl_vap_state_dump(unsigned idx) {
+    // S200 Target-B probe: PGL's POST-CALL vertex-attrib state for one
+    // index — did PGL accept the type/enabled/stride, or reject silently?
+    static const bool dbg = std::getenv("MINIANDROID_GL_DEBUG");
+    if (!dbg || idx >= 8) return;
+    auto& va = c->vertex_arrays.a[c->cur_vertex_array].vertex_attribs[idx];
+    std::fprintf(stderr,
+        "[GLDBG] vapPOST idx=%u en=%d sz=%d type=0x%X norm=%d stride=%d "
+        "off=%p vbo=%u\n",
+        idx, (int)va.enabled, (int)va.size, (unsigned)va.type,
+        (int)va.normalized, (int)va.stride, (void*)(uintptr_t)va.offset,
+        (unsigned)c->bound_buffers[GL_ARRAY_BUFFER]);
+}
+
